# Copy this file to .env.local (never commit a file with real values).
#
# LEAVING THESE EMPTY IS A VALID, SUPPORTED SETUP.
# With no Supabase variables, Baseline builds exactly as it always has: every
# byte of your training and health data stays in your browser, the app makes
# no network requests at all, and there is no account. Sync is the optional
# extra, not the foundation.
#
# Supabase Dashboard -> your Baseline project -> Project Settings -> API Keys
# (and Data API for the URL).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The PUBLISHABLE key (sb_publishable_...) or the legacy "anon" key.
# NEVER the secret / service_role key: it bypasses Row Level Security, so a
# browser holding one can read and write every user's rows. The build fails
# on purpose if it detects a secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
