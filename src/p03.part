const TESTS=[
 {id:'t_cmj',name:'Countermovement Jump',unit:'cm',dir:'up',cat:'Power',how:'Mark your standing reach on a wall, then chalk your fingers and jump as high as possible. Best of 3. Measure the difference.'},
 {id:'t_broad',name:'Broad Jump',unit:'cm',dir:'up',cat:'Power',how:'Two-footed jump for distance from a standing start. Measure from the toe line to the rear heel. Best of 3.'},
