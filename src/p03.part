 {id:'t_pushup',name:'Push-Ups (max)',unit:'reps',dir:'up',cat:'Upper',how:'Maximum strict push-ups with full range in one set.'},
 {id:'t_plank',name:'RKC Plank Hold',unit:'s',dir:'up',cat:'Core',how:'Maximum hold with full-body tension. Stop when the hips drop.'},
