
/* =========================================================================
   WARM-UP LIBRARY
   ====================================================================== */
/* =========================================================================
   HOW TO DO EACH WARM-UP MOVEMENT
   One line each, written for someone who has not seen the movement before.
   Keyed by the exact name used in WARMUPS / PREP_BLOCKS / FOCUS_BLOCKS.
   ====================================================================== */
const WARMUP_HOW={
  'Easy bike or brisk walk':'Any easy movement that raises your temperature. You should be able to hold a conversation throughout.',
  'Easy jog or bike':'Gentle and continuous. The aim is warm, not tired.',
  'Easy jog or walk':'Conversational pace. Stop well before it feels like training.',
  'Easy jog, spin or brisk walk':'Whatever is to hand. Easy enough to breathe through your nose.',
  'Easy walk or spin':'Very light. This is temperature, not fitness.',
  'Easy jog around the court':'Two or three easy laps, gradually adding some sideways and backwards steps.',
  'Leg swings front/back':'Hold something for balance. Swing one leg forwards and back, relaxed, letting the range grow with each swing.',
  'Leg swings lateral':'Hold support and swing one leg across your body and out to the side. Keep your hips facing forwards.',
  'Leg swings all directions':'Front to back, then side to side, on each leg. Relaxed swings, not forced stretches.',
  'Leg swings + hip circles':'Swing each leg front to back, then draw slow circles with the knee in both directions.',
  'Hip circles + leg swings':'Big slow circles with the knee, then relaxed swings front to back.',
  'Arm circles':'Big slow circles forwards, then backwards. Let the shoulder move through its full range.',
  'Arm circles + leg swings':'Arm circles both ways, then relaxed leg swings. Whole body, low effort.',
  'Ankle dorsiflexion rock':'In a half-kneeling or split stance, drive the front knee forwards over the toes and back. Keep the heel down.',
  'Bodyweight squats':'Feet shoulder width. Sit down between your hips, going a little deeper each rep.',
  'Glute bridge':'Lie on your back, feet flat. Push through the heels to lift the hips, squeeze at the top, lower slowly.',
  'Walking lunge':'Long step forwards, back knee towards the floor, drive up and through onto the other leg.',
  'Split squat':'One foot forward, one back. Drop straight down, not forwards. Control the lowering.',
  'Pogo hops':'Small, fast, springy hops on the spot. Stay on the balls of your feet and keep the knees fairly straight.',
  'Calf raises':'Rise onto your toes, pause at the top, lower slowly. Hold something if you need balance.',
  'Calf stretch (straight + bent knee)':'Push one heel into the floor with the leg straight, then again with the knee bent. Both hit different parts of the calf.',
  'Adductor rock':'On hands and knees, take one leg out to the side, foot flat. Rock your hips back and forth.',
  '90/90 hip switch':'Sit with both knees bent at right angles, one leg in front and one to the side. Rotate the knees over to swap sides without using your hands.',
  'Couch stretch':'Back foot up against a wall or sofa, kneeling on the other. Tuck your pelvis under until you feel the front of the hip.',
  'Pigeon stretch':'Front shin across in front of you, back leg straight behind. Fold forwards gently over the front leg.',
  'Cat-cow':'On hands and knees, round your back and drop your head, then arch and lift your chest. Slow, with the breath.',
  'Bird dog':'On hands and knees, reach one arm and the opposite leg out straight. Keep your hips level and do not let your back sag.',
  'Dead bug':'On your back, arms up and knees bent at ninety degrees. Lower one arm and the opposite leg, keeping your lower back flat to the floor.',
  'Band pull-apart':'Hold a band at chest height, arms straight. Pull it apart until it touches your chest, squeezing the shoulder blades.',
  'Band face pull':'Band at head height. Pull towards your face, elbows high and wide, ending with your hands beside your ears.',
  'Band shoulder dislocates':'Wide grip on a band overhead. Take it slowly back behind your head and return. Widen your grip if it is tight.',
  'Shoulder CARs':'Lift one arm and trace the largest slow circle you can without moving your torso. Quality over size.',
  'Scapular push-ups':'In a push-up position with straight arms, let your chest sink between the shoulder blades, then push the upper back to the ceiling.',
  'Incline push-ups':'Hands on a bench or wall. Lower your chest under control, push away. The higher the hands, the easier it is.',
  'Wall slides':'Back and arms against a wall. Slide the arms up overhead keeping the wrists and elbows in contact for as long as you can.',
  'Doorway chest stretch':'Forearm on a door frame, elbow at shoulder height. Step through gently until you feel the chest open.',
  'Thoracic rotation (open book)':'On your side, knees bent, arms out in front. Open the top arm across your body and follow it with your eyes.',
  'High knees':'Jog on the spot bringing the knees to hip height. Quick feet, tall posture.',
  'Butt kicks':'Jog on the spot flicking the heels up towards your backside. Stay light and quick.',
  'A-skips':'Skip forwards driving one knee up to hip height with the toe pulled up. Land under your hips, not in front.',
  'Build-up runs':'Run about twenty metres, starting easy and finishing near your top speed. Walk back.',
  'Build-up sprints':'Short accelerations, each a little faster than the last. Stop well short of a maximal effort on the first few.',
  'Lateral shuffle':'Stay low, push off the trailing leg and keep your feet from clicking together. Both directions.',
  'Lateral shuffle + crossover':'Shuffle sideways, then cross the trailing leg over the front for a few steps. Both directions.',
  'Countermovement jumps':'Dip quickly then jump, using your arms. Land softly through the whole foot. Not maximal in a warm-up.',
  'Drop and stick':'Step off a low box or step, land on both feet and freeze absolutely still for two seconds.',
  'Single-leg RDL (bodyweight)':'Stand on one leg, hinge at the hip and reach forwards as the free leg goes back. Keep the hips square and the back flat.',
  'Split step + first step':'Small hop landing on both feet, then explode one step in whichever direction you choose.',
  'Serve shadow swings':'Full service motion with no ball, building from slow to near full speed over the set.',
  'Shadow swings / rotational throws':'Rehearse your sport swing with no ball, or throw a light ball sideways into a wall, rotating through the hips.',
  'Slow nasal breathing':'In through the nose for four seconds, out for six, into your belly rather than your chest.',
  'Legs up the wall':'Lie on your back with your legs resting up a wall. Breathe slowly and let everything settle.',
  'Gentle full-body stretch':'Move slowly through whatever feels tight. Hold nothing painfully, and keep breathing.',
  "World's greatest stretch":'From a deep lunge, put the inside hand on the floor and rotate the other arm up to the ceiling. Follow your hand with your eyes, then swap sides.'
};
const warmupHow = n => WARMUP_HOW[n] || '';

const WARMUPS = {
  lower:{name:'Lower-Body RAMP',dur:8,items:[
    {n:'Easy bike or brisk walk',d:'3 min — raise temperature'},
    {n:'Leg swings front/back',d:'12 each leg'},
    {n:'Leg swings lateral',d:'12 each leg'},
    {n:'Ankle dorsiflexion rock',d:'10 each side'},
    {n:'Bodyweight squats',d:'15, progressively deeper'},
