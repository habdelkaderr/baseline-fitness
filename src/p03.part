/* =========================================================================
   8-WEEK PROGRESSION PLAN
   ====================================================================== */
const PHASES=[
 {w:1,name:'Re-Entry',vol:0.8,rpeCap:7,plyo:'low',
  goal:'Rebuild the habit and the tissue tolerance. Deliberately easier than you can handle.',
  focus:'Technique on every lift. Establish honest RPE. Do not chase soreness.'},
 {w:2,name:'Build',vol:1.0,rpeCap:8,plyo:'moderate',
  goal:'Full prescribed volume. Add reps within the given range.',
  focus:'Hit the top of each rep range before considering anything harder.'},
 {w:3,name:'Build +',vol:1.1,rpeCap:8,plyo:'moderate',
  goal:'Add one set to the first two exercises of each strength session.',
  focus:'Highest volume week of block 1. Expect real fatigue by Friday.'},
 {w:4,name:'Deload',vol:0.6,rpeCap:6,plyo:'minimal',
  goal:'Cut volume by 40%, cap effort at RPE 6, keep the movements.',
  focus:'This is where adaptation actually happens. Do not skip it.'},
 {w:5,name:'Intensify',vol:1.0,rpeCap:8,plyo:'moderate',
  goal:'Move to harder exercise VARIATIONS rather than more reps.',
  focus:'Bulgarian → paused. Push-up → feet elevated. Skater squat range increases.'},
 {w:6,name:'Intensify +',vol:1.05,rpeCap:9,plyo:'high',
  goal:'Hardest variations you can perform with clean technique.',
  focus:'Plyometric quality is the limiter — stop sets when output falls.'},
 {w:7,name:'Peak',vol:1.1,rpeCap:9,plyo:'high',
  goal:'Peak week. Highest quality output of the block.',
  focus:'Test-quality jumps and sprints. Strength sets close to failure.'},
 {w:8,name:'Deload + Retest',vol:0.55,rpeCap:6,plyo:'test only',
  goal:'Deload, then retest your benchmarks on a GREEN day.',
  focus:'Retest: CMJ height, broad jump, 5-10-5 time, push-ups, plank, single-leg calf raises.'}
];

