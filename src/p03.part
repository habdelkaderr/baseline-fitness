/* =========================================================================
   DEFAULT DATABASE
   ====================================================================== */
function freshDB(){
  return {
    version:1, created:new Date().toISOString(),
    profile:{
      /* A fresh profile knows nothing about you. Every field below is either
         empty or null, and the UI renders that as "None" rather than as an
         incomplete profile. The engine's own fallbacks live in the working
         accessors (sportsOf, trainDays, sessMin) in p03b — not here. */
      name:'',
      goalPrimary:'', goalSecondary:'',
      equipment:[],
      units:'metric',
      sessionMin:null, startDate:todayISO(), planWeek:1, planStart:todayISO(),
      /* Which wearable, if any. null = first run, ask. See SOURCES: a device
         is described by the fields it provides, and no device is privileged.
         `mode` is kept in sync only so older saved data keeps working. */
      source:null, sourceFields:null, mode:null, onboarded:false,
      /* about you — all optional, used only for context and never required */
      age:null, sex:null, heightCm:null, weightKg:null,
      /* equipment tier: 0 minimal · 1 home · 2 full gym */
      tier:0, preferBest:true, gear:[], dbKg:null, equipNote:'',
      /* where you train decides which way round the equipment question is
         asked; null until you have been asked */
      place:null, gearKg:{},
      /* goals — arrays, with the first entry leading */
      /* standing injuries: [{id, area, side, severity, until, note}] — these
         persist and expire, unlike the one-day pain flag in the check-in */
      limits:[],
      /* no sport, no goal, no schedule until the user says so */
      sports:[], sport:null,
      physiques:[], physique:null,
      daysPerWeek:null,
      /* deliberate breaks, so a gap in the log reads as "away" rather than
         as a fortnight of missed training */
      awayUntil:null, awayReason:'',
      /* exercises that hurt, with an expiry. Lighter than an injury, which
         is a body area and a date; this is "not this movement, for now". */
      avoid:[]
    },
    meta:{ created:new Date().toISOString(), schema:SCHEMA_VERSION, lastBackup:null, lastBackupCount:null },
    /* Weekly GUIDELINES, not quotas. The daily engine decides the order and
       will happily miss a target rather than train you into the ground. */
    /* No targets until setup derives them from what the user actually chose.
       An empty object is the honest state: targetKeys() hides every zero, so
       the week view says "no targets yet" instead of inventing ten sessions
       a week for somebody who has not told us anything. */
    targets:{},
    settings:{
      bands:{green:72,yellow:56,orange:42},
      autoAdjust:true, hardStrain:14, restTimerOn:true,
      /* sound is on because it belongs to a timer the user started; alerts
         are off because they need a permission nobody has granted yet */
      sound:true, notify:false
    },
    /* Optional cycle tracking. Off, with nothing in it, until the user says
       otherwise. `starts` holds period start dates only; the daily entries
       live on the check-in they belong to. */
    mcycle:{on:false, starts:[], typicalLen:null, typicalPeriod:null, askedAt:null},
    plans:{},
    /* what the engine advised each day, written on the day. Kept separate
       from plans (which is your override) so adherence can be measured. */
    decisions:{},
    baselines:Object.assign({},SEED_BASE,{computed:false,seeded:true}),
    whoop:{cycles:[],workouts:[],journal:[],imports:[]},
    checkins:{},
    exercises:builtInExercises(),
    workouts:seedWorkouts(),
    sessions:[],
    activities:[],
    tests:[],
    physique:[],
    ui:{tab:'today', tourDone:false, digestSeen:null}
  };
}
