    {n:'Bird dog',d:'8 each side'},
    {n:'Glute bridge',d:'15'}
  ]},
  easy:{name:'Light Movement Prep',dur:5,items:[
    {n:'Easy walk or spin',d:'3 min'},
    {n:'Cat-cow',d:'10'},
    {n:'Arm circles + leg swings',d:'10 each'},
    {n:'Bodyweight squats',d:'10 easy'}
  ]}
};
const COOLDOWNS = {
  lower:{name:'Lower Cool-Down',dur:7,items:[
    {n:'Easy walk or spin',d:'3 min — flush the legs'},
    {n:'Couch stretch',d:'45s each side'},
    {n:'Pigeon stretch',d:'45s each side'},
    {n:'Calf stretch (straight + bent knee)',d:'40s each'},
    {n:'Slow nasal breathing',d:'2 min, 4s in / 6s out'}
  ]},
  upper:{name:'Upper Cool-Down',dur:5,items:[
    {n:'Band shoulder dislocates',d:'10 slow'},
    {n:'Doorway chest stretch',d:'40s each side'},
    {n:'Thoracic rotation (open book)',d:'8 each side'},
    {n:'Slow nasal breathing',d:'2 min'}
  ]},
  power:{name:'Power Cool-Down',dur:8,items:[
    {n:'Easy jog or walk',d:'5 min — clear the legs'},
    {n:'Ankle dorsiflexion rock',d:'10 each'},
    {n:'Couch stretch',d:'45s each side'},
    {n:'Adductor rock',d:'10'},
    {n:'Slow nasal breathing',d:'2 min'}
  ]},
  easy:{name:'Down-Regulation',dur:6,items:[
    {n:'Slow nasal breathing',d:'3 min, 4s in / 6s out — drives parasympathetic tone'},
    {n:'Legs up the wall',d:'2 min'},
    {n:'Gentle full-body stretch',d:'as needed'}
  ]}
};

