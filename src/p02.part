{id:'pl01',name:'Pogo Hops',cat:'plyo',muscles:'Calves, Achilles, ankle stiffness',equip:'BW',sets:3,reps:'20–30',rpe:'RPE 6',rest:'60s',tempo:'Fast',
 how:'Small, fast, springy hops on the balls of the feet with almost straight knees. Minimum ground contact time.',
 cue:'Bounce off the ground like it is hot. The ankles do the work, not the knees.',
 prog:'Contacts → height → single leg → lateral pogos.',
 reg:'Fewer reps, lower height.',
 subs:'Ankle Stiffness Hops',
 notes:'Always the FIRST plyometric in any session — it primes the tendons.'},

{id:'pl02',name:'Countermovement Jump',cat:'plyo',muscles:'Quads, glutes, calves — full-body power',equip:'BW',sets:4,reps:'3–5',rpe:'RPE 7 (max effort, low volume)',rest:'75–90s',tempo:'Explosive',
 how:'Quick dip to a quarter squat and jump as high as possible. Land softly, reset fully between reps.',
 cue:'QUALITY over quantity. If the jump height visibly drops, the set is finished.',
 prog:'Track your best height. Progress by jumping higher, not more.',
 reg:'Sub-maximal jumps, or Squat Jump from a pause.',
 subs:'Squat Jump · Broad Jump',
 notes:'This is your serve-jump driver. Never chase fatigue on this exercise.'},

{id:'pl03',name:'Squat Jump (paused)',cat:'plyo',muscles:'Quads, glutes — concentric power',equip:'BW',sets:3,reps:'4–6',rpe:'RPE 7',rest:'75s',tempo:'Pause then explode',
 how:'Descend to a quarter squat, hold for 2 full seconds to remove the stretch reflex, then jump maximally.',
 cue:'Kill all the bounce in the pause, then explode from a dead stop.',
 prog:'Height → longer pause → single-leg variation.',
 reg:'Fewer reps.',
 subs:'Countermovement Jump'},

{id:'pl04',name:'Lateral Bound (Skater)',cat:'plyo',muscles:'Glute medius, quads, lateral power',equip:'BW',sets:3,reps:'5–8 / side',rpe:'RPE 7',rest:'75s',tempo:'Explosive',
 how:'Push off one leg laterally, land on the opposite leg, and STICK the landing for a full second before bounding back.',
 cue:'Land quietly on a stable, slightly bent knee that does not cave inward.',
 prog:'Distance → stick quality → continuous bounds without pausing.',
 reg:'Shorter distance, longer pause between reps.',
 subs:'Lateral Lunge · Skater Squat',
 notes:'The closest direct match to wide-ball recovery and open-stance push-off.'},

{id:'pl05',name:'Broad Jump',cat:'plyo',muscles:'Glutes, hamstrings — horizontal power',equip:'BW',sets:3,reps:'3–5',rpe:'RPE 7',rest:'90s',tempo:'Explosive',
 how:'Two-footed jump for maximum distance. Land in an athletic absorbed position and hold it.',
 cue:'Drive the arms hard. Land soft — absorb through the hips.',
 prog:'Distance. Mark your best and test it monthly.',
 reg:'Sub-maximal distance with focus on landing.',
 subs:'Countermovement Jump',
 notes:'Horizontal power transfers to first-step acceleration better than vertical jumping does.'},

{id:'pl06',name:'Depth Drop & Stick',cat:'plyo',muscles:'Landing mechanics, eccentric strength',equip:'CHAIR',sets:3,reps:'4–6',rpe:'RPE 6',rest:'60s',tempo:'Absorb',
 how:'Step (do not jump) off a low surface ~30 cm. Land on both feet in an athletic position and freeze completely for 2 seconds.',
 cue:'Silent landing. Knees track over the toes, hips back, chest up.',
 prog:'Height (slowly) → single-leg landing → drop into an immediate jump.',
 reg:'Lower height, or jump in place and stick.',
 subs:'Jump & Stick',
 notes:'Deceleration training. This is what protects your knees during hard direction changes.'},

{id:'pl07',name:'Split Jump',cat:'plyo',muscles:'Quads, glutes — alternating power',equip:'BW',sets:3,reps:'6–10 total',rpe:'RPE 7',rest:'75s',tempo:'Explosive',
 how:'From a lunge position, jump and switch legs in the air, landing softly in the opposite lunge.',
 cue:'Soft landings, upright torso. Do not let the back knee slam.',
 prog:'Reps → height → continuous rhythm.',
 reg:'Step through instead of jumping.',
 subs:'Reverse Lunge · Lateral Bound'},

{id:'pl08',name:'Single-Leg Hop & Stick',cat:'plyo',muscles:'Single-leg power & stability',equip:'BW',sets:3,reps:'4–6 / leg',rpe:'RPE 7',rest:'60s',tempo:'Explosive',
 how:'Hop forward on one leg and stick the landing on the same leg for 2 seconds before the next rep.',
 cue:'The knee must not collapse inwards on landing. Stick it, then reset.',
 prog:'Distance → multi-directional hops → continuous.',
 reg:'Smaller hop, or hop and land on two feet.',
 subs:'Lateral Bound'},

{id:'pl09',name:'Serve-Jump Simulation',cat:'plyo',muscles:'Leg drive, hip extension, trunk',equip:'BW',sets:4,reps:'4–6',rpe:'RPE 7',rest:'75s',tempo:'Explosive',
 how:'Adopt your serve stance. Load into the trophy position, then drive up and forward off both legs into the court, landing on the front foot.',
 cue:'Drive UP and INTO the court, not just up. The legs lead, the arm follows.',
 prog:'Height → add the arm swing → add a light band around the hips for resistance.',
 reg:'Half-effort, focus on the movement pattern.',
 subs:'Countermovement Jump',
 notes:'Pattern-specific power. Keep the volume low — 20 quality reps beats 60 tired ones.'},

{id:'pl10',name:'Ankle Stiffness Hops',cat:'plyo',muscles:'Achilles, calves',equip:'BW',sets:3,reps:'15–20 / leg',rpe:'RPE 6',rest:'45s',tempo:'Fast',
 how:'Single-leg pogo hops in place, minimal knee bend, fast ground contacts.',
 cue:'Stay tall. Bounce, do not squat.',
 prog:'Contacts → height → hopping forward and laterally.',
 reg:'Double leg.',
 subs:'Pogo Hops'},

/* ---------------- SPEED / AGILITY / TENNIS MOVEMENT ---------------- */
{id:'sp01',name:'Split-Step Reaction Drill',cat:'speed',muscles:'Reactive ankles, first step',equip:'RUN',sets:4,reps:'6 reactions',rpe:'RPE 7',rest:'60s',tempo:'Reactive',
 how:'Small split-step hop, land on the balls of the feet, and immediately explode 3–4 m in a random direction you choose mid-air.',
 cue:'Land and go in the same beat. No pause between landing and the first step.',
 prog:'React faster → longer sprints out → add a partner or a random call.',
 reg:'Pre-plan the direction.',
 subs:'Lateral Shuffle'},

{id:'sp02',name:'Acceleration Sprints (10–20 m)',cat:'speed',muscles:'Full body — acceleration',equip:'RUN',sets:6,reps:'1 × 15 m',rpe:'RPE 8 (95% effort)',rest:'60–90s full recovery',tempo:'Max',
 how:'From a split-step or staggered stance, accelerate maximally for 10–20 m. Walk back fully before the next rep.',
 cue:'Aggressive forward body lean for the first 5 steps. Drive the ground backwards.',
 prog:'Add reps (max 8) → add a reactive start → vary the start position.',
 reg:'Reduce to 85% effort or fewer reps.',
 subs:'Hill Sprints · Lateral Shuffle',
 notes:'Needs FULL recovery between reps. This is quality work, not conditioning.'},

{id:'sp03',name:'5-10-5 Pro Agility',cat:'speed',muscles:'COD, deceleration, lateral power',equip:'RUN',sets:4,reps:'1 rep each side',rpe:'RPE 8',rest:'90s',tempo:'Max',
 how:'Three markers 5 m apart. Start at the middle, sprint 5 m right, touch, 10 m left, touch, 5 m back through the middle.',
 cue:'Get LOW into the turns. Plant the outside foot hard and change direction off it.',
 prog:'Time it with your phone and chase your own best.',
 reg:'Reduce to 75% effort, focus on the mechanics of the turn.',
 subs:'Lateral Shuffle · Spider Drill'},

{id:'sp04',name:'Lateral Shuffle',cat:'speed',muscles:'Adductors, glute medius, lateral movement',equip:'RUN',sets:4,reps:'6 × 8 m',rpe:'RPE 7',rest:'45s',tempo:'Quick',
 how:'Athletic stance, shuffle sideways without the feet crossing, then push back the other way.',
 cue:'Stay low the whole time — no bobbing up and down. Push off the trailing leg.',
 prog:'Speed → distance → add a band around the thighs.',
 reg:'Slower, shorter distance.',
 subs:'5-10-5 Pro Agility'},

{id:'sp05',name:'Spider / Star Drill',cat:'speed',muscles:'COD, tennis court coverage',equip:'RUN',sets:3,reps:'1 full circuit',rpe:'RPE 8',rest:'2 min',tempo:'Max',
 how:'Five markers arranged like a tennis court coverage pattern. Sprint from the centre to each marker, touch, and recover to the centre each time.',
 cue:'Always recover facing forward with a split step at the centre.',
 prog:'Time the circuit → add more markers → add a racquet.',
 reg:'Jog the recovery, sprint only the outward legs.',
 subs:'5-10-5 Pro Agility'},

{id:'sp06',name:'Deceleration Drill',cat:'speed',muscles:'Eccentric quads, braking',equip:'RUN',sets:4,reps:'4 reps',rpe:'RPE 7',rest:'60s',tempo:'Accel–brake',
 how:'Accelerate hard for 10 m, then stop as fast as possible within 3 m and hold an athletic position.',
 cue:'Drop the hips, shorten the steps, chest over the knees. Do not stop with straight legs.',
 prog:'Faster approach → shorter braking zone → brake into a direction change.',
 reg:'Slower approach speed.',
 subs:'Depth Drop & Stick',
 notes:'Braking force in tennis exceeds accelerating force. Most players never train it.'},

{id:'sp07',name:'Crossover Step Start',cat:'speed',muscles:'Hips, first step',equip:'RUN',sets:3,reps:'5 / side',rpe:'RPE 7',rest:'60s',tempo:'Explosive',
 how:'From a ready position, open the hip and cross the far leg over to sprint 5 m laterally — the movement used to chase a wide ball.',
 cue:'Open the hip first, do not step backwards before going.',
 prog:'Speed → longer distance → reactive start.',
 reg:'Walk through the pattern slowly.',
 subs:'Lateral Shuffle'},

/* ---------------- CORE ---------------- */
{id:'co01',name:'RKC Plank',cat:'core',muscles:'Anti-extension, deep core',equip:'BW',sets:3,reps:'15–30s',rpe:'RPE 9',rest:'60s',tempo:'Isometric',
 how:'Forearm plank, but actively squeeze glutes, quads and fists as hard as possible while pulling the elbows towards the toes.',
 cue:'Maximum full-body tension. If you can hold this over 30 seconds you are not squeezing hard enough.',
 prog:'Increase the intensity of the contraction, not the duration. Then progress to long-lever.',
 reg:'Standard plank, knees down.',
 subs:'Long-Lever Plank · Hollow Body Hold',
 notes:'Far better than 3-minute planks. Quality of tension beats duration.'},

{id:'co02',name:'Long-Lever Plank',cat:'core',muscles:'Anti-extension',equip:'BW',sets:3,reps:'20–45s',rpe:'RPE 8',rest:'60s',tempo:'Isometric',
 how:'Plank with the elbows shifted well forward of the shoulders, increasing the lever arm.',
 cue:'Ribs down, pelvis tucked. Do not let the lower back sag.',
 prog:'Move the elbows further forward → add a DB on the back → lift one foot.',
 reg:'Standard plank.',
 subs:'RKC Plank'},

{id:'co03',name:'Side Plank',cat:'core',muscles:'Anti-lateral flexion, obliques, QL',equip:'BW',sets:3,reps:'25–50s / side',rpe:'RPE 8',rest:'45s',tempo:'Isometric',
 how:'Forearm side plank, body in one straight line, hips stacked and lifted.',
 cue:'Push the floor away with the bottom shoulder. Do not let the hips drop.',
 prog:'Time → top leg lifted → add hip dips → hold a DB.',
 reg:'Bottom knee down.',
 subs:'Copenhagen Plank · Suitcase Carry'},

{id:'co04',name:'Side Plank Hip Dip',cat:'core',muscles:'Obliques, QL',equip:'BW',sets:3,reps:'10–15 / side',rpe:'RPE 8',rest:'45s',tempo:'2-0-1-1',
 how:'From a side plank, lower the hip towards the floor under control and drive it back up past neutral.',
 cue:'Controlled range. Squeeze at the top.',
 prog:'Reps → hold a DB → long lever.',
 reg:'Static side plank.',
 subs:'Side Plank'},

{id:'co05',name:'Dead Bug',cat:'core',muscles:'Anti-extension, core–hip coordination',equip:'BW',sets:3,reps:'8–12 / side',rpe:'RPE 7',rest:'45s',tempo:'3-1-3-0',
 how:'On your back, arms up, knees at 90°. Lower the opposite arm and leg slowly towards the floor while keeping the lower back flat, then return.',
 cue:'The lower back must stay pressed down the entire time. The moment it lifts, shorten the range.',
 prog:'Slower tempo → straighter leg → hold DBs → add a band for anti-extension.',
 reg:'Legs only, or arms only.',
 subs:'Bird Dog · Hollow Body Hold'},

{id:'co06',name:'Bird Dog',cat:'core',muscles:'Anti-rotation, spinal stability, glutes',equip:'BW',sets:3,reps:'8–12 / side',rpe:'RPE 6',rest:'45s',tempo:'2-2-2-0',
 how:'On hands and knees, extend the opposite arm and leg fully, hold 2 seconds, return with control.',
 cue:'Hips stay level — imagine balancing a glass of water on your lower back.',
 prog:'Hold time → add a band → bring the elbow to the knee between reps.',
 reg:'Arm only or leg only.',
 subs:'Dead Bug'},

{id:'co07',name:'Hollow Body Hold',cat:'core',muscles:'Anterior chain, anti-extension',equip:'BW',sets:3,reps:'20–40s',rpe:'RPE 8',rest:'60s',tempo:'Isometric',
 how:'On your back, press the lower back into the floor, lift the shoulders and legs, arms overhead. Hold the banana shape.',
 cue:'Lower back stays glued down. Raise the legs higher if it lifts.',
 prog:'Time → arms overhead → hollow rocks → hold a DB.',
 reg:'Tuck the knees, hands by the sides.',
 subs:'Dead Bug · Long-Lever Plank'},

{id:'co08',name:'Bear Hold / Bear Crawl',cat:'core',muscles:'Total-body core stability',equip:'BW',sets:3,reps:'20–40s',rpe:'RPE 7',rest:'45s',tempo:'Isometric/slow',
 how:'Hands and toes down, knees hovering 3 cm off the floor, back flat. Hold, or crawl forward moving opposite hand and foot.',
 cue:'Hips stay low and level. Do not rock side to side when crawling.',
 prog:'Time → crawling distance → lateral crawls.',
 reg:'Knees down between reps.',
 subs:'RKC Plank'},

{id:'co09',name:'Band Pallof Press',cat:'core',muscles:'Anti-rotation — force transfer',equip:'BAND',sets:3,reps:'10–14 / side',rpe:'RPE 7',rest:'45s',tempo:'2-2-2-0',
 how:'Band anchored at chest height to your side. Hold it at the sternum, press it straight out, hold 2 seconds, return.',
 cue:'Resist the rotation. The hips and shoulders must not turn at all.',
 prog:'Band tension → step further from the anchor → hold longer → half-kneeling → split stance.',
 reg:'Move closer to the anchor.',
 subs:'Band Anti-Rotation Hold · Suitcase Carry',
 notes:'The single most tennis-relevant core exercise. Groundstroke force transfer is anti-rotation, not rotation.'},

{id:'co10',name:'Band Anti-Rotation Hold',cat:'core',muscles:'Obliques, deep core',equip:'BAND',sets:3,reps:'20–30s / side',rpe:'RPE 8',rest:'45s',tempo:'Isometric',
 how:'Same setup as the Pallof Press, but press out and simply hold the position while breathing normally.',
 cue:'Brace like you are about to be pushed. Keep breathing.',
 prog:'Time → tension → split stance.',
 reg:'Reduce tension.',
 subs:'Band Pallof Press'},

{id:'co11',name:'Half-Kneeling Band Chop',cat:'core',muscles:'Rotational control, obliques',equip:'BAND',sets:3,reps:'10–12 / side',rpe:'RPE 7',rest:'45s',tempo:'2-0-2-0',
 how:'Half-kneeling, band anchored high on one side. Pull diagonally down and across the body, controlling the return.',
 cue:'Rotate through the mid-back, not the lower back. Hips stay square and still.',
 prog:'Tension → slower eccentric → standing → add a step.',
 reg:'Reduce range and tension.',
 subs:'Band Rotational Press'},

{id:'co12',name:'Band Rotational Press',cat:'core',muscles:'Rotational power, force transfer',equip:'BAND',sets:3,reps:'8–12 / side',rpe:'RPE 7',rest:'45s',tempo:'Explosive out, slow back',
 how:'Athletic stance, band anchored behind you. Rotate through the back hip and press explosively across the body.',
 cue:'Power starts at the back foot — rotate the hip, then the torso, then the arm. Exactly the groundstroke sequence.',
 prog:'Tension → speed → add a step into it.',
 reg:'Slower, less tension.',
 subs:'Half-Kneeling Band Chop',
 notes:'Trains the kinetic chain sequence that generates racquet head speed.'},

{id:'co13',name:'Suitcase Carry',cat:'core',muscles:'Anti-lateral flexion, grip, traps',equip:'DB',sets:3,reps:'30–45s / side',rpe:'RPE 7',rest:'45s',tempo:'Walk',
 how:'Hold ONE dumbbell at your side and walk tall, resisting the pull to one side.',
 cue:'Shoulders level, ribs down. Do not lean away from the weight.',
 prog:'Time → distance → slower march with a knee lift.',
 reg:'Shorter carries.',
 subs:'Suitcase March · Side Plank',
 notes:'With a 5 kg DB, extend the time rather than adding weight.'},

{id:'co14',name:'Suitcase March',cat:'core',muscles:'Anti-lateral flexion, hip flexors',equip:'DB',sets:3,reps:'10–16 / side',rpe:'RPE 7',rest:'45s',tempo:'2-1-2-0',
 how:'Standing with one DB at your side, march slowly, driving each knee to hip height and pausing 1 second.',
 cue:'No side bend, no rushing. The torso stays completely still.',
 prog:'Pause length → reps → both DBs overhead.',
 reg:'No pause, lower knee lift.',
 subs:'Suitcase Carry'},

{id:'co15',name:'Mountain Climbers',cat:'core',muscles:'Core, hip flexors, conditioning',equip:'BW',sets:3,reps:'20–40 total',rpe:'RPE 7',rest:'45s',tempo:'Fast',
 how:'Plank position, drive the knees alternately towards the chest quickly without the hips rising.',
 cue:'Hips stay low and level. Speed comes from the legs, not from bouncing.',
 prog:'Reps → speed → cross-body variation.',
 reg:'Slower, or hands elevated.',
 subs:'Bear Crawl'},

{id:'co16',name:'Reverse Crunch',cat:'core',muscles:'Lower abs, posterior pelvic tilt',equip:'BW',sets:3,reps:'12–18',rpe:'RPE 7',rest:'45s',tempo:'2-0-3-0',
 how:'On your back, knees bent, curl the pelvis up off the floor towards the ribs, then lower over 3 seconds.',
 cue:'Lift with the abs by curling the pelvis — do not swing the legs.',
 prog:'Slower eccentric → straighter legs → hips elevated.',
 reg:'Smaller range.',
 subs:'Hollow Body Hold'},

{id:'co17',name:'Hollow Rock',cat:'core',muscles:'Anterior chain',equip:'BW',sets:3,reps:'12–20',rpe:'RPE 8',rest:'45s',tempo:'Rhythmic',
 how:'Hold a hollow body shape and rock back and forth from the shoulders to the hips, keeping the shape rigid.',
 cue:'The body shape never changes — only the contact point moves.',
 prog:'Reps → longer lever with arms overhead.',
 reg:'Hollow body hold instead.',
 subs:'Hollow Body Hold'},

/* ---------------- UPPER PUSH ---------------- */
{id:'up01',name:'Push-Up',cat:'push',muscles:'Chest, front delts, triceps, core',equip:'BW',sets:4,reps:'8–20',rpe:'RPE 8 (2 RIR)',rest:'75s',tempo:'3-1-1-0',
 how:'Hands slightly wider than the shoulders, body in a straight line. Lower the chest to just above the floor over 3 seconds, pause, press up.',
 cue:'Elbows at about 45° from the body, not flared to 90°. Squeeze the glutes to keep the body rigid.',
 prog:'Reps → 4s eccentric → 2s pause at the bottom → feet elevated → archer push-up.',
 reg:'Hands on a raised surface (incline push-up) — the higher the easier.',
 subs:'Incline Push-Up · DB Floor Press',
 notes:'Your primary chest builder. Progress the leverage, not the load.'},

{id:'up02',name:'Feet-Elevated Push-Up',cat:'push',muscles:'Upper chest, front delts, triceps',equip:'CHAIR',sets:4,reps:'6–15',rpe:'RPE 8',rest:'75s',tempo:'3-1-1-0',
 how:'Push-up with the feet on a chair, shifting more load to the upper chest and shoulders.',
 cue:'Do not let the hips sag. Full range — chest to the floor.',
 prog:'Reps → higher elevation → pause reps → archer.',
 reg:'Standard push-up.',
 subs:'Push-Up · Pike Push-Up'},

{id:'up03',name:'Archer Push-Up',cat:'push',muscles:'Chest, triceps — unilateral emphasis',equip:'BW',sets:3,reps:'4–8 / side',rpe:'RPE 8',rest:'75s',tempo:'3-0-1-0',
 how:'Wide hand position. Lower towards one hand while the other arm stays nearly straight, then press back up.',
 cue:'The straight arm assists only. Keep the hips square.',
 prog:'Reps → deeper range → less assistance from the straight arm → one-arm progression.',
 reg:'Standard push-up.',
 subs:'Push-Up',
 notes:'The main path to genuine strength gains once standard push-ups exceed 20 reps.'},

{id:'up04',name:'Diamond Push-Up',cat:'push',muscles:'Triceps, inner chest',equip:'BW',sets:3,reps:'6–15',rpe:'RPE 8',rest:'60s',tempo:'3-1-1-0',
 how:'Hands together forming a diamond under the chest. Lower the chest to the hands, elbows tucked tight.',
 cue:'Elbows stay close to the ribs throughout.',
 prog:'Reps → feet elevated → slower eccentric.',
 reg:'Close-grip push-up on the knees or on an incline.',
 subs:'Push-Up · Band Triceps Pushdown'},

{id:'up05',name:'Pike Push-Up',cat:'push',muscles:'Front & side delts, triceps',equip:'BW',sets:3,reps:'6–14',rpe:'RPE 8',rest:'75s',tempo:'3-1-1-0',
 how:'Downward-dog position, hips high. Lower the crown of the head towards the floor between the hands, then press back up.',
 cue:'Keep the hips stacked high over the shoulders — that is what makes it a shoulder exercise.',
 prog:'Reps → feet elevated on a chair → deficit with hands raised → toward handstand push-up.',
 reg:'Hands elevated, hips lower.',
 subs:'DB Overhead Press · Band Overhead Press',
 notes:'Your best available vertical pressing movement for deltoid mass and broader shoulders.'},

{id:'up06',name:'Elevated Pike Push-Up',cat:'push',muscles:'Delts, upper traps, triceps',equip:'CHAIR',sets:3,reps:'5–12',rpe:'RPE 8',rest:'75s',tempo:'3-1-1-0',
 how:'Pike push-up with the feet on a chair, bringing the torso closer to vertical.',
 cue:'Nearly vertical torso. Head travels down between the hands.',
 prog:'Reps → higher elevation → hands on books for a deficit.',
 reg:'Floor pike push-up.',
 subs:'Pike Push-Up'},

{id:'up07',name:'DB Floor Press',cat:'push',muscles:'Chest, triceps, front delts',equip:'DB',sets:3,reps:'12–20',rpe:'RPE 8',rest:'60s',tempo:'3-1-1-0',
 how:'Lying on the floor, press both DBs from the chest to lockout. The upper arms stop when the elbows touch the floor.',
 cue:'Slow eccentric, hard squeeze at the top. With 5 kg, chase the burn not the weight.',
 prog:'Reps → 4s eccentric → 2s pause on the floor → single arm.',
 reg:'Reduce reps.',
 subs:'Push-Up',
 notes:'Useful on days when wrist loading from push-ups is uncomfortable.'},

{id:'up08',name:'DB Overhead Press',cat:'push',muscles:'Delts, triceps, upper chest',equip:'DB',sets:3,reps:'12–20',rpe:'RPE 8',rest:'60s',tempo:'3-0-1-1',
 how:'Standing or half-kneeling, press both DBs from the shoulders to full lockout overhead.',
 cue:'Ribs down — do not arch the lower back. Biceps end beside the ears.',
 prog:'Reps → slow eccentric → single arm → half-kneeling for more core demand.',
 reg:'Seated, fewer reps.',
 subs:'Pike Push-Up · Band Overhead Press'},

{id:'up09',name:'DB Arnold Press',cat:'push',muscles:'All three deltoid heads',equip:'DB',sets:3,reps:'12–18',rpe:'RPE 8',rest:'60s',tempo:'3-0-2-0',
 how:'Start with the palms facing you at shoulder height. Rotate the palms outward as you press overhead, reverse on the way down.',
 cue:'Smooth continuous rotation. Control the whole path.',
 prog:'Reps → slower tempo → pause at the top.',
 reg:'Standard overhead press.',
 subs:'DB Overhead Press'},

{id:'up10',name:'DB Lateral Raise',cat:'push',muscles:'Side deltoids — shoulder width',equip:'DB',sets:4,reps:'15–25',rpe:'RPE 9 (near failure)',rest:'45s',tempo:'2-1-3-0',
 how:'Slight forward lean, DBs at the sides. Raise out to shoulder height leading with the elbows, pause, lower over 3 seconds.',
 cue:'Lead with the elbows, not the hands. No swinging — if you need momentum, slow down instead.',
 prog:'Reps → 4s eccentric → 2s pause at the top → partial burnout reps after failure → lean-away single arm.',
 reg:'Fewer reps, or bend the elbows more to shorten the lever.',
 subs:'Band Lateral Raise',
 notes:'5 kg is actually a GOOD lateral raise weight. This is your #1 exercise for visible shoulder width and V-taper.'},

{id:'up11',name:'Band Lateral Raise',cat:'push',muscles:'Side delts',equip:'BAND',sets:3,reps:'15–25',rpe:'RPE 9',rest:'45s',tempo:'2-1-2-0',
 how:'Stand on the band, raise the arms out to the sides against increasing tension.',
 cue:'The band gets harder at the top — that is exactly where the side delt works hardest. Do not cheat the top.',
 prog:'Shorten the band → more reps → slower eccentric.',
 reg:'Longer band.',
 subs:'DB Lateral Raise',
 notes:'Excellent paired immediately after DB lateral raises as a drop set.'},

{id:'up12',name:'DB Front Raise',cat:'push',muscles:'Front delts',equip:'DB',sets:3,reps:'12–20',rpe:'RPE 8',rest:'45s',tempo:'2-1-3-0',
 how:'Raise the DBs straight forward to shoulder height, pause, lower slowly.',
 cue:'No body swing. Stop at shoulder height.',
 prog:'Reps → slower eccentric → pause.',
 reg:'Alternate arms.',
 subs:'Band Front Raise',
 notes:'Low priority — your front delts already get plenty from pressing and serving.'},

{id:'up13',name:'Band Overhead Press',cat:'push',muscles:'Delts, triceps',equip:'BAND',sets:3,reps:'12–20',rpe:'RPE 8',rest:'60s',tempo:'2-0-2-0',
 how:'Stand on the band, press the handles overhead to lockout.',
 cue:'Tension increases at the top — keep pressing all the way.',
 prog:'Shorten the band → reps → single arm.',
 reg:'Longer band.',
 subs:'DB Overhead Press'},

{id:'up14',name:'Band Triceps Pushdown',cat:'push',muscles:'Triceps',equip:'BAND',sets:3,reps:'15–25',rpe:'RPE 9',rest:'45s',tempo:'2-1-2-0',
 how:'Band anchored high. Elbows pinned to the sides, extend the forearms down and squeeze hard at the bottom.',
 cue:'Only the forearms move. Elbows do not drift forward.',
 prog:'Tension → reps → 2s squeeze at lockout.',
 reg:'Less tension.',
 subs:'DB Overhead Triceps Extension'},

{id:'up15',name:'DB Overhead Triceps Extension',cat:'push',muscles:'Triceps (long head)',equip:'DB',sets:3,reps:'12–20',rpe:'RPE 8',rest:'45s',tempo:'3-1-1-0',
 how:'Hold one DB with both hands overhead. Lower it behind the head with a deep stretch, then extend.',
 cue:'Elbows stay narrow and pointing forward. Big stretch at the bottom is where the growth is.',
 prog:'Reps → slower eccentric → pause in the stretch → single arm.',
 reg:'Reduce range.',
 subs:'Band Triceps Pushdown · Diamond Push-Up'},

/* ---------------- UPPER PULL ---------------- */
{id:'ul01',name:'Band Row',cat:'pull',muscles:'Lats, rhomboids, rear delts, biceps',equip:'BAND',sets:4,reps:'12–20',rpe:'RPE 8',rest:'60s',tempo:'2-1-2-0',
 how:'Band anchored at chest height. Row the handles to the ribs, driving the elbows back and squeezing the shoulder blades.',
 cue:'Pull with the elbows, not the hands. Squeeze for a full second at the back.',
 prog:'Step further from the anchor → shorten the band → slower eccentric → single arm.',
 reg:'Step closer to the anchor.',
 subs:'DB Bent-Over Row · Inverted Row',
 notes:'Without a pull-up bar, band and DB rows are your entire back. Do not skip them — they drive both posture and V-taper.'},

{id:'ul02',name:'Band Single-Arm Row',cat:'pull',muscles:'Lats, mid-back, core anti-rotation',equip:'BAND',sets:3,reps:'12–18 / side',rpe:'RPE 8',rest:'45s',tempo:'2-1-2-0',
 how:'One handle, staggered stance. Row to the hip while resisting torso rotation.',
 cue:'Let the shoulder blade travel forward at the stretch, then pull it back and down.',
 prog:'Tension → reps → slower eccentric.',
 reg:'Less tension.',
 subs:'DB Bent-Over Row'},

{id:'ul03',name:'DB Bent-Over Row',cat:'pull',muscles:'Lats, rhomboids, rear delts',equip:'DB',sets:4,reps:'15–25',rpe:'RPE 8–9',rest:'60s',tempo:'2-1-3-0',
 how:'Hinge forward to about 45°, flat back. Row both DBs to the lower ribs, pause, lower slowly.',
 cue:'With light weight, the pause and slow eccentric are the whole exercise. Squeeze the blades together hard.',
 prog:'Reps → 3–4s eccentric → 2s squeeze → single-arm.',
 reg:'Support the chest on a chair.',
 subs:'Band Row'},

{id:'ul04',name:'DB Single-Arm Row',cat:'pull',muscles:'Lats, mid-back',equip:'DB+CHAIR',sets:3,reps:'15–25 / side',rpe:'RPE 8',rest:'45s',tempo:'2-1-3-0',
 how:'One hand and knee on a chair, other arm rowing the DB from a full stretch to the hip.',
 cue:'Full stretch at the bottom, elbow past the ribs at the top.',
 prog:'Reps → slower eccentric → 2s pause.',
 reg:'Standing, hand on the thigh.',
 subs:'Band Single-Arm Row'},

{id:'ul05',name:'Inverted Row',cat:'pull',muscles:'Lats, mid-back, biceps',equip:'CHAIR',sets:3,reps:'6–15',rpe:'RPE 8',rest:'75s',tempo:'2-1-2-0',
 how:'Lie under a sturdy table or between two stable chairs with a broom handle. Body straight, pull the chest to the edge.',
 cue:'Body rigid like a plank. Chest touches, not the chin.',
 prog:'Lower the body angle → feet elevated → slower eccentric.',
 reg:'Bend the knees, raise the body angle.',
 subs:'Band Row',
 notes:'ONLY with a confirmed stable surface that will take your full bodyweight. Test it carefully first.'},

{id:'ul06',name:'Band Lat Pulldown',cat:'pull',muscles:'Lats — V-taper width',equip:'BAND',sets:3,reps:'15–25',rpe:'RPE 8',rest:'60s',tempo:'2-1-2-0',
 how:'Anchor the band high (door top or a branch). Kneel and pull the handles down to the chest, elbows driving down and back.',
 cue:'Think of pulling the elbows into your back pockets. Feel the lats, not the arms.',
 prog:'Tension → kneel further back → slower eccentric → single arm.',
 reg:'Less tension.',
 subs:'Band Straight-Arm Pulldown',
 notes:'Your only true vertical pull. Prioritise it for lat width and the V-taper.'},

{id:'ul07',name:'Band Straight-Arm Pulldown',cat:'pull',muscles:'Lats (isolated)',equip:'BAND',sets:3,reps:'15–20',rpe:'RPE 8',rest:'45s',tempo:'2-1-2-0',
 how:'Band anchored high, arms straight. Pull down in an arc to the thighs, keeping the elbows locked.',
 cue:'Pure lat isolation — you should feel it directly under the armpits.',
 prog:'Tension → pause at the bottom → reps.',
 reg:'Less tension.',
 subs:'Band Lat Pulldown'},

{id:'ul08',name:'Band Pull-Apart',cat:'pull',muscles:'Rear delts, rhomboids, posture',equip:'BAND',sets:3,reps:'20–30',rpe:'RPE 7',rest:'40s',tempo:'2-1-2-0',
 how:'Hold the band at shoulder height with straight arms, pull it apart until it touches the chest, squeeze, return slowly.',
 cue:'Squeeze the shoulder blades. Do not shrug.',
 prog:'Reps → shorten the band → 2s hold at the end range.',
 reg:'Wider grip.',
 subs:'Band Face Pull · Prone Y-T-W',
 notes:'Do these almost daily. They directly counter the forward-shoulder posture that serving creates.'},

{id:'ul09',name:'Band Face Pull',cat:'pull',muscles:'Rear delts, external rotators, traps',equip:'BAND',sets:3,reps:'15–25',rpe:'RPE 7',rest:'45s',tempo:'2-1-2-0',
 how:'Band anchored at face height. Pull the handles towards the forehead, rotating the hands so the knuckles finish pointing behind you.',
 cue:'Finish in a double-biceps pose. External rotation is the whole point.',
 prog:'Tension → reps → 2s hold at the end.',
 reg:'Less tension.',
 subs:'Band Pull-Apart',
 notes:'The single best shoulder-health exercise for a serving athlete. Non-negotiable.'},

{id:'ul10',name:'Prone Y-T-W',cat:'pull',muscles:'Lower traps, rear delts, scapular control',equip:'BW',sets:3,reps:'8 each letter',rpe:'RPE 7',rest:'45s',tempo:'2-2-2-0',
 how:'Lie face down. Lift the arms off the floor in a Y shape, then a T, then a W, holding each for 2 seconds.',
 cue:'Thumbs up. Lift from the shoulder blades, not the hands. Keep the neck neutral.',
 prog:'Hold time → hold the DBs → more reps.',
 reg:'Fewer reps, no hold.',
 subs:'Band Pull-Apart · Superman'},

{id:'ul11',name:'Band Reverse Fly',cat:'pull',muscles:'Rear delts',equip:'BAND',sets:3,reps:'15–25',rpe:'RPE 8',rest:'45s',tempo:'2-1-2-0',
 how:'Band anchored at chest height, arms crossed and straight. Pull the arms apart and back in a wide arc.',
 cue:'Rear delts, not traps. Keep the shoulders down away from the ears.',
 prog:'Tension → reps → 2s hold.',
 reg:'Less tension.',
 subs:'Band Face Pull'},

{id:'ul12',name:'DB Bicep Curl',cat:'pull',muscles:'Biceps',equip:'DB',sets:3,reps:'15–25',rpe:'RPE 9',rest:'45s',tempo:'2-1-3-1',
 how:'Curl both DBs with the elbows pinned to the sides, squeeze at the top, lower over 3 seconds.',
 cue:'No swinging. With 5 kg the eccentric and the squeeze are everything.',
 prog:'Reps → 4s eccentric → 2s peak squeeze → 1.5 reps → drop into band curls.',
 reg:'Fewer reps.',
 subs:'Band Curl · Hammer Curl'},

{id:'ul13',name:'DB Hammer Curl',cat:'pull',muscles:'Brachialis, brachioradialis, forearms',equip:'DB',sets:3,reps:'15–25',rpe:'RPE 9',rest:'45s',tempo:'2-1-3-0',
 how:'Neutral grip (palms facing each other) throughout the curl.',
 cue:'Brachialis growth is what pushes the biceps up and makes the arm look thicker from the side.',
 prog:'Reps → slower eccentric → cross-body variation.',
 reg:'Fewer reps.',
 subs:'DB Bicep Curl'},

{id:'ul14',name:'Band Curl',cat:'pull',muscles:'Biceps',equip:'BAND',sets:3,reps:'20–30',rpe:'RPE 9',rest:'40s',tempo:'2-1-2-0',
 how:'Stand on the band and curl the handles with constant tension.',
 cue:'Peak tension at the top. Never let the band go slack.',
 prog:'Shorten the band → reps.',
 reg:'Longer band.',
 subs:'DB Bicep Curl',
 notes:'Best used as an immediate drop set straight after DB curls.'},

{id:'ul15',name:'Superman',cat:'pull',muscles:'Spinal erectors, glutes, posture',equip:'BW',sets:3,reps:'10–15',rpe:'RPE 6',rest:'40s',tempo:'2-2-2-0',
 how:'Lie face down and lift the chest, arms and legs off the floor. Hold 2 seconds.',
 cue:'Lengthen rather than crunch. Keep the neck neutral and look at the floor.',
 prog:'Hold time → reps → alternating swimmer variation.',
 reg:'Arms only or legs only.',
 subs:'Prone Y-T-W'},

/* ---------------- MOBILITY ---------------- */
{id:'mo01',name:'90/90 Hip Switch',cat:'mobility',muscles:'Hip internal & external rotation',equip:'FLOOR',sets:2,reps:'8–10 / side',rpe:'Easy',rest:'—',tempo:'Slow',
 how:'Seated with both knees bent at 90°, one leg in front and one to the side. Rotate the knees to switch sides under control.',
 cue:'Chest tall. Do not use the hands unless you need them.',
 prog:'Hands off the floor → pause and lift the front knee at the end range.',
 reg:'Use the hands for support, smaller range.',
 subs:'Hip Flexor Stretch',
 notes:'Hip internal rotation is the most limited and most important joint range for open-stance hitting.'},

{id:'mo02',name:"World's Greatest Stretch",cat:'mobility',muscles:'Hips, hamstrings, T-spine, adductors',equip:'FLOOR',sets:2,reps:'5 / side',rpe:'Easy',rest:'—',tempo:'Slow',
 how:'Deep lunge, opposite hand down. Drop the back knee, drive the elbow towards the instep, then rotate the top arm open to the sky.',
 cue:'Reach the fingertips as far as possible on the rotation and follow with your eyes.',
 prog:'Add a 3s hold at each end range.',
 reg:'Back knee down throughout.',
 subs:'Thoracic Rotation'},

{id:'mo03',name:'Couch Stretch',cat:'mobility',muscles:'Hip flexors, quads',equip:'WALL',sets:2,reps:'45–60s / side',rpe:'Easy',rest:'—',tempo:'Hold',
 how:'Rear foot up against a wall or sofa, front foot forward in a lunge. Squeeze the rear glute and bring the torso upright.',
 cue:'Tuck the pelvis first — that is what makes it work. Breathe.',
 prog:'Longer holds, more upright torso.',
 reg:'Rear foot on the floor.',
 subs:'Hip Flexor Stretch',
 notes:'Directly opposes the hip flexor tightness that comes from cycling and sitting.'},

{id:'mo04',name:'Ankle Dorsiflexion Rock',cat:'mobility',muscles:'Ankle, calf',equip:'WALL',sets:2,reps:'10–12 / side',rpe:'Easy',rest:'—',tempo:'Slow',
 how:'Half-kneeling, front foot ~10 cm from a wall. Drive the knee forward over the toes towards the wall without lifting the heel.',
 cue:'Heel STAYS down. Move the foot further back as it improves.',
 prog:'Increase the distance from the wall.',
 reg:'Move closer.',
 subs:'Calf Stretch',
 notes:'Ankle range limits how low you can get into a split step and a wide-ball lunge.'},

{id:'mo05',name:'Thoracic Rotation (Open Book)',cat:'mobility',muscles:'Mid-back rotation',equip:'FLOOR',sets:2,reps:'8–10 / side',rpe:'Easy',rest:'—',tempo:'Slow',
 how:'Side-lying, knees bent at 90° stacked, arms straight out in front. Open the top arm across the body, following it with your eyes.',
 cue:'The knees stay stacked and still — the rotation comes from the mid-back only.',
 prog:'Add a 3s hold at the end range.',
 reg:'Smaller range.',
 subs:"World's Greatest Stretch",
 notes:'Serve and groundstroke rotation should come from here, not the lower back.'},

{id:'mo06',name:'Cat-Cow',cat:'mobility',muscles:'Spine',equip:'FLOOR',sets:2,reps:'10',rpe:'Easy',rest:'—',tempo:'Slow',
 how:'On hands and knees, alternate between arching and rounding the spine, moving segment by segment.',
 cue:'Move slowly with the breath — inhale into the arch, exhale into the round.',
 prog:'More segmental control.',
 reg:'Smaller range.',
 subs:'Thoracic Rotation'},

{id:'mo07',name:'Wall Slides',cat:'mobility',muscles:'Shoulders, scapular upward rotation',equip:'WALL',sets:2,reps:'10–12',rpe:'Easy',rest:'—',tempo:'Slow',
 how:'Back against the wall, forearms on the wall. Slide the arms overhead while keeping the wrists, elbows and lower back in contact.',
 cue:'Ribs down. If the lower back arches, reduce the range.',
 prog:'Full overhead range with contact maintained.',
 reg:'Smaller range.',
 subs:'Shoulder CARs',
 notes:'Prepares the shoulder for overhead serving load.'},

{id:'mo08',name:'Shoulder CARs',cat:'mobility',muscles:'Full shoulder joint range',equip:'BW',sets:2,reps:'3–5 / side',rpe:'Easy',rest:'—',tempo:'Very slow',
 how:'Slowly trace the largest possible circle with one arm, keeping the rest of the body completely still.',
 cue:'Take 20 seconds per circle. Control every degree.',
 prog:'Slower, larger circles.',
 reg:'Smaller circles.',
 subs:'Wall Slides'},

{id:'mo09',name:'Adductor Rock',cat:'mobility',muscles:'Adductors, groin',equip:'FLOOR',sets:2,reps:'10–12',rpe:'Easy',rest:'—',tempo:'Slow',
 how:'On hands and knees, extend one leg out to the side with the foot flat. Rock the hips back and forth.',
 cue:'Keep the back flat. Feel the stretch in the inner thigh.',
 prog:'Wider position, deeper rock.',
 reg:'Narrower position.',
 subs:'Cossack Squat'},

{id:'mo10',name:'Pigeon Stretch',cat:'mobility',muscles:'Glutes, hip external rotation',equip:'FLOOR',sets:2,reps:'45–60s / side',rpe:'Easy',rest:'—',tempo:'Hold',
 how:'Front shin across the body, back leg extended straight behind. Fold forward over the front leg.',
 cue:'Keep the hips square. Breathe into the stretch rather than forcing it.',
 prog:'Deeper fold, longer hold.',
 reg:'Lying figure-4 stretch instead.',
 subs:'90/90 Hip Switch'},

{id:'mo11',name:'Calf Stretch',cat:'mobility',muscles:'Gastrocnemius, soleus',equip:'WALL',sets:2,reps:'40s / side',rpe:'Easy',rest:'—',tempo:'Hold',
 how:'Hands on a wall, one leg back with the heel down and the knee straight (gastroc), then repeat with the knee bent (soleus).',
 cue:'Do both versions — they stretch different muscles.',
 prog:'Longer holds.',
 reg:'Shorter holds.',
 subs:'Ankle Dorsiflexion Rock'},

{id:'mo12',name:'Hamstring Flow',cat:'mobility',muscles:'Hamstrings, posterior chain',equip:'FLOOR',sets:2,reps:'8–10 / side',rpe:'Easy',rest:'—',tempo:'Slow',
 how:'From a standing hinge, alternate between a straight-leg reach and a bent-knee position, moving smoothly through the range.',
 cue:'Move through the range rather than holding — dynamic before training, static after.',
 prog:'Greater range.',
 reg:'Bend the knees more.',
 subs:'Single-Leg RDL (unloaded)'},

{id:'mo13',name:'Band Shoulder Dislocates',cat:'mobility',muscles:'Shoulders, chest, thoracic',equip:'BAND',sets:2,reps:'8–12',rpe:'Easy',rest:'—',tempo:'Slow',
 how:'Wide grip on the band, take the arms from in front of the thighs over the head and behind the back, then reverse.',
 cue:'Start very wide and narrow the grip only as the range improves. Never force it.',
 prog:'Narrower grip.',
 reg:'Wider grip.',
 subs:'Wall Slides'},

/* ---------------- CARDIO ---------------- */
{id:'cd01',name:'Zone 2 Run',cat:'cardio',muscles:'Aerobic base',equip:'RUN',sets:1,reps:'25–45 min',rpe:'RPE 4–5',rest:'—',tempo:'Conversational',
 how:'Steady easy running where you could hold a full conversation. Roughly 65–75% of max HR (about 128–148 bpm for you).',
 cue:'If you cannot speak a full sentence, you are going too fast. Most people run their easy days too hard.',
 prog:'Add 5 minutes per week, up to about 45 minutes.',
 reg:'Run/walk intervals, or switch to the bike.',
 subs:'Zone 2 Bike',
 notes:'Builds the aerobic base that lets you recover between points and hold quality into a third set.'},

{id:'cd02',name:'Zone 2 Bike',cat:'cardio',muscles:'Aerobic base (low impact)',equip:'BIKE',sets:1,reps:'30–60 min',rpe:'RPE 4–5',rest:'—',tempo:'Conversational',
 how:'Steady easy cycling at a conversational effort.',
 cue:'Keep the cadence above 80 rpm and the effort genuinely easy.',
 prog:'Add 5–10 minutes per week.',
 reg:'Shorter duration.',
 subs:'Zone 2 Run',
 notes:'Your default aerobic option when the legs are sore or recovery is low — almost no impact cost.'},

{id:'cd03',name:'Tennis Interval Run',cat:'cardio',muscles:'Repeat-sprint ability',equip:'RUN',sets:8,reps:'20s hard / 40s easy',rpe:'RPE 8',rest:'Built in',tempo:'Intervals',
 how:'8–12 rounds of 20 seconds hard running followed by 40 seconds walking or easy jogging.',
 cue:'The 20:40 work-to-rest ratio mirrors real tennis point and changeover structure.',
 prog:'Add rounds (max 12) → extend the work to 25s → shorten the rest to 35s.',
 reg:'Fewer rounds, longer rest.',
 subs:'Hill Sprints · Bike Intervals',
 notes:'The most tennis-specific conditioning you can do off court.'},

{id:'cd04',name:'Hill Sprints',cat:'cardio',muscles:'Power endurance, glutes, calves',equip:'RUN',sets:6,reps:'10–15s uphill',rpe:'RPE 9',rest:'90s walk down',tempo:'Max',
 how:'Find a moderate hill. Sprint hard for 10–15 seconds, walk back down fully before repeating.',
 cue:'Powerful drive, tall posture. Stop the session when speed drops noticeably.',
 prog:'Add 1 rep per week, up to 10.',
 reg:'Fewer reps, shallower hill.',
 subs:'Acceleration Sprints',
 notes:'Lower impact stress than flat sprinting, with a high power stimulus.'},

{id:'cd05',name:'Recovery Spin',cat:'cardio',muscles:'Blood flow, active recovery',equip:'BIKE',sets:1,reps:'20–35 min',rpe:'RPE 2–3',rest:'—',tempo:'Very easy',
 how:'Very light cycling on flat ground with a high cadence and almost no resistance.',
 cue:'This should feel almost too easy. If you are breathing hard, slow down.',
 prog:'Do not progress this — it is meant to stay easy.',
 reg:'Shorter.',
 subs:'Easy Walk',
 notes:'Your primary RED and ORANGE day option. Promotes recovery without adding meaningful load.'},

{id:'cd06',name:'Easy Walk',cat:'cardio',muscles:'Active recovery',equip:'RUN',sets:1,reps:'20–40 min',rpe:'RPE 2',rest:'—',tempo:'Easy',
 how:'Relaxed walking, ideally outdoors and in daylight.',
 cue:'Morning daylight also helps anchor your body clock — a direct win for your sleep consistency.',
 prog:'—',
 reg:'—',
 subs:'Recovery Spin',
 notes:'Walking carries almost no recovery cost — it is the safest thing to add on a low day.'},

{id:'cd08',name:'Tempo Run',cat:'cardio',muscles:'Aerobic power, running economy',equip:'RUN',sets:1,reps:'15–25 min at tempo',rpe:'RPE 6–7',rest:'—',tempo:'Comfortably hard',
 how:'Warm up 10 min easy, then run 15–25 minutes at a pace you could hold for about an hour — breathing is controlled but conversation is limited to short phrases. Cool down 5–10 min easy.',
 cue:'This should feel "comfortably hard", never a race. If you are gasping, you have gone too fast and turned it into an interval session.',
 prog:'Add 3–5 minutes per week up to 25 min, then increase the pace slightly rather than the duration.',
 reg:'Break it into 2 × 10 min with 3 min easy between.',
 subs:'Zone 2 Run · Bike Intervals',
 notes:'Raises the ceiling on your aerobic base without the neural cost of sprint work. Use sparingly — tennis already supplies plenty of high-intensity running.'},

{id:'cd07',name:'Bike Intervals',cat:'cardio',muscles:'Aerobic power (low impact)',equip:'BIKE',sets:6,reps:'1 min hard / 2 min easy',rpe:'RPE 8',rest:'Built in',tempo:'Intervals',
 how:'6–10 rounds of 1 minute of hard cycling followed by 2 minutes easy.',
 cue:'Hard but repeatable — the last round should look like the first.',
 prog:'Add rounds → extend the work interval.',
 reg:'Fewer rounds.',
 subs:'Tennis Interval Run',
 notes:'Use instead of running intervals when the legs are beaten up from tennis.'}
];}
