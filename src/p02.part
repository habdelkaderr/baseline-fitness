<script>
"use strict";
/* ============================================================================
   BASELINE — Adaptive Training System
   Single-file, offline-first. All data stays in this browser (localStorage).
   Private, local-first, no server. Works with or without WHOOP.
   ========================================================================= */

/* ---------------------------------------------------------------- utilities */
const $  = (s,r)=> (r||document).querySelector(s);
const $$ = (s,r)=> Array.from((r||document).querySelectorAll(s));
const el = (t,a,h)=>{const n=document.createElement(t); if(a) for(const k in a){ if(k==='class')n.className=a[k]; else if(k.startsWith('on'))n.addEventListener(k.slice(2),a[k]); else if(a[k]!=null)n.setAttribute(k,a[k]); } if(h!=null)n.innerHTML=h; return n;};
const esc = s => String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid = ()=> Date.now().toString(36)+Math.random().toString(36).slice(2,8);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const dv   =(v,d=0)=>{ const r=rnd(v,d); return r==null?'—':r; };
const rnd  =(v,d=0)=>{ if(v==null||isNaN(v))return null; const m=Math.pow(10,d); return Math.round(v*m)/m; };
const mean = a =>{ const v=a.filter(x=>x!=null&&!isNaN(x)); return v.length? v.reduce((s,x)=>s+x,0)/v.length : null; };
const sd   = a =>{ const v=a.filter(x=>x!=null&&!isNaN(x)); if(v.length<2)return null; const m=mean(v); return Math.sqrt(v.reduce((s,x)=>s+(x-m)*(x-m),0)/(v.length-1)); };
const median=a=>{ const v=a.filter(x=>x!=null&&!isNaN(x)).sort((x,y)=>x-y); if(!v.length)return null; const i=Math.floor(v.length/2); return v.length%2?v[i]:(v[i-1]+v[i])/2; };
const sum  = a => a.filter(x=>x!=null&&!isNaN(x)).reduce((s,x)=>s+x,0);
const todayISO = ()=> new Date(Date.now()-new Date().getTimezoneOffset()*6e4).toISOString().slice(0,10);
const addDays  = (iso,n)=>{ const d=new Date(iso+'T12:00:00'); d.setDate(d.getDate()+n); return d.toISOString().slice(0,10); };
const dowOf    = iso => new Date(iso+'T12:00:00').getDay();          // 0=Sun
const DOW_NAME = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const DOW_FULL = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const fmtDate  = iso =>{ const d=new Date(iso+'T12:00:00'); return DOW_NAME[d.getDay()]+' '+d.getDate()+' '+['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()]; };
const fmtMin   = m =>{ if(m==null||isNaN(m))return '—'; const h=Math.floor(m/60), r=Math.round(m%60); return h? h+'h '+String(r).padStart(2,'0')+'m' : r+'m'; };
const mmss     = s =>{ s=Math.max(0,Math.round(s)); return Math.floor(s/60)+':'+String(s%60).padStart(2,'0'); };
/* A session clock. mmss is fine for a rest timer but a two-hour bike ride
   would read as '127:14', so this rolls over into hours. */
const hms      = s =>{ s=Math.max(0,Math.round(s));
  const h=Math.floor(s/3600), m=Math.floor((s%3600)/60), x=s%60;
  return h? h+':'+String(m).padStart(2,'0')+':'+String(x).padStart(2,'0')
          : m+':'+String(x).padStart(2,'0'); };
/* Minutes between two "HH:MM" strings, or null if either is missing. An end
   before a start means it ran past midnight, which a late game genuinely
   does, so it wraps rather than going negative. */
function minsBetween(from,to){
  const p=s=>{ const m=/^([0-9]{1,2}):([0-9]{2})$/.exec(String(s||'').trim());
               if(!m) return null;
               const h=+m[1], mi=+m[2];
               return (h<24 && mi<60) ? h*60+mi : null; };
  const a=p(from), b=p(to);
  if(a==null||b==null) return null;
  let d=b-a; if(d<0) d+=1440;
  return d;
}
/* "HH:MM" that many minutes after another one */
function timePlus(from,mins){
  const m=/^([0-9]{1,2}):([0-9]{2})$/.exec(String(from||'').trim());
  if(!m || mins==null) return '';
  const t=(((+m[1])*60+(+m[2])+(+mins))%1440+1440)%1440;
  return String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0');
}

/* minutes per kilometre as 5:42 */
const paceStr  = p =>{ if(p==null||!isFinite(p)||p<=0) return '—';
  const m=Math.floor(p), s=Math.round((p-m)*60);
  return (s===60? (m+1)+':00' : m+':'+String(s).padStart(2,'0'))+' /km'; };
const daysBetween=(a,b)=> Math.round((new Date(b+'T12:00:00')-new Date(a+'T12:00:00'))/864e5);
function pearson(xs,ys){
  const p=[]; for(let i=0;i<xs.length;i++) if(xs[i]!=null&&ys[i]!=null&&!isNaN(xs[i])&&!isNaN(ys[i])) p.push([xs[i],ys[i]]);
  if(p.length<8) return null;
  const mx=mean(p.map(v=>v[0])), my=mean(p.map(v=>v[1]));
  let n=0,dx=0,dy=0; p.forEach(([x,y])=>{n+=(x-mx)*(y-my); dx+=(x-mx)**2; dy+=(y-my)**2;});
  if(!dx||!dy) return null;
  return {r:n/Math.sqrt(dx*dy), n:p.length};
}
const ICON = {
  today:'<path d="M3 9.5L12 3l9 6.5V20a1 1 0 01-1 1H4a1 1 0 01-1-1z"/><path d="M9 21v-7h6v7"/>',
  dumbbell:'<path d="M6.5 6.5v11M3 9v6M17.5 6.5v11M21 9v6M6.5 12h11"/>',
  tennis:'<circle cx="12" cy="12" r="9"/><path d="M5 5c4.5 4 4.5 10 0 14M19 5c-4.5 4-4.5 10 0 14"/>',
  chart:'<path d="M3 20h18"/><path d="M6 20v-6M11 20V7M16 20v-9M21 20v-4"/>',
  pulse:'<path d="M3 12h4l2.5-7 4 14L16 12h5"/>',
  gear:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.6 1.6 0 00-1.8-.3 1.6 1.6 0 00-1 1.5V21a2 2 0 11-4 0v-.1A1.6 1.6 0 008 19.4a1.6 1.6 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.6 1.6 0 00.3-1.8 1.6 1.6 0 00-1.5-1H2a2 2 0 110-4h.1A1.6 1.6 0 003.6 8a1.6 1.6 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.6 1.6 0 001.8.3H8a1.6 1.6 0 001-1.5V2a2 2 0 114 0v.1a1.6 1.6 0 001 1.5 1.6 1.6 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.6 1.6 0 00-.3 1.8V8a1.6 1.6 0 001.5 1H22a2 2 0 110 4h-.1a1.6 1.6 0 00-1.5 1z"/>',
  chev:'<path d="M9 18l6-6-6-6"/>', down:'<path d="M6 9l6 6 6-6"/>',
  left:'<path d="M15 18l-6-6 6-6"/>',
  check:'<path d="M20 6L9 17l-5-5"/>', x:'<path d="M18 6L6 18M6 6l12 12"/>',
  plus:'<path d="M12 5v14M5 12h14"/>', undo:'<path d="M3 7v6h6"/><path d="M3.5 13a9 9 0 102.1-7"/>',
  edit:'<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"/>',
  copy:'<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>',
  trash:'<path d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2M19 6l-1 14a1 1 0 01-1 1H7a1 1 0 01-1-1L5 6"/>',
  play:'<path d="M6 4l14 8-14 8z"/>', up:'<path d="M18 15l-6-6-6 6"/>',
  down2:'<path d="M6 9l6 6 6-6"/>', dl:'<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>',
  ul:'<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/>',
  flame:'<path d="M12 2s4 4.5 4 8a4 4 0 01-8 0c0-1 .5-2 .5-2S7 10 6 12a6 6 0 1012 0c0-5-6-10-6-10z"/>',
  moon:'<path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/>',
  heart:'<path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 10-7.8 7.8l8.8 8.8 8.8-8.8a5.5 5.5 0 000-7.8z"/>',
  timer:'<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/>',
  book:'<path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>',
  run:'<circle cx="16" cy="4" r="2"/><path d="M12 21l1.5-6-3-2.5L9 17M10.5 12.5L8 8l4-1.5 3 2.5 3 1"/>',
  bike:'<circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 6a1 1 0 100-2 1 1 0 000 2zM12 17.5L9 9l4-1 2.5 3.5H18"/>',
  target:'<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/>',
  ruler:'<path d="M3.5 9.5h17a1 1 0 011 1v3a1 1 0 01-1 1h-17a1 1 0 01-1-1v-3a1 1 0 011-1z"/><path d="M7 9.5v2M11 9.5v3M15 9.5v2M19 9.5v3"/>',
  info:'<circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/>',
  /* the open readiness ring — the app's own mark, and sport-neutral */
  ring:'<path d="M12 3.5a8.5 8.5 0 1 1-8.5 8.5"/>',
  /* device types — enough to tell a ring from a band from a watch */
  watch:'<rect x="6.5" y="6.5" width="11" height="11" rx="3.4"/><path d="M9.5 6.5V3.5h5v3M9.5 17.5v3h5v-3"/>',
  band:'<rect x="3" y="9" width="18" height="6" rx="3"/><path d="M8.5 9v6M15.5 9v6"/>',
  ringfull:'<circle cx="12" cy="12" r="6.6"/>',
  /* equipment */
  eband:'<path d="M4 12c2.6-5.2 13.4-5.2 16 0-2.6 5.2-13.4 5.2-16 0z"/>',
  bench:'<path d="M3 10.5h18v3H3zM6.5 13.5V19M17.5 13.5V19"/>',
  pullbar:'<path d="M3 5.5h18M8 5.5v4M16 5.5v4M12 9.5v3"/>',
  kettle:'<path d="M9.2 7.4a3 3 0 015.6 0"/><path d="M7 9.4h10a6 6 0 11-10 0z"/>',
  medball:'<circle cx="12" cy="12" r="8"/><path d="M12 4v16M4 12h16"/>',
  barbell:'<path d="M2 12h20M5 8v8M19 8v8M8.5 9.5v5M15.5 9.5v5"/>',
  cable:'<path d="M5 4v6a7 7 0 0014 0V4"/><circle cx="12" cy="18.5" r="2.4"/>',
  /* metrics */
  drop:'<path d="M12 3.2s6 6.6 6 10.2a6 6 0 11-12 0C6 9.8 12 3.2 12 3.2z"/>',
  thermo:'<path d="M10 14.2V5a2 2 0 114 0v9.2a4 4 0 11-4 0z"/>'
};
const FILLED={play:1};
const svg=(k,cls)=>`<svg class="${cls||''}" viewBox="0 0 24 24" fill="${FILLED[k]?'currentColor':'none'}" stroke="currentColor" stroke-width="${FILLED[k]?0:2}" stroke-linecap="round" stroke-linejoin="round">${ICON[k]||''}</svg>`;

/* =========================================================================
   AUDIBLE CUES
   Synthesised rather than shipped. An audio file would be bytes in the page, a
   request to make, and one more thing to get wrong offline; four short tones
   are about thirty lines of maths. Browsers will not start an AudioContext
   outside a user gesture, so it is created lazily and resumed on every use.
   ====================================================================== */
let AC=null;
function soundOn(){ return !(DB&&DB.settings) || DB.settings.sound!==false; }
function audioCtx(){
  if(!soundOn()) return null;
  try{
    if(!AC){ const C=window.AudioContext||window.webkitAudioContext; if(!C) return null; AC=new C(); }
    if(AC.state==='suspended'){ const r=AC.resume(); if(r&&r.catch) r.catch(()=>{}); }
    return AC;
  }catch(e){ return null; }
}
function beep(freq,dur,delay,vol){
  const c=audioCtx(); if(!c) return;
  try{
    const t0=c.currentTime+(delay||0), d=dur||0.14;
    const o=c.createOscillator(), g=c.createGain();
    o.type='sine'; o.frequency.setValueAtTime(freq,t0);
    /* an exponential ramp cannot touch zero, hence the near-silent floor:
       a square-edged gain change is an audible click on its own */
    g.gain.setValueAtTime(0.0001,t0);
    g.gain.exponentialRampToValueAtTime(Math.max(0.0002,vol||0.16),t0+0.012);
    g.gain.exponentialRampToValueAtTime(0.0001,t0+d);
    o.connect(g); g.connect(c.destination);
    o.start(t0); o.stop(t0+d+0.04);
  }catch(e){}
}
const SOUND={
  tick: ()=>beep(880,0.05,0,0.06),                                   // 3, 2, 1
  rest: ()=>{ beep(784,0.14,0,0.17); beep(1046,0.22,0.15,0.17); },   // rest over
  set:  ()=>beep(660,0.06,0,0.08),                                   // set logged
  done: ()=>{ beep(523,0.12,0,0.15); beep(659,0.12,0.12,0.15);
              beep(784,0.26,0.24,0.15); }                            // session saved
};

/* =========================================================================
   LOCAL ALERTS
   ------------------------------------------------------------------------
   This is NOT a push notification and the distinction is the whole point.
   Web Push would mean a push service, a server, and a subscription endpoint
   identifying this device sitting on it. There is none of that here: the
   phone raises its own alert, for a timer the phone itself is running, and
   nothing about you leaves the device. Off until the user asks for it, and
   permission is only ever requested from a tap.
   ====================================================================== */
function notifySupported(){ return typeof Notification!=='undefined'; }
function notifyState(){ return notifySupported()? Notification.permission : 'unsupported'; }
function notifyAsk(cb){
  if(!notifySupported()) return cb&&cb('unsupported');
  const done=p=>{ if(cb){ const f=cb; cb=null; f(p||notifyState()); } };
  try{
    /* two spellings of the same call: Safari kept the callback form long
       after everyone else returned a promise */
    const r=Notification.requestPermission(done);
    if(r&&r.then) r.then(done).catch(()=>done('denied'));
  }catch(e){ done('denied'); }
}
function notifyOn(){ return !!(DB&&DB.settings&&DB.settings.notify) && notifyState()==='granted'; }
function notify(title,body){
  if(!notifyOn()) return;
  const opt={body:body||'', tag:'baseline-timer', renotify:true,
             icon:'icons/icon-192.png', badge:'icons/icon-192.png'};
  try{
    /* through the service worker where there is one, because a page that is
       hidden or discarded cannot raise a Notification itself */
    if(navigator.serviceWorker && navigator.serviceWorker.ready){
      navigator.serviceWorker.ready
        .then(reg=>{ try{ reg.showNotification(title,opt); }
                     catch(e){ try{ new Notification(title,opt); }catch(e2){} } })
        .catch(()=>{ try{ new Notification(title,opt); }catch(e){} });
    } else { new Notification(title,opt); }
  }catch(e){}
}

let toastT;
function toast(msg,kind){ const t=$('#toast'); t.textContent=msg; t.className=(kind||'')+' on'; clearTimeout(toastT); toastT=setTimeout(()=>t.className=t.className.replace('on','').trim(),2400); }
function haptic(){ try{ if(navigator.vibrate) navigator.vibrate(8);}catch(e){} }

/* =========================================================================
   LOCAL DATA STORE  —  privacy-first, per-device, no server
   ------------------------------------------------------------------------
   Architecture:
        GitHub Pages  ->  delivers application code only
        Browser       ->  runs the app
        IndexedDB     ->  THIS device's private data
   Nothing here ever leaves the device. There is no account, no sync, no
   telemetry and no remote database. Two people using the app, or one person
   on two devices, have entirely separate datasets by construction — the only
   way to move data is an explicit JSON backup.

   IndexedDB is the primary durable store, with a real per-collection schema
   and versioned migrations. localStorage holds only tiny boot preferences.
   The whole dataset is held in memory as `DB` while the app runs so the UI
   stays synchronous; writes are debounced back to IndexedDB.
   ====================================================================== */
const DB_NAME='baseline';
const DB_VERSION=2;                 // bump to add/alter object stores
const SCHEMA_VERSION=2;             // bump to transform stored records
/* A readable build stamp. Without one, a tester reporting "it's broken" cannot
   tell you whether they are on today's build or a cached copy from last week,
   which is most of the diagnosis. Bump this on every deploy. */
/* A date, plus a letter when more than one build ships in a day. Without the
   letter there was no way to tell a second same-day deploy from the cached
   copy of the first, which is exactly the question "did my upload work?". */
const APP_BUILD='2026-09-20b';
/* The last few errors, kept in memory only, so a bug report can carry
   something better than "it stopped working". Never written to disk, never
   sent anywhere — it is read only by the diagnostics button. */
const ERRLOG=[];
function noteError(what){
  ERRLOG.push(String(what).slice(0,160));
  if(ERRLOG.length>5) ERRLOG.shift();
}
window.addEventListener('error',e=>noteError((e.message||'error')+' @'+(e.lineno||'?')));
window.addEventListener('unhandledrejection',e=>
  noteError('promise: '+((e.reason&&e.reason.message)||e.reason||'?')));

/* =========================================================================
   DIAGNOSTICS
   A short, copyable summary for a bug report. Deliberately contains no
   training data: counts only, never values, notes, dates of sessions or
   anything a person entered. It goes to the clipboard, not to a server.
   ====================================================================== */
function diagnostics(){
  const P=(DB&&DB.profile)||{};
  const standalone = (window.matchMedia&&window.matchMedia('(display-mode:standalone)').matches)
                     || window.navigator.standalone===true;
  const ua=navigator.userAgent||'';
  const dev = /iPhone/.test(ua)?'iPhone' : /iPad/.test(ua)?'iPad'
            : /Android/.test(ua)?'Android' : /Mac/.test(ua)?'Mac'
            : /Windows/.test(ua)?'Windows' : 'other';
  const br  = /CriOS/.test(ua)?'Chrome iOS' : /FxiOS/.test(ua)?'Firefox iOS'
            : /Edg\//.test(ua)?'Edge' : /Chrome/.test(ua)?'Chrome'
            : /Safari/.test(ua)?'Safari' : 'other';
  const osm = ua.match(/OS (\d+[_.]\d+)/) || ua.match(/Version\/(\d+)/);
  const n=(a)=>Array.isArray(a)?a.length:0;
  const L=[];
  L.push(`Baseline build ${APP_BUILD} (schema ${SCHEMA_VERSION})`);
  L.push(`${dev}${osm?' '+osm[1].replace('_','.'):''} \u00b7 ${br} \u00b7 ${standalone?'installed':'browser tab'} \u00b7 ${window.innerWidth}x${window.innerHeight}`);
  L.push(`Theme: ${themePref()}`);
  L.push(`Storage: ${Store.mode||'?'} \u00b7 eviction protection ${Store.persisted===true?'granted':Store.persisted===false?'DENIED':'unknown'}`);
  L.push(`Setup: ${P.onboarded?'complete':'NOT FINISHED'} \u00b7 wearable ${P.source||'?'} \u00b7 sports ${(P.sports||[]).join('+')||'-'} \u00b7 gear ${(P.gear||[]).join('+')||'none'}`);
  L.push(`Data: ${n(DB.sessions)} sessions, ${n(DB.activities)} activities, ${Object.keys(DB.checkins||{}).length} check-ins, ${n(DB.tests)} tests, ${n(DB.whoop&&DB.whoop.cycles)} imported days, ${n(P.limits)} limitations`);
  L.push(`Errors: ${ERRLOG.length?ERRLOG.join(' | '):'none'}`);
  return L.join('\n');
}
function copyDiagnostics(){
  const txt=diagnostics();
  const done=()=>toast('Diagnostics copied — paste it into your message','ok');
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(done).catch(()=>showDiagnostics(txt));
  } else showDiagnostics(txt);
}
/* clipboard access is refused in some browsers; show the text so it can still
   be selected by hand rather than failing silently */
function showDiagnostics(txt){
  openSheet('Diagnostics',
    `<p class="hint" style="margin-bottom:12px">Copy this and send it over. It contains no training data \u2014 counts only.</p>
     <textarea class="inp" id="diagTxt" style="min-height:190px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px">${esc(txt||diagnostics())}</textarea>`,
    `<button class="btn primary big block" onclick="closeSheet()">Done</button>`);
  const el=$('#diagTxt'); if(el){ el.focus(); el.select(); }
}
const KEY='baseline.tps.v1';        // legacy localStorage blob (v1 installs)
const PREF='baseline.prefs';        // tiny, non-sensitive boot hints

/* collection -> object store definition */
const STORES={
  sessions  :{key:'id',   idx:['date']},
  activities:{key:'id',   idx:['date','type']},
  checkins  :{key:'date', idx:[]},
  exercises :{key:'id',   idx:['cat']},
  workouts  :{key:'id',   idx:[]},
  tests     :{key:'id',   idx:['testId','date']},
  physique  :{key:'id',   idx:['date']},
  wCycles   :{key:'date', idx:[]},
  wWorkouts :{key:'key',  idx:['date']},
  wJournal  :{key:'key',  idx:['date']},
  wImports  :{key:'at',   idx:[]}
};
/* singleton objects live in one keyed store */
const KV_KEYS=['profile','settings','targets','baselines','plans','decisions','ui','meta','mcycle'];
/* =========================================================================
   THEME
   Light by default, dark when the system asks for it, and an explicit
   override if the user would rather pin one. Stored in localStorage rather
   than the main record so it can be applied before the database has opened —
   otherwise the app flashes the wrong theme on every launch.
   ====================================================================== */
const THEMES=[{id:'auto',name:'Match system'},{id:'light',name:'Light'},{id:'dark',name:'Dark'}];
function themePref(){
  try{ return localStorage.getItem('baseline.theme')||'auto'; }catch(e){ return 'auto'; }
}
function systemIsDark(){
  return !!(window.matchMedia && window.matchMedia('(prefers-color-scheme:dark)').matches);
}
function applyTheme(mode){
  const m=mode||themePref();
  const r=document.documentElement;
  if(m==='auto') r.removeAttribute('data-theme');
  else r.setAttribute('data-theme',m);
  /* keep the browser chrome — status bar, form controls — in step */
  const dark = m==='dark' || (m==='auto' && systemIsDark());
  const meta=document.querySelector('meta[name="theme-color"]');
  if(meta) meta.setAttribute('content', dark?'#0B0C0E':'#FBFBF9');
  return m;
}
function setTheme(mode){
  try{ localStorage.setItem('baseline.theme',mode); }catch(e){}
  applyTheme(mode);
}
applyTheme();
/* follow the system live while set to auto */
if(window.matchMedia){
  const mq=window.matchMedia('(prefers-color-scheme:dark)');
  const onChange=()=>{ if(themePref()==='auto') applyTheme('auto'); };
  if(mq.addEventListener) mq.addEventListener('change',onChange);
  else if(mq.addListener) mq.addListener(onChange);
}

/* collections written on an ordinary save (WHOOP is large and rarely changes) */
const LIGHT=['sessions','activities','checkins','exercises','workouts','tests','physique'];
const HEAVY=['wCycles','wWorkouts','wJournal','wImports'];

const IDB={
  db:null, ok:false, err:null,
  open(){ return new Promise(res=>{
    try{
      if(!self.indexedDB){ IDB.err='IndexedDB unavailable'; return res(false); }
      const r=indexedDB.open(DB_NAME,DB_VERSION);
      r.onupgradeneeded=ev=>{
        const db=r.result;
        /* schema migration: additive only, never destructive */
        Object.keys(STORES).forEach(name=>{
          const def=STORES[name];
          let st;
          if(!db.objectStoreNames.contains(name)) st=db.createObjectStore(name,{keyPath:def.key});
          else st=r.transaction.objectStore(name);
          def.idx.forEach(f=>{ if(!st.indexNames.contains('by_'+f)) st.createIndex('by_'+f,f,{unique:false}); });
        });
        if(!db.objectStoreNames.contains('kv')) db.createObjectStore('kv');
        IDB.upgradedFrom=ev.oldVersion;
      };
      r.onsuccess=()=>{
        IDB.db=r.result; IDB.ok=true;
        IDB.db.onversionchange=()=>{ try{ IDB.db.close(); }catch(e){} IDB.ok=false; };
        IDB.db.onclose=()=>{ IDB.ok=false; };
        res(true);
      };
      r.onerror=()=>{ IDB.err=(r.error&&r.error.name)||'open failed'; res(false); };
      r.onblocked=()=>{ IDB.err='blocked by another tab'; res(false); };
      setTimeout(()=>{ if(!IDB.ok) res(false); },2500);   // never stall boot
    }catch(e){ IDB.err=e.message; res(false); }
  });},
  tx(names,mode){ return IDB.db.transaction(names,mode); },
  all(store){ return new Promise(res=>{
    if(!IDB.ok) return res([]);
    try{ const r=IDB.tx([store],'readonly').objectStore(store).getAll();
      r.onsuccess=()=>res(r.result||[]); r.onerror=()=>res([]);
    }catch(e){ res([]); }
  });},
  getKV(k){ return new Promise(res=>{
    if(!IDB.ok) return res(null);
    try{ const r=IDB.tx(['kv'],'readonly').objectStore('kv').get(k);
      r.onsuccess=()=>res(r.result==null?null:r.result); r.onerror=()=>res(null);
    }catch(e){ res(null); }
  });},
  /* write a set of collections + kv singletons in ONE transaction */
  writeAll(collections, kv){ return new Promise(res=>{
    if(!IDB.ok) return res(false);
    try{
      const names=collections.slice(); if(kv) names.push('kv');
      const tx=IDB.tx(names,'readwrite');
      tx.oncomplete=()=>res(true);
      tx.onerror=()=>res(false);
      tx.onabort=()=>{ Store.quotaHit=(tx.error&&tx.error.name==='QuotaExceededError'); res(false); };
      collections.forEach(name=>{
        const st=tx.objectStore(name);
        st.clear();                                   // full replace keeps memory and disk identical
        const rows=collectionRows(name);
        for(let i=0;i<rows.length;i++){ try{ st.put(rows[i]); }catch(e){} }
      });
      if(kv){ const st=tx.objectStore('kv'); KV_KEYS.forEach(k=>{ try{ st.put(DB[k]!==undefined?DB[k]:null,k); }catch(e){} }); }
    }catch(e){ res(false); }
  });},
  wipe(){ return new Promise(res=>{
    if(!IDB.ok) return res(false);
    try{
      const names=Object.keys(STORES).concat('kv');
      const tx=IDB.tx(names,'readwrite');
      tx.oncomplete=()=>res(true); tx.onerror=()=>res(false); tx.onabort=()=>res(false);
      names.forEach(n=>{ try{ tx.objectStore(n).clear(); }catch(e){} });
    }catch(e){ res(false); }
  });}
};
/* map a store name onto the in-memory collection it mirrors */
function collectionRows(name){
  switch(name){
    case 'checkins': return Object.keys(DB.checkins||{}).map(d=>Object.assign({date:d},DB.checkins[d]));
    case 'wCycles':   return DB.whoop.cycles||[];
    case 'wWorkouts': return DB.whoop.workouts||[];
    case 'wJournal':  return DB.whoop.journal||[];
    case 'wImports':  return (DB.whoop.imports||[]).map(x=>Object.assign({},x,{at:x.at||new Date().toISOString()}));
    default: return DB[name]||[];
  }
}

function withTimeout(p,ms,fallback){
  return Promise.race([
    Promise.resolve(p).catch(()=>fallback),
    new Promise(r=>setTimeout(()=>r(fallback),ms))
  ]);
}

const Store={
  idb:false, local:false, mem:{}, persisted:null, quotaHit:false, lastWrite:null, writing:false,
  async init(){
    try{ localStorage.setItem('__bl_probe','1'); localStorage.removeItem('__bl_probe'); this.local=true; }
    catch(e){ this.local=false; }
    this.idb=await withTimeout(IDB.open(),2500,false);
    /* Never awaited: on a secure origin this can stay pending indefinitely
       while the browser decides, which would hang boot and show a blank app. */
    this.requestPersist();
    return this;
  },
  requestPersist(){
    try{
      if(navigator.storage&&navigator.storage.persist){
        withTimeout(navigator.storage.persist(),3000,null)
          .then(v=>{ if(v!=null){ this.persisted=v; try{ updateBanner(); }catch(e){} } }).catch(()=>{});
      }
    }catch(e){}
  },
  get mode(){ return this.idb?'IndexedDB':this.local?'localStorage (fallback)':'memory only'; },
  get durable(){ return this.idb||this.local; },
  /* Small preferences, in localStorage because they must be readable before
     IndexedDB has opened: the theme, and the id of a workout left running.
     A live workout is training data, so it is cleared by both delete paths
     and is listed in DATA-PRIVACY.md rather than described as nothing. */
  pref(k,v){
    try{
      const o=JSON.parse(localStorage.getItem(PREF)||'{}');
      if(v===undefined) return o[k];
      o[k]=v; localStorage.setItem(PREF,JSON.stringify(o));
    }catch(e){ return undefined; }
  },
  /* ---- load the whole dataset into memory ---- */
  async loadAll(){
    if(this.idb){
      const out={};
      for(const k of KV_KEYS) out[k]=await IDB.getKV(k);
      const cols={};
      for(const name of Object.keys(STORES)) cols[name]=await IDB.all(name);
      const any = KV_KEYS.some(k=>out[k]) || Object.keys(cols).some(k=>cols[k].length);
      if(any) return {kv:out, cols};
    }
    /* v1 installs kept one JSON blob in localStorage — migrate it in */
    if(this.local){
      try{ const raw=localStorage.getItem(KEY); if(raw) return {legacy:JSON.parse(raw)}; }catch(e){}
    }
    return null;
  },
  /* ---- persist ---- */
  async write(heavy){
    if(!DB) return false;
    this.writing=true;
    let ok=false;
    const cols = heavy ? LIGHT.concat(HEAVY) : LIGHT.slice();
    if(this.idb) ok = await IDB.writeAll(cols,true);
    if(!ok && this.local){
      /* fallback for browsers where IndexedDB is unavailable */
      try{ localStorage.setItem(KEY,JSON.stringify(DB)); ok=true; this.quotaHit=false; }
      catch(e){ this.quotaHit=true; }
    }
    this.writing=false;
    if(ok) this.lastWrite=Date.now();
    return ok;
  },
  async clearAll(){
    if(this.idb) await IDB.wipe();
    this.purgeLegacy();
    try{ localStorage.removeItem(PREF); }catch(e){}
  },
  /* The whole-DB JSON blob that `write` falls back to when IndexedDB is
     unavailable. It contains imported health data, so anything that claims
     to delete that data has to remove it too - whether or not this session
     happens to be using it. Skipping that is how a deletion claim becomes
     untrue on the one device where it mattered. */
  purgeLegacy(){
    try{ localStorage.removeItem(KEY); }catch(e){}
  },
  async estimate(){
    try{ if(navigator.storage&&navigator.storage.estimate) return await withTimeout(navigator.storage.estimate(),2000,null); }catch(e){}
    return null;
  },
  counts(){
    if(!DB) return {};
    return {sessions:(DB.sessions||[]).length, activities:(DB.activities||[]).length,
      checkins:Object.keys(DB.checkins||{}).length, exercises:(DB.exercises||[]).length,
      workouts:(DB.workouts||[]).length, cycles:(DB.whoop.cycles||[]).length,
      whoopWorkouts:(DB.whoop.workouts||[]).length, journal:(DB.whoop.journal||[]).length};
  }
};

let DB=null, saveT=null, saveHeavyPending=false;
function save(now,heavy){
  if(heavy) saveHeavyPending=true;
  clearTimeout(saveT);
  const go=()=>{
    const h=saveHeavyPending; saveHeavyPending=false;
    Store.write(h).then(ok=>{
      if(!ok) toast(Store.quotaHit?'Storage full — export a backup':'Could not save — export a backup','err');
      updateBanner();
    });
  };
  if(now) go(); else saveT=setTimeout(go,300);
}
/* WHOOP stores are large and only change on import/restore/erase */
const saveWhoop=()=>save(true,true);

/* the honest warning when data will not survive a reload */
function updateBanner(){
  const el2=document.getElementById('sbanner'); if(!el2)return;
  if(Store.durable && !Store.quotaHit){ el2.className=''; el2.innerHTML=''; return; }
  el2.className='on';
  el2.innerHTML = Store.quotaHit
    ? `<b>Storage is full.</b> Recent changes may not have been saved. Export a JSON backup now, then remove old data.
       <button id="sbBk">Export backup</button>`
    : `<b>This page cannot save data.</b> Your browser is blocking local storage for this page, so anything you enter will be lost when you close the tab.
       <button id="sbFix">How to fix this →</button>`;
  const a=document.getElementById('sbBk'); if(a)a.onclick=exportJSON;
  const b=document.getElementById('sbFix'); if(b)b.onclick=()=>{ openSetup(); };
}

/* where is this running? drives the Setup screen */
const ENV={
  get proto(){ return location.protocol; },
  get isFile(){ return location.protocol==='file:'; },
  get isHttps(){ return location.protocol==='https:'||location.hostname==='localhost'||location.hostname==='127.0.0.1'; },
  get standalone(){ return !!(window.navigator.standalone) ||
    (window.matchMedia&&window.matchMedia('(display-mode: standalone)').matches); },
  get iOS(){ return /iPad|iPhone|iPod/.test(navigator.userAgent) ||
    (navigator.platform==='MacIntel'&&navigator.maxTouchPoints>1); },
  get safari(){ return /^((?!chrome|android|crios|fxios|edgios).)*safari/i.test(navigator.userAgent); },
  get desktop(){ return window.matchMedia&&window.matchMedia('(min-width: 900px)').matches; },
  get canInstall(){ return this.isHttps && !this.standalone; }
};

/* =========================================================================
   BASELINES
   Nothing physiological is invented. Until a WHOOP export is imported these
   stay null, the UI shows them as "not established", and the engine drops
   those signals from its weighting rather than substituting a population
   average and presenting it as the user's own baseline.
   The one exception is a generic 8h sleep-need placeholder, labelled as
   generic everywhere it appears.
   ====================================================================== */
const SEED_BASE = {
  source:'No WHOOP data imported — physiological baselines not established.',
  hrv:null, hrvSd:null, rhr:null, rhrSd:null,
  recovery:null, recoverySd:null,
  sleepNeed:480, sleepNeedGeneric:true,
  sleepMean:null, sleepPerf:null,
  respRate:null, respSd:null,
  strainMean:null, strainSd:null,
  computed:false, n:0, from:null, to:null
};
/* does THIS device actually hold WHOOP data? */
const hasWhoop  = ()=> !!(DB&&DB.whoop&&DB.whoop.cycles&&DB.whoop.cycles.length>=7);
const whoopMode = ()=> !!(DB&&DB.profile&&DB.profile.source&&DB.profile.source!=='none');

