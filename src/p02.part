  g13:null,                // Lat Pulldown - a machine; was drawn as a band
  g14:'bb-row',            // Barbell Row - was an unloaded bent-over row
  g15:null,                // Seated Cable Row - a machine
  g16:null,                // Cable Face Pull - a cable stack
  /* Was 'band-pallof'. The position and direction are identical, which is
     why it looked acceptable - but the drawing put a resistance band in the
     hands of somebody doing a cable exercise, and a band is kit a gym user
     may not own. Every other cable movement here is already null; this one
     was the outlier, and the equipment check found it. */
  g17:null,                // Cable Pallof Press - a cable stack is not drawn
  g18:null,                // Cable Woodchop - a cable stack
  g19:'hang-leg-raise',    // Hanging Leg Raise - had no drawing
  g20:null,                // Trap Bar Jump - a trap bar is not drawn
