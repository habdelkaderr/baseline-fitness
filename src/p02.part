  co16:'reverse-crunch',   // Reverse Crunch - was a hollow hold
  co17:'hollow-hold',      // Hollow Rock

  /* ---- gym library ---- */
  g01:'bb-squat',          // Barbell Back Squat - was a bodyweight squat
  g02:'bb-hinge',          // Barbell Romanian Deadlift - was an unloaded hinge
  g03:'bb-hip-thrust',     // Barbell Hip Thrust - was a floor glute bridge
  g04:null,                // Leg Press - a machine, and machines are not drawn
  g05:null,                // Seated Leg Curl - a machine; was drawn as a Nordic curl
  g06:'calf-raise',        // Standing Calf Raise (machine) - the movement is the same
  g07:'lunge',             // Walking Lunge (loaded)
  g08:'bb-bench',          // Barbell Bench Press - had no drawing at all
  g09:'db-bench-press',    // DB Bench Press - was drawn on the floor
  g10:'bb-ohp',            // Overhead Press (barbell) - was two dumbbells
  g11:null,                // Cable Lateral Raise - a cable stack is not drawn
