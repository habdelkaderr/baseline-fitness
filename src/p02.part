  'sl-hop':{head:[62,24],sh:[56,36],hip:[48,54],
    arm:[[66,40],[78,34]], arm2:[[64,42],[76,38]],
    leg:[[70,58],[62,76]], leg2:[[62,50],[78,44]],
    props:[{t:'arr',a:[34,52],b:[34,26]}]},
  'row-single':{head:[30,36],sh:[44,40],hip:[66,46],
    arm:[[48,52],[54,42]], arm2:[[42,50],[36,58]],
    leg:[[68,58],[64,76]], leg2:[[66,58],[62,76]],
    props:[{t:'arr',a:[56,64],b:[56,48]}]},

  /* ---- travelling, not rising ----------------------------------------
     A broad jump with an upward arrow is an instruction to do a vertical
     jump. The whole exercise is the horizontal distance. */
  'broad-jump':{head:[62,24],sh:[56,36],hip:[48,54],
    arm:[[66,40],[80,36]], arm2:[[64,42],[78,38]],
    leg:[[70,58],[62,76]], leg2:[[68,60],[60,76]],
    props:[{t:'arr',a:[86,50],b:[112,44]}]},
  'split-jump':{head:[58,22],sh:[56,34],hip:[54,52],
    arm:[[64,40],[74,32]], arm2:[[46,42],[36,36]],
    leg:[[72,56],[84,64]], leg2:[[40,58],[26,66]],
    props:[{t:'arr',a:[14,48],b:[14,26]}]},

  /* ---- the load that was missing -------------------------------------- */
  /* ONE band, and the arms caught mid-raise rather than locked out level.
     Two bands running from wide hands down to close feet draw a large V,
     and a V is a shape - the eye reads the triangle and not the movement.
     Standing on the band with one band up to the working hand is both what
     people actually do and what leaves the body visible. */
  'band-raise':{head:[60,14],sh:[60,28],hip:[60,48],
    arm:[[50,36],[38,30]], arm2:[[70,36],[82,30]],
    leg:[[56,62],[56,76]], leg2:[[64,62],[64,76]],
    props:[{t:'band',a:[60,76],b:[38,30],c:[42,56]},
           {t:'arr',a:[24,42],b:[24,28]}]},
  'db-hip-thrust':{head:[26,70],sh:[36,70],hip:[62,54],
    arm:[[32,68],[46,56]], arm2:[[34,70],[48,58]],
    leg:[[84,60],[84,76]], leg2:[[82,62],[82,76]],
    props:[{t:'db',at:[54,50]},{t:'arr',a:[62,44],b:[62,50]}]},
  'band-glute-bridge':{head:[26,70],sh:[36,70],hip:[62,54],
    arm:[[32,74],[24,76]], arm2:[[34,74],[26,76]],
    leg:[[84,60],[84,76]], leg2:[[82,62],[82,76]],
    props:[{t:'band',a:[48,52],b:[78,54],c:[62,44]},{t:'arr',a:[62,40],b:[62,48]}]},

  /* landing on one leg, which is the exercise and the risk both */
  'sl-landing':{head:[54,18],sh:[56,32],hip:[62,50],
    arm:[[48,38],[38,32]], arm2:[[66,40],[74,34]],
    leg:[[78,60],[84,76]], leg2:[[58,54],[44,48]],
    props:[{t:'arr',a:[100,44],b:[86,44]}]},

  /* ---- hips on the floor ------------------------------------------- */
  pigeon:{head:[40,38],sh:[44,50],hip:[54,66],
    arm:[[58,60],[70,64]], arm2:[[56,62],[68,66]],
    leg:[[46,72],[28,70]], leg2:[[72,70],[92,72]]},
  'adductor-rock':{head:[30,52],sh:[44,48],hip:[80,48],
    arm:[[44,60],[44,76]], arm2:[[42,60],[42,76]],
    leg:[[80,62],[92,74]], leg2:[[86,58],[106,62]],
    props:[{t:'arr',a:[62,36],b:[46,36]}]},

  'worlds-greatest':{head:[46,26],sh:[48,38],hip:[44,56],
    arm:[[54,30],[60,18]], arm2:[[46,52],[44,70]],
    leg:[[70,58],[74,76]], leg2:[[30,66],[18,74]],
    props:[{t:'arc',at:[60,18],r:7}]},
  'band-face-pull':{head:[58,16],sh:[58,30],hip:[58,50],
    arm:[[74,26],[64,22]], arm2:[[72,30],[62,26]],
    leg:[[54,63],[52,76]], leg2:[[64,63],[66,76]],
    props:[{t:'wall',x:112},{t:'anchor',at:[112,20]},{t:'band',a:[112,20],b:[64,22],c:[88,18]}]}
};

/* RETIRED: name rules.
   These decided every exercise's drawing until the illustration audit. They
   are kept only because WU_ILLUS below is the same idea applied to warm-up
   movement names, which genuinely have no id - and because the list is the
   record of which names were ambiguous. NOTHING READS POSE_RULES ANY MORE;
   illusKey() goes to EX_ILLUS. If you are adding an exercise, add a line to
   EX_ILLUS, look at the drawing, and leave it null if it is not right.

   What went wrong with rules, concretely: order decided meaning. "Sliding Leg
   Curl" had to be caught by the hamstring rule before the biceps rule saw
   "curl", "Step-Up" fell into the lunge rule because no step existed to draw,
   and a name nobody had written a rule for silently got the nearest match
   instead of nothing.

   Derived from the name, by rules, in order - not from a table of ids.

   The first version WAS a table of ids, written by reading the id ranges and
   assuming they ran in category order. They do not: "DB Bicep Curl" is ul12
   and got a band held overhead, and "Band Kneeling Lat Pull" lives in a second
   library in p03b so it was never in the table and got nothing at all. A
   longer hand-written table would have the same failure mode with more places
   to hide. What a movement IS sits in its name, so that is what is read.

   Ordered, first match wins, specific before general - "Sliding Leg Curl" has
   to be caught by the hamstring rule before the bicep-curl rule sees "curl".
   Anything genuinely irregular goes in EX_ILLUS_OVERRIDE below. */
const POSE_RULES=[
  /* hamstrings first: these contain "curl" and are not arm work */
  [/nordic|leg curl/,                      'nordic'],
  /* pulling */
  [/pallof|anti-rotation|rotational press|band chop/, 'band-pallof'],
  [/face pull/,                            'band-face-pull'],
  [/pull-?apart|reverse fly/,              'band-pull-apart'],
  [/lat pull|pulldown|straight-arm/,       'lat-pull'],
  [/\brow\b/,                              'row'],
  [/superman/,                             'superman'],
  [/y-t-w|prone y/,                        'prone-ytw'],
  [/shrug/,                                'carry'],
  /* pressing and arms */
  [/triceps pushdown|pushdown/,            'band-pushdown'],
  [/triceps extension|overhead triceps/,   'db-overhead-tri'],
  [/floor press/,                          'floor-press'],
  [/overhead press|arnold/,                'db-press-oh'],
  [/lateral raise|front raise/,            'db-raise'],
  [/\bcurl\b/,                             'db-curl'],
  /* push-ups, most specific first */
  [/scapular push/,                        'scap-pushup'],
  [/pike push/,                            'pike-push-up'],
  [/incline push/,                         'incline-push-up'],
  [/push-?up/,                             'push-up'],
  /* trunk */
  [/copenhagen/,                           'copenhagen'],
  [/side plank/,                           'side-plank'],
  [/suitcase|farmer|carry|march/,          'carry'],
  [/bear (hold|crawl)|mountain climber/,   'plank'],
  [/plank/,                                'plank'],
  [/hollow|reverse crunch/,                'hollow-hold'],
  [/bird dog/,                             'bird-dog'],
  [/dead bug/,                             'dead-bug'],
  /* hips and legs */
  [/single-leg glute bridge|single leg glute bridge/, 'sl-glute-bridge'],
  [/glute bridge|hip thrust/,              'glute-bridge'],
  [/adductor squeeze/,                     'adductor-squeeze'],
  [/single-leg rdl|single leg rdl/,        'sl-rdl'],
  [/rdl|romanian|good morning|hinge/,      'hinge'],
  [/wall sit/,                             'wall-sit'],
  [/tibialis/,                             'tibialis-raise'],
  [/single-leg calf|single leg calf/,      'sl-calf-raise'],
  [/calf raise/,                           'calf-raise'],
  [/calf stretch/,                         'calf-stretch'],
  [/couch stretch/,                        'couch-stretch'],
  [/ankle dorsiflexion|ankle rock/,        'ankle-rock'],
  [/goblet/,                               'goblet-squat'],
  [/split squat|cossack|skater squat/,     'split-squat'],
  [/lunge/,                                'lunge'],
  /* plyometrics and sprint work, before the plain squat rule */
  [/pogo|ankle stiffness/,                 'pogo-hops'],
  [/lateral bound|skater|lateral shuffle|star drill|spider/, 'lateral-bound'],
  [/depth drop|drop & stick|drop and stick|deceleration|5-10-5|agility|split-?step/, 'decel'],
  [/jump|\bhop\b|hops\b|broad jump/,       'jump'],
  [/squat/,                                'squat'],
  /* mobility */
  [/wall slide/,                           'wall-slides'],
  [/shoulder car/,                         'shoulder-cars'],
  [/dislocate/,                            'band-overhead'],
  [/open book|thoracic rotation/,          'open-book'],
  [/cat-?cow/,                             'cat-cow'],
  [/90\/90|hip switch|adductor rock|pigeon/, 'hip-90-90'],
  [/legs up|hamstring flow/,               'legs-up-wall'],
  [/breath/,                               'breathe'],
  [/world's greatest|worlds greatest/,     'worlds-greatest'],
  /* conditioning */
  [/bike|spin|cycl/,                       'bike'],
  [/\bwalk/,                               'walk'],
  [/sprint|run|jog|knees|butt kick|a-skip/,'run'],
  /* whatever is left that clearly involves a band overhead */
  [/band overhead/,                        'band-overhead'],
  /* added when the whole-library check named them: these need only kit the app
     already draws, so falling back would have been laziness rather than a
     limit. What is left undrawn needs a rack, a cable stack or a bar. */
  [/step-?up|step-?down/,                  'lunge'],
  [/frog pump/,                            'glute-bridge'],
  [/pull-?through/,                        'hinge'],
  [/rotational throw|woodchop/,            'band-pallof'],
  [/db bench|incline db press/,            'floor-press'],
  [/heel lower|heel drop/,                 'sl-calf-raise'],
  [/side-?lying adductor|adductor raise/,  'copenhagen'],
  [/adductor slide|slide-?out/,            'adductor-squeeze'],
  [/band rotation/,                        'band-pallof'],
  [/snap-?down|drop landing|\blanding\b/,  'decel'],
  [/acceleration/,                         'run'],
  [/windshield/,                           'open-book'],
  [/\bbounds?\b/,                          'jump']
];

/* RETIRED with POSE_RULES. Every one of these is now a line in EX_ILLUS,
   which is where an exception and a rule look the same - because to the
   reader of a table they are the same. */
const EX_ILLUS_OVERRIDE={
  mo12:'legs-up-wall',     /* "Hamstring Flow" is a supine flow, not a hinge */
  sp01:'decel',            /* "Split-Step Reaction Drill" is a braking step */
  sp07:'lateral-bound'     /* "Crossover Step Start" moves sideways first */
};

/* WARM-UP MOVEMENTS, BY NAME.
   A warm-up item is a line of text inside a workout - "Pogo hops", "12 reps"
   - not a library row, so it has no id to look up and a name is all there
   is. This is now the ONLY place a name decides a drawing, and it is a
   closed table: a warm-up name that is not here gets the placeholder, not
   the nearest match.

   Keys are lower-cased, because illusKey() lower-cases before looking up. */
const WU_ILLUS={
  /* the stock routines, every movement they prescribe */
  'ankle dorsiflexion rock':'ankle-rock', 'bodyweight squats':'squat',
  'glute bridge':'glute-bridge', 'walking lunge':'lunge',
  'pogo hops':'pogo-hops', 'band pull-apart':'band-pull-apart',
  'wall slides':'wall-slides', 'shoulder cars':'shoulder-cars',
  'scapular push-ups':'scap-pushup', 'incline push-ups':'incline-push-up',
  'band face pull':'band-face-pull', "world's greatest stretch":'worlds-greatest',
  'a-skips':'run', 'high knees':'run', 'butt kicks':'run',
  'lateral shuffle':'lateral-bound', 'split squat':'split-squat',
  '90/90 hip switch':'hip-90-90', 'cat-cow':'cat-cow',
  'dead bug':'dead-bug', 'bird dog':'bird-dog',
  /* motions rather than shapes, which is why they are named here at all */
  'arm circles':'arm-circles', 'arm circles + leg swings':'arm-circles',
  'leg swings front/back':'stand', 'leg swings lateral':'stand',
  'leg swings all directions':'stand', 'hip circles + leg swings':'stand',
  'leg swings + hip circles':'stand',
  'doorway chest stretch':'wall-slides', 'serve shadow swings':'band-overhead',
  'shadow swings / rotational throws':'band-pallof',
  'gentle full-body stretch':'breathe', 'slow nasal breathing':'breathe',
  'easy bike or brisk walk':'bike', 'easy walk or spin':'walk',
  'easy jog, spin or brisk walk':'run', 'easy jog or bike':'run',
  'easy jog around the court':'run', 'easy jog or walk':'run',
  'build-up runs':'run', 'build-up sprints':'run',
  'countermovement jumps':'jump', 'drop and stick':'decel',
  'lateral shuffle + crossover':'lateral-bound',
  'split step + first step':'decel', 'adductor rock':'adductor-rock'
};

/* =========================================================================
   EXERCISE -> ILLUSTRATION, EXPLICITLY
   ------------------------------------------------------------------------
   One line per exercise id. The pose named here was compared against the
   rendered drawing, checking body position, which limb moves, the direction
   of travel, the implement in the hands, whether it is one limb or two, and
   whether the arrow says what actually happens. `null` means no drawing has
   been verified for it, and null renders a placeholder rather than the
   nearest-looking thing.

   This replaces name-pattern matching. Patterns are how a hamstring bridge
   curl came to be drawn as a biceps curl: the name contained "curl", the
   rule fired, and nothing downstream could tell that the picture was of a
   different exercise entirely. A table makes a wrong drawing a visible line
   in a diff instead of an emergent property of rule order.

   Where two exercises share a pose it is because the drawing is true of
   both - Chin-Up and Pull-Up differ only in grip, which a stick figure
   cannot show and which no drawing here pretends to show.
   ====================================================================== */
const EX_ILLUS = {
  /* ---- cardio ---- */
  cd01:'run',              // Zone 2 Run
  cd02:'bike',             // Zone 2 Bike
  cd03:'run',              // Tennis Interval Run
  cd04:'run',              // Hill Sprints
  cd05:'bike',             // Recovery Spin
  cd06:'walk',             // Easy Walk
  cd07:'bike',             // Bike Intervals
  cd08:'run',              // Tempo Run

  /* ---- core ---- */
