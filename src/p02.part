  yoga:'<circle cx="12" cy="4" r="2"/><path d="M12 6.4v5.8"/><path d="M12 12.2l-6 3M12 12.2l6 3"/><path d="M4.4 19.2c2.6-2.6 12.6-2.6 15.2 0"/>',
  climb:'<path d="M4.6 21V5.6a2 2 0 0 1 2-2H19"/><path d="M9.2 8.2h.01M14.8 6.4h.01M11.2 13h.01M16.8 11.2h.01M8.6 17.6h.01M14.2 16.4h.01"/>',
  /* anything the list does not have a drawing for, said as "and the rest"
     rather than borrowed from something else */
  dots:'<circle cx="5" cy="12" r="1.3"/><circle cx="12" cy="12" r="1.3"/><circle cx="19" cy="12" r="1.3"/>',
  /* ---- the trunk, drawn as a trunk ---------------------------------------
     The core session used to carry `ul`, the upload arrow. That is the share
