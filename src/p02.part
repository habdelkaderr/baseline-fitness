  x36:'resisted-sprint',   // Resisted Sprint Starts - the band was missing
  x37:'broad-jump',        // Hill Bounds - travel, not height
  x38:'wall-iso-raise',    // Wall Isometric Lateral Raise - was drawn holding dumbbells
  x39:'self-resisted-curl',// Self-Resisted Curl - was drawn holding dumbbells
  x40:'windshield-wiper',  // Lying Windshield Wiper - was a side-lying open book
  x41:'prone-lat-pull'     // Prone Sliding Lat Pull - was a kneeling band pulldown
};

/* The one lookup everything else uses. Returns a verified pose key, or null.
   Never a guess: an illustration of the wrong exercise is worse than no
   illustration, because the user cannot tell that it is wrong.

   Resolution order, and why:
     1. `ex.illus`   - a row that states its own pose, for user-added
                       exercises. Checked against POSES so a stale key
                       cannot render nothing.
     2. EX_ILLUS[id] - the verified table. AUTHORITATIVE, including when the
                       answer is null. An id that is in the table never falls
                       through to a name rule, which is what stopped
                       "Single-Leg Bridge Curl" being drawn as a biceps curl.
     3. WU_ILLUS     - warm-up movement names. These are free text inside a
                       workout, not library rows, so they have no id to look
                       up and a name is all there is.
     4. nothing      - and nothing is a real answer. */
function illusKey(ex){
  if(!ex) return null;
  if(ex.illus && POSES[ex.illus]) return ex.illus;
  if(ex.id && Object.prototype.hasOwnProperty.call(EX_ILLUS, ex.id)){
    const k=EX_ILLUS[ex.id];
    return (k && POSES[k]) ? k : null;
  }
  const nm=String(ex.name||'').trim().toLowerCase();
  if(!nm) return null;
  if(WU_ILLUS[nm] && POSES[WU_ILLUS[nm]]) return WU_ILLUS[nm];
  return null;
}
/* Where the answer came from, for the validator's messages and for the
   "why this drawing" line in the library. */
function illusWhy(ex){
  if(!ex) return 'no exercise';
  if(ex.illus && POSES[ex.illus]) return 'declared on the exercise';
  if(ex.id && Object.prototype.hasOwnProperty.call(EX_ILLUS, ex.id))
    return EX_ILLUS[ex.id] ? 'verified table' : 'table: none verified';
  const nm=String(ex.name||'').trim().toLowerCase();
  if(WU_ILLUS[nm]) return 'warm-up name';
  return 'not in the table';
}
/* `size` is 'lg' on the training screen, 'sm' for a list thumbnail.

   A movement with no verified drawing gets a PLACEHOLDER, and the
   placeholder has to look like a placeholder. It used to be the dumbbell
   icon, which on a training screen reads as "here is your exercise" - a
   silent claim about a movement nothing had checked. A dashed frame with a
   line of text reads as an absence, which is what it is. */
function illusHTML(ex, size){
  const k=illusKey(ex);
  const sz=size||'lg';
  if(!k) return `<div class="illus ${sz} none" role="img"
      aria-label="No illustration for this movement yet">
      <span class="il-n">${svg('help')}${sz==='sm'?'':'<b>No illustration yet</b>'}</span>
    </div>`;
  return `<div class="illus ${sz}">${figSVG(POSES[k])}</div>`;
}
/* Coverage and correctness, for the validator and the About screen.
   `unverified` is named rather than counted, because the point of the number
   is to be worked through. */
function illusCoverage(){
  const all=(DB&&DB.exercises)||[];
  const unverified=[], missing=[];
  all.forEach(e=>{
    if(illusKey(e)) return;
    if(e.id && Object.prototype.hasOwnProperty.call(EX_ILLUS, e.id)) unverified.push(e.id);
    else missing.push(e.id||e.name);
  });
  return {have:all.length-unverified.length-missing.length, total:all.length,
          poses:Object.keys(POSES).length,
          unverified:unverified, missing:missing};
}
/* Every pose named by the table must exist, and every exercise must be in
   the table. Returned rather than thrown so a test can name the rows. */
function illusAudit(){
  const all=(DB&&DB.exercises)||[];
  const notInTable=[], deadPose=[], unusedPose=[];
  const used={};
  all.forEach(e=>{
    if(!e.id || !Object.prototype.hasOwnProperty.call(EX_ILLUS, e.id)) notInTable.push(e.id||e.name);
  });
  Object.keys(EX_ILLUS).forEach(id=>{
    const k=EX_ILLUS[id];
    if(k==null) return;
    if(!POSES[k]) deadPose.push(id+' -> '+k); else used[k]=1;
  });
  Object.keys(WU_ILLUS).forEach(n=>{
    const k=WU_ILLUS[n];
    if(!POSES[k]) deadPose.push('warm-up "'+n+'" -> '+k); else used[k]=1;
  });
  Object.keys(POSES).forEach(k=>{ if(!used[k]) unusedPose.push(k); });
  return {notInTable:notInTable, deadPose:deadPose, unusedPose:unusedPose,
          rows:Object.keys(EX_ILLUS).length};
}

/* =========================================================================
   EXERCISE LIBRARY
   Every exercise declares the equipment it needs; you are only ever shown
   1 resistance band · bicycle · running · open space. Nothing else.
   ====================================================================== */
