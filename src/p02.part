<script>
"use strict";
/* ============================================================================
   BASELINE — Adaptive Training System
   Single-file, offline-first. All data stays in this browser (localStorage).
   Private, local-first, no server. Works with or without WHOOP.
   ========================================================================= */

/* ---------------------------------------------------------------- utilities */
const $  = (s,r)=> (r||document).querySelector(s);
const $$ = (s,r)=> Array.from((r||document).querySelectorAll(s));
const el = (t,a,h)=>{const n=document.createElement(t); if(a) for(const k in a){ if(k==='class')n.className=a[k]; else if(k.startsWith('on'))n.addEventListener(k.slice(2),a[k]); else if(a[k]!=null)n.setAttribute(k,a[k]); } if(h!=null)n.innerHTML=h; return n;};
const esc = s => String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid = ()=> Date.now().toString(36)+Math.random().toString(36).slice(2,8);
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const dv   =(v,d=0)=>{ const r=rnd(v,d); return r==null?'—':r; };
const rnd  =(v,d=0)=>{ if(v==null||isNaN(v))return null; const m=Math.pow(10,d); return Math.round(v*m)/m; };
const mean = a =>{ const v=a.filter(x=>x!=null&&!isNaN(x)); return v.length? v.reduce((s,x)=>s+x,0)/v.length : null; };
const sd   = a =>{ const v=a.filter(x=>x!=null&&!isNaN(x)); if(v.length<2)return null; const m=mean(v); return Math.sqrt(v.reduce((s,x)=>s+(x-m)*(x-m),0)/(v.length-1)); };
const median=a=>{ const v=a.filter(x=>x!=null&&!isNaN(x)).sort((x,y)=>x-y); if(!v.length)return null; const i=Math.floor(v.length/2); return v.length%2?v[i]:(v[i-1]+v[i])/2; };
const sum  = a => a.filter(x=>x!=null&&!isNaN(x)).reduce((s,x)=>s+x,0);
const todayISO = ()=> new Date(Date.now()-new Date().getTimezoneOffset()*6e4).toISOString().slice(0,10);
const addDays  = (iso,n)=>{ const d=new Date(iso+'T12:00:00'); d.setDate(d.getDate()+n); return d.toISOString().slice(0,10); };
const dowOf    = iso => new Date(iso+'T12:00:00').getDay();          // 0=Sun
const DOW_NAME = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const DOW_FULL = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const fmtDate  = iso =>{ const d=new Date(iso+'T12:00:00'); return DOW_NAME[d.getDay()]+' '+d.getDate()+' '+['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][d.getMonth()]; };
/* "14–20 Sep", or "28 Sep – 4 Oct" across a month edge. Short enough for the
   week strip, and explicit about which week is on screen. */
const weekRangeLabel = (from,to)=>{
  const MON=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const a=new Date(from+'T12:00:00'), b=new Date(to+'T12:00:00');
  return a.getMonth()===b.getMonth()
    ? a.getDate()+'–'+b.getDate()+' '+MON[b.getMonth()]
    : a.getDate()+' '+MON[a.getMonth()]+' – '+b.getDate()+' '+MON[b.getMonth()];
};
const fmtMin   = m =>{ if(m==null||isNaN(m))return '—'; const h=Math.floor(m/60), r=Math.round(m%60); return h? h+'h '+String(r).padStart(2,'0')+'m' : r+'m'; };
const mmss     = s =>{ s=Math.max(0,Math.round(s)); return Math.floor(s/60)+':'+String(s%60).padStart(2,'0'); };
/* A session clock. mmss is fine for a rest timer but a two-hour bike ride
   would read as '127:14', so this rolls over into hours. */
const hms      = s =>{ s=Math.max(0,Math.round(s));
  const h=Math.floor(s/3600), m=Math.floor((s%3600)/60), x=s%60;
  return h? h+':'+String(m).padStart(2,'0')+':'+String(x).padStart(2,'0')
          : m+':'+String(x).padStart(2,'0'); };
/* Minutes between two "HH:MM" strings, or null if either is missing. An end
   before a start means it ran past midnight, which a late game genuinely
   does, so it wraps rather than going negative. */
function minsBetween(from,to){
  const p=s=>{ const m=/^([0-9]{1,2}):([0-9]{2})$/.exec(String(s||'').trim());
               if(!m) return null;
               const h=+m[1], mi=+m[2];
               return (h<24 && mi<60) ? h*60+mi : null; };
  const a=p(from), b=p(to);
  if(a==null||b==null) return null;
  let d=b-a; if(d<0) d+=1440;
  return d;
}
/* "HH:MM" that many minutes after another one */
function timePlus(from,mins){
  const m=/^([0-9]{1,2}):([0-9]{2})$/.exec(String(from||'').trim());
  if(!m || mins==null) return '';
  const t=(((+m[1])*60+(+m[2])+(+mins))%1440+1440)%1440;
  return String(Math.floor(t/60)).padStart(2,'0')+':'+String(t%60).padStart(2,'0');
}

/* minutes per kilometre as 5:42 */
const paceStr  = p =>{ if(p==null||!isFinite(p)||p<=0) return '—';
  const m=Math.floor(p), s=Math.round((p-m)*60);
  return (s===60? (m+1)+':00' : m+':'+String(s).padStart(2,'0'))+' /km'; };
const daysBetween=(a,b)=> Math.round((new Date(b+'T12:00:00')-new Date(a+'T12:00:00'))/864e5);
function pearson(xs,ys){
  const p=[]; for(let i=0;i<xs.length;i++) if(xs[i]!=null&&ys[i]!=null&&!isNaN(xs[i])&&!isNaN(ys[i])) p.push([xs[i],ys[i]]);
  if(p.length<8) return null;
  const mx=mean(p.map(v=>v[0])), my=mean(p.map(v=>v[1]));
  let n=0,dx=0,dy=0; p.forEach(([x,y])=>{n+=(x-mx)*(y-my); dx+=(x-mx)**2; dy+=(y-my)**2;});
  if(!dx||!dy) return null;
  return {r:n/Math.sqrt(dx*dy), n:p.length};
}
const ICON = {
  dumbbell:'<path d="M6.5 6.5v11M3 9v6M17.5 6.5v11M21 9v6M6.5 12h11"/>',
  tennis:'<circle cx="12" cy="12" r="9"/><path d="M5 5c4.5 4 4.5 10 0 14M19 5c-4.5 4-4.5 10 0 14"/>',
  chart:'<path d="M3 20h18"/><path d="M6 20v-6M11 20V7M16 20v-9M21 20v-4"/>',
  pulse:'<path d="M3 12h4l2.5-7 4 14L16 12h5"/>',
  gear:'<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.6 1.6 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.6 1.6 0 00-1.8-.3 1.6 1.6 0 00-1 1.5V21a2 2 0 11-4 0v-.1A1.6 1.6 0 008 19.4a1.6 1.6 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.6 1.6 0 00.3-1.8 1.6 1.6 0 00-1.5-1H2a2 2 0 110-4h.1A1.6 1.6 0 003.6 8a1.6 1.6 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.6 1.6 0 001.8.3H8a1.6 1.6 0 001-1.5V2a2 2 0 114 0v.1a1.6 1.6 0 001 1.5 1.6 1.6 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.6 1.6 0 00-.3 1.8V8a1.6 1.6 0 001.5 1H22a2 2 0 110 4h-.1a1.6 1.6 0 00-1.5 1z"/>',
  chev:'<path d="M9 18l6-6-6-6"/>', down:'<path d="M6 9l6 6 6-6"/>',
  left:'<path d="M15 18l-6-6 6-6"/>',
  check:'<path d="M20 6L9 17l-5-5"/>', x:'<path d="M18 6L6 18M6 6l12 12"/>',
  plus:'<path d="M12 5v14M5 12h14"/>', undo:'<path d="M3 7v6h6"/><path d="M3.5 13a9 9 0 102.1-7"/>',
  edit:'<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"/>',
  copy:'<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>',
  trash:'<path d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2M19 6l-1 14a1 1 0 01-1 1H7a1 1 0 01-1-1L5 6"/>',
  play:'<path d="M6 4l14 8-14 8z"/>', up:'<path d="M18 15l-6-6-6 6"/>',
  /* pause, which the set had no glyph for - so the control that stops a
     workout was wearing the stopwatch that means a rest timer */
  pause:'<path d="M9 5v14M15 5v14"/>',
  dl:'<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>',
  ul:'<path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/>',
  flame:'<path d="M12 2s4 4.5 4 8a4 4 0 01-8 0c0-1 .5-2 .5-2S7 10 6 12a6 6 0 1012 0c0-5-6-10-6-10z"/>',
  moon:'<path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"/>',
  heart:'<path d="M20.8 4.6a5.5 5.5 0 00-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 10-7.8 7.8l8.8 8.8 8.8-8.8a5.5 5.5 0 000-7.8z"/>',
  timer:'<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9 2h6"/>',
  book:'<path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/>',
  run:'<circle cx="16" cy="4" r="2"/><path d="M12 21l1.5-6-3-2.5L9 17M10.5 12.5L8 8l4-1.5 3 2.5 3 1"/>',
  bike:'<circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 6a1 1 0 100-2 1 1 0 000 2zM12 17.5L9 9l4-1 2.5 3.5H18"/>',
  target:'<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/>',
  ruler:'<path d="M3.5 9.5h17a1 1 0 011 1v3a1 1 0 01-1 1h-17a1 1 0 01-1-1v-3a1 1 0 011-1z"/><path d="M7 9.5v2M11 9.5v3M15 9.5v2M19 9.5v3"/>',
  info:'<circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/>',
  /* a coaching cue — the one thing a coach would say out loud */
  bulb:'<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9V16h7v-2.1A6 6 0 0 0 12 3z"/>',
  /* you, on the home screen and on the profile row */
  user:'<circle cx="12" cy="8" r="3.6"/><path d="M4.5 20a7.5 7.5 0 0 1 15 0"/>',
  /* what you did, rather than what a device measured about it */
  shoe:'<path d="M2 16.5h14.5a4.5 4.5 0 0 0 4.3-3.2l.2-.8-6.5-2-2-2.5H8l-1 3H4a2 2 0 0 0-2 2z"/><path d="M2 20h19"/>',
  /* swapping today’s plan for another */
  swap:'<path d="M4 8h13l-3-3M20 16H7l3 3"/>',
  /* a section that leads somewhere bigger */
  layers:'<path d="M12 3 3 8l9 5 9-5z"/><path d="M3 13l9 5 9-5"/>',
  /* the settings index, one mark per row so the list scans by shape */
  home:'<path d="M3.5 10.5 12 3.5l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/>',
  checkc:'<circle cx="12" cy="12" r="9"/><path d="M8 12.2l2.6 2.6L16 9.4"/>',
  sliders:'<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>',
  cal:'<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8.5 3v4M15.5 3v4"/>',
  db:'<ellipse cx="12" cy="6" rx="7.5" ry="3"/><path d="M4.5 6v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3V6"/><path d="M4.5 12v6c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3v-6"/>',
  shield:'<path d="M12 3l7.5 3v5.5c0 4.6-3.1 8-7.5 9.5-4.4-1.5-7.5-4.9-7.5-9.5V6z"/>',
  sun:'<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4"/>',
  sliders2:'<path d="M5 4v6M5 14v6M12 4v9M12 17v3M19 4v3M19 11v9"/><circle cx="5" cy="12" r="2"/><circle cx="12" cy="15" r="2"/><circle cx="19" cy="9" r="2"/>',
  help:'<circle cx="12" cy="12" r="9"/><path d="M9.6 9.3a2.5 2.5 0 1 1 3.4 2.3c-.6.3-1 .9-1 1.6v.3M12 17h.01"/>',
  /* the open readiness ring — the app's own mark, and sport-neutral */
  ring:'<path d="M12 3.5a8.5 8.5 0 1 1-8.5 8.5"/>',
  /* device types — enough to tell a ring from a band from a watch */
  watch:'<rect x="6.5" y="6.5" width="11" height="11" rx="3.4"/><path d="M9.5 6.5V3.5h5v3M9.5 17.5v3h5v-3"/>',
  band:'<rect x="3" y="9" width="18" height="6" rx="3"/><path d="M8.5 9v6M15.5 9v6"/>',
  ringfull:'<circle cx="12" cy="12" r="6.6"/>',
  /* equipment */
  eband:'<path d="M4 12c2.6-5.2 13.4-5.2 16 0-2.6 5.2-13.4 5.2-16 0z"/>',
  bench:'<path d="M3 10.5h18v3H3zM6.5 13.5V19M17.5 13.5V19"/>',
  pullbar:'<path d="M3 5.5h18M8 5.5v4M16 5.5v4M12 9.5v3"/>',
  kettle:'<path d="M9.2 7.4a3 3 0 015.6 0"/><path d="M7 9.4h10a6 6 0 11-10 0z"/>',
  medball:'<circle cx="12" cy="12" r="8"/><path d="M12 4v16M4 12h16"/>',
  barbell:'<path d="M2 12h20M5 8v8M19 8v8M8.5 9.5v5M15.5 9.5v5"/>',
  cable:'<path d="M5 4v6a7 7 0 0014 0V4"/><circle cx="12" cy="18.5" r="2.4"/>',
  /* ---- one glyph per activity ----------------------------------------
     A runner, a walker and a hiker drawn with the same silhouette does not
     read as a tidy icon set; it reads as an app that cannot tell them apart.
     The same went for the flame, which stood in for seven different sports.
     These are the drawings that were missing, so nothing has to double up. */
  walk:'<circle cx="12.5" cy="3.8" r="2"/><path d="M12.5 6.2v6.6"/><path d="M12.5 12.8L9.6 21M12.5 12.8l3.1 4.2.7 4"/><path d="M12.5 8.4L8.8 10.8M12.5 8.4l3.4 2.1"/>',
  hike:'<path d="M2.5 20.5h19"/><path d="M5.5 20.5 11 8.5l3.4 7 1.8-3 5.3 8z"/><path d="M11 8.5 12.8 5"/>',
  swim:'<circle cx="7" cy="7.5" r="2"/><path d="M10.2 10.6 14 8.2l4.5 3.4"/><path d="M2.5 16.4c1.6-1.3 3.2-1.3 4.8 0s3.2 1.3 4.8 0 3.2-1.3 4.8 0 3.2 1.3 4.6 0"/><path d="M2.5 20.4c1.6-1.3 3.2-1.3 4.8 0s3.2 1.3 4.8 0 3.2-1.3 4.8 0 3.2 1.3 4.6 0"/>',
  soccer:'<circle cx="12" cy="12" r="9"/><path d="M12 7.6l3.6 2.6-1.4 4.3H9.8L8.4 10.2z"/><path d="M12 3v4.6M20 9.4l-4.4 3.1M17.2 19.6l-2.6-3.4M6.8 19.6l2.6-3.4M4 9.4l4.4 3.1"/>',
  bball:'<circle cx="12" cy="6.2" r="3.6"/><path d="M3.4 12.8h17.2"/><path d="M6.4 12.8l1.5 6.8M17.6 12.8l-1.5 6.8M12 12.8v6.8"/><path d="M7.9 16.4h8.2"/>',
  vball:'<circle cx="12" cy="12" r="9"/><path d="M12 3c3.1 3.7 3.1 14.3 0 18"/><path d="M3.9 7.6c5.1 1 9.6 5.1 11.1 13"/><path d="M20.1 7.6c-5.1 1-9.6 5.1-11.1 13"/>',
  padel:'<rect x="5.6" y="2.6" width="12.8" height="12.4" rx="4.4"/><path d="M10.7 15.2 10.2 21.4h3.6l-.5-6.2"/><path d="M9.6 7.4h.01M14.4 7.4h.01M12 10.6h.01"/>',
  squash:'<ellipse cx="12" cy="7.8" rx="4.8" ry="5.8"/><path d="M7.4 7.8h9.2M12 2.2v11.4"/><path d="M12 13.6v7.8"/>',
  martial:'<path d="M5.5 9.2a4.6 4.6 0 0 1 4.6-4.6h2.4A5.5 5.5 0 0 1 18 10.1v3.6H5.5z"/><path d="M5.5 10.8h2.2a1.8 1.8 0 1 0 0-3.6"/><path d="M7.2 13.7v3.7a2 2 0 0 0 2 2h5.2a2 2 0 0 0 2-2v-3.7"/>',
  ski:'<circle cx="13.2" cy="4" r="1.9"/><path d="M13 6.4l-2.2 4.8 3.6 2.1-1.1 4.2"/><path d="M13.6 8.2l3.6 2.6"/><path d="M3 21.2 20.6 16.8"/>',
  golf:'<path d="M7 3v18"/><path d="M7 3.4l9.2 3.1L7 9.6z"/><circle cx="16.4" cy="19.6" r="1.6"/>',
