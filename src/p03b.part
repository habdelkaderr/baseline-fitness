
/* =========================================================================
   EQUIPMENT TIERS & MOVEMENT PATTERNS
   Every exercise is tagged with the movement pattern it trains and the
   minimum equipment tier it needs. The program structure stays identical for
   everyone — the app just picks the best exercise the user can actually do.
     tier 0  minimal : bodyweight, light dumbbells, a band, open space
     tier 1  home    : + bench/step, pull-up bar, adjustable dumbbells
     tier 2  gym     : + barbell, rack, cables, machines
   ====================================================================== */
const TIERS=[
  {id:0,name:'No gym',       short:'Minimal', desc:'Bodyweight and small home kit only.'},
  {id:1,name:'Home setup',   short:'Home',    desc:'A bench or sturdy step, a pull-up bar, adjustable dumbbells.'},
  {id:2,name:'Full gym',     short:'Gym',     desc:'Barbell, rack, cables and machines.'}
];

/* =========================================================================
   WHAT YOU ACTUALLY OWN
   Tiers are too coarse to prescribe from: "no gym" does not tell us whether
   you have dumbbells. Every exercise declares the items it needs, and you are
   only ever given exercises whose items you have ticked. Bodyweight and a
   floor are assumed; nothing else is.
   ====================================================================== */
/* `home` decides whether an item appears in the at-home list; `gym` whether a
   gym is assumed to have it. `kg` marks the three things worth a number: it is
   what lets the app step a load in 2 kg instead of guessing.

   No gym-machine ids were invented. "Leg press" and "lat pulldown" as separate
   toggles would look thorough and do nothing, because no exercise in the
   library asks for them - they are all gated by `cable`. The hints name the
   real machines each category covers instead. */
const EQUIP_ITEMS=[
  {id:'db',    name:'Dumbbells',          hint:'Any pair, fixed or adjustable', tier:0, icon:'dumbbell',
   home:true, gym:true, kg:'Heaviest pair'},
  {id:'band',  name:'Resistance band',    hint:'One loop or tube band',         tier:0, icon:'eband',
   home:true, gym:true},
  {id:'bench', name:'Bench, step or sturdy chair', hint:'Something stable to elevate a foot or lie on', tier:1, icon:'bench',
   home:true, gym:true},
  {id:'bar',   name:'Pull-up bar',        hint:'Doorway frame, wall-mounted, or a rack',  tier:1, icon:'pullbar',
   home:true, gym:true},
  {id:'kb',    name:'Kettlebell',         hint:'One or a set',                  tier:1, icon:'kettle',
   home:true, gym:true, kg:'Heaviest'},
  {id:'ball',  name:'Medicine ball',      hint:'Plus a wall you can throw at',  tier:1, icon:'medball',
   home:true, gym:true, kg:'Heaviest'},
  {id:'bb',    name:'Barbell and rack',   hint:'Olympic bar, plates, squat rack or Smith machine', tier:2, icon:'barbell',
   home:true, gym:true},
  {id:'cable', name:'Cables and machines',
   hint:'Cable stack, lat pulldown, seated row, leg press, leg curl — or a home multi-gym',
   tier:2, icon:'cable', home:true, gym:true},
  {id:'bike',  name:'Bicycle or stationary bike', hint:'Road bike, turbo, spin or air bike', tier:0, icon:'bike',
   home:true, gym:true},
  {id:'run',   name:'Somewhere to run',   hint:'Outdoors or a treadmill',       tier:0, icon:'run',
   home:true, gym:true}
];
/* What a gym is assumed to have until the user says otherwise. */
const GYM_GEAR = EQUIP_ITEMS.filter(x=>x.gym).map(x=>x.id);
const HOME_GEAR= EQUIP_ITEMS.filter(x=>x.home);
/* the three items a weight means something for */
const GEAR_KG  = EQUIP_ITEMS.filter(x=>x.kg).map(x=>x.id);

/* One weight per weighted item, kept beside the gear list. `dbKg` stays in
   step with the dumbbell figure because stepSize() and older saved profiles
   both read it. */
function gearKg(id){
  const P=(DB&&DB.profile)||{};
  const m=P.gearKg||{};
  if(m[id]!=null) return m[id];
  if(id==='db' && P.dbKg!=null) return P.dbKg;
  return null;
}
function setGearKg(id, v, prof){
  const P=prof||(DB&&DB.profile);
  if(!P) return;
  P.gearKg=P.gearKg||{};
  if(v==null || v==='' || isNaN(+v)) delete P.gearKg[id];
  else P.gearKg[id]=clamp(+v,1,300);
  if(id==='db') P.dbKg = P.gearKg[id]!=null ? P.gearKg[id] : null;
}

/* =========================================================================
   THE EQUIPMENT EDITOR
   One component, used by the setup wizard and by Settings, so the two cannot
   drift apart. `place` decides which way round the question is asked.
   ====================================================================== */
function gearEditorHTML(o){
  const gear=o.gear||[];
  const place=o.place||null;
  const open=!!o.open;

  if(!place) return `
    <div class="rows" id="${o.id}_place">
      <button data-p="home"><i class="rw-i">${svg('today')}</i>
        <span class="rw-x"><span class="rw-t">At home</span>
          <span class="rw-s">You pick what you have — nothing is assumed</span></span>
        <i class="rw-c">${svg('chev')}</i></button>
      <button data-p="gym"><i class="rw-i">${svg('barbell')}</i>
        <span class="rw-x"><span class="rw-t">At a gym</span>
          <span class="rw-s">Everything available — remove anything yours lacks</span></span>
        <i class="rw-c">${svg('chev')}</i></button>
    </div>`;

  const row=it=>{
    const on=gear.indexOf(it.id)>=0;
    const kg=gearKg(it.id);
    return `<div class="gwrap">
      <button class="gr${on?' on':''}" data-g="${it.id}" aria-pressed="${on?'true':'false'}">
        <i class="gr-i">${svg(it.icon)}</i>
        <span class="gr-x"><span class="gr-t">${esc(it.name)}</span>
          ${it.hint?`<span class="gr-s">${esc(it.hint)}</span>`:''}</span>
        <i class="gr-c">${on?svg('check'):svg('plus')}</i>
      </button>
      ${(on && it.kg)?`<div class="gr-w">
        <span class="gr-wl">${esc(it.kg)}</span>
        ${stepper(-1,'gkg',kg==null?'':kg,'—',null,it.name+' weight in kilograms')
            .replace('data-k="gkg"','data-k="gkg" data-gid="'+it.id+'"')}
        <span class="gr-wu">kg</span>
      </div>`:''}
    </div>`;
  };

  if(place==='gym') return `
    <div class="note acc"><b>Everything is available.</b> A commercial gym has
      the lot, so Baseline assumes it rather than making you tick fifteen boxes.</div>
    <button class="tert" id="${o.id}_more" aria-expanded="${open?'true':'false'}">
      ${open?'Hide the list':'Something missing from your gym?'} ${svg('down')}</button>
    ${open?`<div id="${o.id}_list">
      <div class="hint" style="margin:2px 0 10px">Tap anything your gym does not have.</div>
      ${EQUIP_ITEMS.filter(x=>x.gym).map(row).join('')}
    </div>`:''}
    <button class="tert" id="${o.id}_back">Train at home instead</button>`;

  return `
    <div class="hint" style="margin-bottom:10px">Tick what you actually have.
      Bodyweight and a floor are assumed.</div>
    ${HOME_GEAR.map(row).join('')}
    <button class="tert" id="${o.id}_back">Train at a gym instead</button>`;
}

/* `apply` receives {gear, place} and is responsible for storing and redrawing. */
function wireGearEditor(o){
  const id=o.id, apply=o.apply;
  $$('#'+id+'_place button').forEach(b=>b.onclick=()=>{
    haptic();
    const p=b.dataset.p;
    apply({place:p, gear: p==='gym' ? GYM_GEAR.slice() : []});
  });
  const more=$('#'+id+'_more');
  if(more) more.onclick=()=>{ haptic(); apply({openList:!o.open}); };
  const back=$('#'+id+'_back');
  if(back) back.onclick=()=>{ haptic(); apply({place:null, gear:[]}); };
  $$('#'+id+'_root .gr, #'+id+'_list .gr, .gwrap .gr').forEach(b=>b.onclick=()=>{
    haptic();
    const g=(o.gear||[]).slice();
    const i=g.indexOf(b.dataset.g);
    if(i>=0) g.splice(i,1); else g.push(b.dataset.g);
    apply({gear:g});
  });
  /* the weight steppers, which only exist for ticked weighted items */
  $$('.gr-w .stp').forEach(wrap=>{
    const inp=wrap.querySelector('input');
    if(!inp) return;
    const gid=inp.dataset.gid;
    const write=v=>{ apply({kg:{id:gid, v:v}}); };
    inp.addEventListener('input',()=>write(inp.value));
    wrap.querySelectorAll('button').forEach(b=>b.onclick=ev=>{
      ev.stopPropagation();
      const cur=parseFloat(inp.value)||0;
      let next=cur + (+b.dataset.d)*(gid==='db'?2:4);
      if(next<0) next=0;
      inp.value=String(next);
      write(inp.value);
    });
  });
}
const ALWAYS_HAVE=['bw','floor','wall','towel'];   // assumed for everyone

/* work out which items an exercise needs from its equipment description */
function deriveNeeds(e){
  const s=((e.equip||'')+' '+(e.name||'')).toLowerCase();
  const n=[];
  const add=x=>{ if(n.indexOf(x)<0) n.push(x); };
  if(/\bdb\b|dumbbell|goblet|suitcase|farmer/.test(s)) add('db');
  if(/band/.test(s)) add('band');
  if(/chair|bench|step|box|incline/.test(s)) add('bench');
  if(/pull-?up bar|hanging|\bhang\b/.test(s)) add('bar');
  if(/kettlebell/.test(s)) add('kb');
  if(/medicine ball|med ball/.test(s)) add('ball');
  if(/barbell|trap bar|\brack\b/.test(s)) add('bb');
  if(/cable|machine|leg press|pulldown/.test(s)) add('cable');
  if(/bike|bicycle|cycling|spin/.test(s)) add('bike');
  if(/\brun\b|running|open ground|sprint|treadmill|jog|hill/.test(s)) add('run');
  if(/anchor|partner/.test(s)) add('anchor');
  return n;
}
/* does the user own everything this exercise needs? */
function gearList(){
  const g=(DB&&DB.profile&&Array.isArray(DB.profile.gear))?DB.profile.gear:[];
  return g;
}
/* "dumbbells, a band and a bicycle" — written from what is actually ticked */
function gearNames(){
  const n=gearList().map(id=>(EQUIP_ITEMS.find(x=>x.id===id)||{name:id}).name.toLowerCase());
  if(!n.length) return 'bodyweight only';
  if(n.length===1) return 'bodyweight and '+n[0];
  return 'bodyweight, '+n.slice(0,-1).join(', ')+' and '+n[n.length-1];
}
function canDo(e){
  const needs=e.needs||[];
  if(!needs.length) return true;                 // bodyweight only
  const have=gearList();
  return needs.every(x=>{
    if(x==='anchor') return have.indexOf('bench')>=0 || have.indexOf('bb')>=0;  // something to hook under
    return have.indexOf(x)>=0;
  });
}
/* =========================================================================
   DATA SOURCES (WEARABLES)
   A device is described by the numbers it can actually give you. Everything
   downstream is driven by this table — what the morning check-in asks for,
   what the readiness score is allowed to use, what the metrics tab is called —
   so WHOOP is one row here, not a special case in the code.

   Field names are canonical: every device's "recovery score", "readiness
   score", "Body Battery" and "Energy Score" land in the same `recovery` slot,
   with `labels` giving each device its own wording. That is what lets the
   engine work identically whatever you wear.
   ====================================================================== */
const DATA_FIELDS={
  recovery :{name:'Recovery',        unit:'%',  lo:0,  hi:100, icon:'heart', hint:'A 0–100 daily readiness score'},
  hrv      :{name:'HRV',             unit:'ms', lo:5,  hi:250, icon:'pulse', hint:'Overnight heart-rate variability'},
  rhr      :{name:'Resting HR',      unit:'bpm',lo:25, hi:120, icon:'heart', hint:'Overnight resting heart rate'},
  sleep    :{name:'Sleep',           unit:'h',  lo:0,  hi:16,  icon:'moon', hint:'Time actually asleep'},
  sleepNeed:{name:'Sleep need',      unit:'h',  lo:4,  hi:14,  icon:'moon', hint:'What your device says you needed'},
  strain   :{name:'Strain / load',   unit:'',   lo:0,  hi:21,  icon:'flame', hint:"Yesterday's cardiovascular load"},
  resp     :{name:'Respiratory rate',unit:'rpm',lo:6,  hi:30, icon:'pulse'},
  spo2     :{name:'Blood oxygen',    unit:'%',  lo:70, hi:100, icon:'drop'},
  temp     :{name:'Skin temp change',unit:'°C', lo:-5, hi:5, icon:'thermo'},
  steps    :{name:'Steps',           unit:'',   lo:0,  hi:80000, icon:'run'}
};
/* `importer`: 'whoop' = the built-in CSV parser for WHOOP's export format;
   'csv' = the generic column-mapping importer; null = type it in each day. */
const SOURCES=[
  {id:'whoop', name:'WHOOP', kind:'band', tint:'#D8232A', importer:'whoop',
   fields:['recovery','hrv','rhr','sleep','sleepNeed','strain','resp','spo2','temp'],
   how:'WHOOP app → More → Data Export. You are emailed a ZIP of CSV files; import physiological_cycles.csv and workouts.csv here.'},
  {id:'garmin', name:'Garmin', kind:'watch', tint:'#007CC3', importer:'csv',
   fields:['recovery','hrv','rhr','sleep','strain','steps'],
   labels:{recovery:'Body Battery / Training Readiness', strain:'Training Load'},
   how:'Garmin Connect on the web → Reports → export CSV. Or just type the numbers in each morning.'},
  {id:'oura', name:'Oura Ring', kind:'ringfull', tint:'#6E5BD9', importer:'csv',
   fields:['recovery','hrv','rhr','sleep','temp'],
   labels:{recovery:'Readiness Score', temp:'Temperature deviation'},
   how:'Oura web dashboard → Account → Export Data. Or type the numbers in each morning.'},
  {id:'fitbit', name:'Fitbit', kind:'band', tint:'#00B0B9', importer:'csv',
   fields:['recovery','hrv','rhr','sleep','spo2','steps'],
   labels:{recovery:'Daily Readiness Score'},
   how:'Google Takeout → Fitbit. Or type the numbers in each morning.'},
  {id:'apple', name:'Apple Watch', kind:'watch', tint:'#7D7D82', importer:'csv',
   fields:['hrv','rhr','sleep','spo2','steps'],
   how:'Health app → your profile → Export All Health Data. Apple gives no recovery score, so readiness is built from HRV, resting HR and sleep instead — which is what the score is made of anyway.'},
  {id:'samsung', name:'Samsung Galaxy Watch', kind:'watch', tint:'#1428A0', importer:'csv',
   fields:['recovery','hrv','rhr','sleep','steps'],
   labels:{recovery:'Energy Score'},
   how:'Samsung Health → Settings → Download personal data.'},
  {id:'polar', name:'Polar', kind:'watch', tint:'#E4002B', importer:'csv',
   fields:['recovery','hrv','rhr','sleep','strain'],
   labels:{recovery:'Nightly Recharge', strain:'Cardio Load'},
   how:'Polar Flow → Settings → Export your data.'},
  {id:'coros', name:'COROS', kind:'watch', tint:'#F05A28', importer:'csv',
   fields:['hrv','rhr','sleep','strain'],
   labels:{strain:'Training Load'},
   how:'COROS web → Profile → Data export.'},
  {id:'other', name:'Another wearable', kind:'watch', tint:'var(--text-3)', importer:'csv', pickFields:true,
   fields:['recovery','hrv','rhr','sleep','sleepNeed','strain','resp','spo2','temp','steps'],
   how:'Tick the numbers your device actually shows you. Anything you do not tick is never asked for and never assumed.'},
  {id:'none', name:'No wearable', kind:null, tint:'var(--text-3)', importer:null, fields:[],
   how:'Everything runs from what you log plus a short daily check-in: energy, soreness, stress, motivation and sleep. That is enough for the engine to work.'}
];
/* the device's mark: its type glyph in its own brand colour. Not a logo. */
function srcMark(id,px){
  const s=sourceOf(id); if(!s.kind) return '';
  return `<i class="srcmark" style="color:${s.tint||'var(--text-3)'};${px?`--sz:${px}px`:''}">${svg(s.kind)}</i>`;
}
const sourceOf = id => SOURCES.find(s=>s.id===(id!=null?id:(DB&&DB.profile&&DB.profile.source)))||SOURCES[SOURCES.length-1];
/* the fields actually in play: what the device offers, narrowed to what the
   user confirmed if they picked their own */
function srcFields(id){
  const s=sourceOf(id);
  const chosen=(DB&&DB.profile&&Array.isArray(DB.profile.sourceFields))?DB.profile.sourceFields:null;
  if(s.pickFields&&chosen) return s.fields.filter(f=>chosen.indexOf(f)>=0);
  return s.fields.slice();
}
const hasField  = f => srcFields().indexOf(f)>=0;
const fieldLabel= (f,id)=> (sourceOf(id).labels||{})[f] || (DATA_FIELDS[f]||{name:f}).name;
const fieldUnit = f => (DATA_FIELDS[f]||{}).unit||'';
const SRC_NAME  = ()=> sourceOf().name;
const usesDevice= ()=> srcFields().length>0;
/* the label on the last step of the wizard */
function finishLabel(d){
  const s=sourceOf(d&&d.source);
  return s.importer ? `Finish & import ${s.name}` : 'Finish setup';
}

/* =========================================================================
   SPORT PROFILES
   Everything sport-specific is derived from here, so choosing football or
   swimming reshapes the warm-ups, weekly targets and priorities exactly the
   way tennis does. Nothing about tennis is special in the code.
   ====================================================================== */
const SPORT_PROFILES={
  tennis:    {act:['tennis','padel','squash'], explosive:true, impact:'high', overhead:true,
              prep:['lateral','rotation','shoulder','reactive'],
              focus:['jump','lateral','accel','decel','cod','sleg','core','shoulder','protect','cond'],
              qualities:'lateral movement, rotational power and repeated change of direction'},
  padel:     {act:['padel','tennis','squash'], explosive:true, impact:'high', overhead:true,
              prep:['lateral','rotation','shoulder','reactive'],
              focus:['lateral','accel','decel','cod','sleg','core','shoulder','protect','cond'],
              qualities:'lateral movement, rotation and quick reactions'},
  racquet:   {act:['tennis','padel','squash'], explosive:true, impact:'high', overhead:true,
              prep:['lateral','rotation','shoulder','reactive'],
              focus:['jump','lateral','accel','decel','cod','sleg','core','shoulder','protect','cond'],
              qualities:'lateral movement, rotational power and shoulder durability'},
  football:  {act:['football'], explosive:true, impact:'high', overhead:false,
              prep:['sprint','lateral','hamstring','reactive'],
              focus:['accel','decel','cod','sleg','core','protect','calf','cond'],
              qualities:'repeated sprinting, acceleration and hamstring resilience'},
  basketball:{act:['basketball'], explosive:true, impact:'high', overhead:true,
              prep:['jump','lateral','landing','reactive'],
              focus:['jump','landing','lateral','accel','decel','cod','sleg','core','shoulder','cond'],
              qualities:'jump power, landing mechanics and lateral movement'},
  running:   {act:['running'], explosive:false, impact:'high', overhead:false,
              prep:['sprint','hamstring','calf'],
              focus:['sleg','protect','calf','core','aerobic','mob'],
              qualities:'aerobic base, running economy and tendon resilience'},
  cycling:   {act:['cycling'], explosive:false, impact:'low', overhead:false,
              prep:['hip','calf'],
              focus:['legend','sleg','core','aerobic','mob'],
              qualities:'aerobic base and leg strength endurance'},
  squash:    {act:['squash','tennis','padel'], explosive:true, impact:'high', overhead:true,
              prep:['lateral','rotation','shoulder','reactive'],
              focus:['lateral','accel','decel','cod','sleg','core','shoulder','protect','cond'],
              qualities:'repeated lunging, rotation and fast direction changes'},
  volleyball:{act:['volleyball','basketball'], explosive:true, impact:'high', overhead:true,
              prep:['jump','landing','shoulder','lateral'],
              focus:['jump','landing','lateral','sleg','core','shoulder','protect','cond'],
              qualities:'jump height, landing control and overhead power'},
  martial:   {act:['martial'], explosive:true, impact:'high', overhead:false,
              prep:['rotation','hip','reactive','lateral'],
              focus:['accel','decel','cod','core','sleg','protect','cond'],
              qualities:'rotational power, repeated efforts and change of direction'},
  swimming:  {act:['swimming'], explosive:false, impact:'low', overhead:true,
              prep:['shoulder','rotation'],
              focus:['shoulder','core','protect','aerobic','mob'],
              qualities:'shoulder durability, trunk control and aerobic capacity'},
  triathlon: {act:['running','cycling','swimming'], explosive:false, impact:'mixed', overhead:false,
              prep:['hip','calf','hamstring'],
              focus:['sleg','calf','core','aerobic','mob','protect'],
              qualities:'aerobic base across three disciplines and tendon resilience'},
  rowing:    {act:['rowing'], explosive:false, impact:'low', overhead:false,
              prep:['hip','hamstring','shoulder'],
              focus:['sleg','core','protect','aerobic','mob'],
              qualities:'hip hinge strength, trunk endurance and aerobic capacity'},
  climbing:  {act:['climbing'], explosive:false, impact:'low', overhead:true,
              prep:['shoulder','hip'],
              focus:['shoulder','core','protect','sleg','mob'],
              qualities:'pulling strength, shoulder stability and body tension'},
  skiing:    {act:['skiing'], explosive:true, impact:'high', overhead:false,
              prep:['lateral','hip','landing'],
              focus:['sleg','lateral','decel','landing','core','calf','protect','cond'],
              qualities:'eccentric leg strength, lateral control and sustained effort'},
  hiking:    {act:['hiking','walking'], explosive:false, impact:'mixed', overhead:false,
              prep:['hip','calf'],
              focus:['sleg','calf','core','aerobic','mob'],
              qualities:'leg endurance, ankle resilience and aerobic capacity'},
  golf:      {act:['golf'], explosive:true, impact:'low', overhead:false,
              prep:['rotation','shoulder','hip'],
              focus:['core','shoulder','sleg','mob','protect'],
              qualities:'rotational speed, hip mobility and trunk control'},
  gym:       {act:['strength'], explosive:false, impact:'low', overhead:true,
              prep:['hip','shoulder'],
              focus:['sleg','core','shoulder','protect','mob'],
              qualities:'balanced strength and movement quality'},
  general:   {act:[], explosive:false, impact:'mixed', overhead:false,
              prep:['hip','shoulder'],
              focus:['sleg','core','aerobic','mob'],
              qualities:'balanced strength, conditioning and movement quality'}
};
/* -------------------------------------------------------------------------
   RAW vs WORKING values.

   Nothing in this app assumes a sport, a goal, a training frequency or a
   session length. The RAW value is what the user actually chose, and [] or
   null are legitimate answers that the interface renders as "None".

   The WORKING value is what the recommendation engine needs in order to
   produce a session at all, and it falls back to a documented neutral
   default rather than to a preference the user never expressed.

   So: hasSport() asks what the user said. sportsOf() asks what to train.
   Never use a working accessor to decide what to *display* about the user.
   --------------------------------------------------------------------- */
const P_ = ()=> (DB&&DB.profile)||{};
const rawSports = ()=> Array.isArray(P_().sports) ? P_().sports : [];
const hasSport  = ()=> rawSports().length>0;
const sportsOf  = ()=> hasSport() ? rawSports() : ['general'];
const rawGoals  = ()=> Array.isArray(P_().physiques) ? P_().physiques : [];
const hasGoal   = ()=> rawGoals().length>0;
const goalsOf   = ()=> hasGoal() ? rawGoals() : ['athletic'];
/* frequency and duration are the two things the engine cannot work without,
   so they keep the old defaults as WORKING values while the stored value
   stays null until the user answers. DEFAULT_* exists so the number appears
   once rather than as a literal scattered across the file. */
const DEFAULT_DAYS = 4, DEFAULT_SESSION_MIN = 50;
const rawDays  = ()=> P_().daysPerWeek==null ? null : +P_().daysPerWeek;
const hasDays  = ()=> rawDays()!=null;
const trainDays= ()=> hasDays() ? rawDays() : DEFAULT_DAYS;
const rawMin   = ()=> P_().sessionMin==null ? null : +P_().sessionMin;
const hasMin   = ()=> rawMin()!=null;
const sessMin  = ()=> hasMin() ? rawMin() : DEFAULT_SESSION_MIN;
const rawGear  = ()=> Array.isArray(P_().gear) ? P_().gear : [];
const hasGear  = ()=> rawGear().length>0;
const mainSport  = ()=> sportsOf()[0];
const sportProf  = id => SPORT_PROFILES[id||mainSport()]||SPORT_PROFILES.general;
const SPORT_LABEL= ()=> (SPORTS.find(s=>s.id===mainSport())||{name:'Your sport'}).name;
/* activity types that count as "your sport" for the engine's guards */
function mainSportActs(){
  /* No sport chosen means no activity is "your sport". The old fallback here
     was a hardcoded racquet/ball list, which made the engine guard against
     tennis for someone who had never said they play it. */
  if(!hasSport()) return [];
  const set=[];
  sportsOf().forEach(id=>(sportProf(id).act||[]).forEach(a=>{ if(set.indexOf(a)<0) set.push(a); }));
  return set;
}
const isMainSportAct = t => mainSportActs().indexOf(t)>=0;
/* does any chosen sport have this property? */
const anySport = f => sportsOf().some(id=>f(sportProf(id)));
/* -------------------------------------------------------------------------
   Derived prose. Every sentence the UI would otherwise hardcode is built
   here from the sports the user actually chose, so nothing in the interface
   claims to know something the setup did not tell it.
   --------------------------------------------------------------------- */
const sportLC    = ()=> SPORT_LABEL().toLowerCase();
/* SPORT_EMOJI is gone: the app has no emoji. Where a single cell has to
   stand for "you played your sport", the week strip uses the activity's
   three-letter short label instead. */
/* target keys in the order they should be shown, filtered to what exists */
const TARGET_ORDER=['lower','upper','power','core','run','bike','mobility'];
const TARGET_BAR={lower:'a',upper:'c',power:'o',core:'v',run:'g',bike:'c',mobility:'g'};
/* slider bounds for the target editor */
const TARGET_MAX={lower:5,upper:5,power:3,core:6,run:5,bike:6,mobility:7};
function targetKeys(){
  const T=(DB&&DB.targets)||{};
  const inOrder=TARGET_ORDER.filter(k=>T[k]>0);
  Object.keys(T).forEach(k=>{ if(T[k]>0&&inOrder.indexOf(k)<0) inOrder.push(k); });
  return inOrder;
}
/* "tennis", or "tennis and football", or "tennis, football and swimming" */
function sportsText(){
  const n=sportsOf().map(id=>(SPORTS.find(s=>s.id===id)||{name:id}).name.toLowerCase());
  if(n.length<=1) return n[0]||'your sport';
  return n.slice(0,-1).join(', ')+' and '+n[n.length-1];
}
/* picking "no specific sport" is a real answer; picking nothing is not */
const hasSportChosen = ()=> rawSports().some(id=>id!=='general');
/* why a given training system matters, phrased for the chosen sport */
function sysGoalText(sys){
  const p=sportProf(), sp=sportLC(), q=p.qualities;
  const gen=!hasSportChosen();
  switch(sys){
    case 'lower':  return gen ? 'Lower-body strength is the base everything else is built on.'
      : `Leg strength sits directly under ${sp} — it underpins every push-off, first step and landing.`;
    case 'expl':   return gen ? 'Explosive work keeps you fast and springy rather than only strong.'
      : `Builds the explosive qualities ${sp} runs on: ${q}.`;
    case 'core':   return gen ? 'Core strength transfers force between your legs and upper body.'
      : `Core strength transfers leg drive into the rest of the body and stabilises ${sp} positions.`;
    case 'upper':  return (anySport(x=>x.overhead)
      ? 'Keeps the overhead shoulder durable and '
      : 'Balances the strength work and ')+'drives the physique side of your goals.';
    case 'run':    return gen ? 'Builds the aerobic base that makes everything else easier.'
      : `Aerobic base so your level holds late in ${sp}.`;
    case 'bike':   return 'Aerobic fitness with almost no impact cost — the right call when legs are loaded but you are recovered.';
    case 'mobility':return 'Protects the hard days. Movement quality without adding fatigue.';
    default: return '';
  }
}
/* the decision priority list, ordered by what this user said they want */
function priorityList(){
  const goals=rawGoals();
  const L=['Safety and recovery'];
  if(hasSportChosen()) L.push(SPORT_LABEL()+' performance');
  L.push('Leg strength','Core strength');
  if(anySport(x=>x.explosive)) L.push('Explosive power');
  L.push('Appropriate conditioning');
  L.push(goals.indexOf('muscle')>=0 ? 'Upper body / muscle' : 'Upper body / physique');
  L.push('Weekly completion');
  return L;
}

/* =========================================================================
   SPORT-SPECIFIC WARM-UP
   Assembled from the prep qualities the chosen sport actually needs, rather
   than a fixed tennis routine. A footballer gets sprint and hamstring prep;
   a swimmer gets shoulders; a cyclist gets hips.
   ====================================================================== */
const PREP_BLOCKS={
  lateral:   [{n:'Lateral shuffle + crossover',d:'2 × 10 m each way'},
              {n:'90/90 hip switch',d:'8 each side'}],
  rotation:  [{n:'Thoracic rotation (open book)',d:'8 each side'},
              {n:'Shadow swings / rotational throws',d:'10 building to 80%'}],
  shoulder:  [{n:'Band pull-apart',d:'20'},
              {n:'Band face pull',d:'15'},
              {n:'Shoulder CARs',d:'3 each side, slow'}],
  reactive:  [{n:'Split step + first step',d:'6 reactions'},
              {n:'Build-up sprints',d:'3 × 10 m'}],
  sprint:    [{n:'A-skips',d:'2 × 15 m'},
              {n:'High knees',d:'2 × 15 m'},
              {n:'Build-up runs',d:'3 × 20 m at 60/75/85%'}],
  hamstring: [{n:'Leg swings front/back',d:'12 each leg'},
              {n:'Single-leg RDL (bodyweight)',d:'8 each side, slow'}],
  jump:      [{n:'Pogo hops',d:'2 × 20'},
              {n:'Countermovement jumps',d:'3 sub-maximal'}],
  landing:   [{n:'Drop and stick',d:'4 reps, silent landings'}],
  calf:      [{n:'Calf raises',d:'15 slow'},
              {n:'Ankle dorsiflexion rock',d:'10 each side'}],
  hip:       [{n:'Hip circles + leg swings',d:'10 each'},
              {n:"World's greatest stretch",d:'4 each side'}]
};
/* =========================================================================
   WHAT EACH SPORT NEEDS FROM THE PROGRAM
   The Activity tab shows "how your training serves your sport". The rows are
   assembled from these blocks according to the chosen sport, so a footballer
   sees sprinting and hamstrings where a basketballer sees jumping and landing.
   ====================================================================== */
const FOCUS_BLOCKS={
  jump:    ['Jump power','Countermovement Jump, Squat Jump, Single-Leg Calf Raise','w_power'],
  lateral: ['Lateral movement','Lateral Bound, Lateral Lunge, Cossack Squat, Lateral Shuffle','w_power'],
  accel:   ['Acceleration','Acceleration Sprints, Crossover Step Start, Split-Step Reaction','w_power'],
  decel:   ['Deceleration','Deceleration Drill, Depth Drop & Stick, Tibialis Raise','w_power'],
  cod:     ['Change of direction','5-10-5 Pro Agility, Spider Drill','w_power'],
  landing: ['Landing mechanics','Depth Drop & Stick, Skater Squat','w_power'],
  sleg:    ['Single-leg strength','Bulgarian Split Squat, Skater Squat, Single-Leg RDL','w_lowerA'],
  core:    ['Core force transfer','Pallof Press, Band Rotational Press, Suitcase Carry','w_core'],
  shoulder:['Shoulder durability','Band Face Pull, Pull-Apart, Prone Y-T-W','w_upperB'],
  protect: ['Groin & hamstring protection','Copenhagen Plank, Nordic Curl, Single-Leg RDL','w_lowerB'],
  calf:    ['Calf & tendon resilience','Single-Leg Calf Raise, Tibialis Raise, Pogo Hops','w_lowerB'],
  legend:  ['Leg strength endurance','Goblet Squat, Step-Up, Wall Sit','w_lowerA'],
  cond:    ['Conditioning','Interval running (20s/40s), Zone 2','w_runInt'],
  aerobic: ['Aerobic base','Zone 2 runs and rides','w_runEasy'],
  mob:     ['Movement quality','Mobility & recovery session','w_recovery']
};
function sportFocus(){
  const seen=[], out=[];
  sportsOf().forEach(id=>((SPORT_PROFILES[id]||{}).focus||[]).forEach(k=>{
    if(FOCUS_BLOCKS[k]&&seen.indexOf(k)<0){ seen.push(k); out.push(FOCUS_BLOCKS[k]); }
  }));
  if(!out.length) ['sleg','core','aerobic','mob'].forEach(k=>out.push(FOCUS_BLOCKS[k]));
  return out;
}
function sportWarmup(id){
  const p=sportProf(id), s=SPORTS.find(x=>x.id===(id||mainSport()));
  const items=[{n:'Easy jog, spin or brisk walk',d:'3 min — raise temperature'}];
  (p.prep||[]).forEach(k=>(PREP_BLOCKS[k]||[]).forEach(it=>{
    if(!items.some(x=>x.n===it.n)) items.push(it);
  }));
  return {name:`Pre-${(s&&s.name.split(' ')[0].toLowerCase())||'session'} prep`,
          dur:Math.max(6,Math.min(12,3+items.length)), items};
}

/* =========================================================================
   IS THE ADVICE ANY GOOD?
   The engine scores options with hand-tuned weights and explains itself well,
   which is not the same as being right. This compares days you followed the
   recommendation against days you did not, using whatever outcome measure you
   actually have — next-morning recovery if you wear something, next-morning
   energy if you do not. It reports nothing until there is enough of both to
   compare, and it never claims cause.
   ====================================================================== */
function whatHappened(date){
  const sess=(DB.sessions||[]).filter(s=>s.done && s.date===date);
  const acts=(DB.activities||[]).filter(a=>a.date===date);
  if(!sess.length && !acts.length) return {kind:'nothing', cats:[]};
  const cats=sess.map(s=>s.category||catOfWorkout(DB.workouts.find(w=>w.id===s.workoutId)))
    .concat(acts.map(a=>ACT_CAT(a.type)));
  return {kind:'trained', cats, sessions:sess, activities:acts};
}
/* did the day match what was advised? */
function followedAdvice(date){
  const dec=(DB.decisions||{})[date];
  if(!dec) return null;
  const did=whatHappened(date);
  if(dec.id==='rest') return {followed: did.kind==='nothing', advised:dec.id, did};
  if(dec.id==='mobility') return {followed: did.cats.indexOf('mobility')>=0, advised:dec.id, did};
  /* the candidate ids map onto session categories */
  const want={lower:'lower',upper:'upper',power:'power',core:'core',bike:'bike',
              run_e:'run',run_q:'run',run_int:'run'}[dec.id]||dec.id;
  return {followed: did.cats.indexOf(want)>=0, advised:dec.id, did};
}
/* the best outcome measure this user actually has for the morning after */
function outcomeFor(date){
  const next=addDays(date,1);
  const cy=cycleByDate(next);
  if(cy && cy.recovery!=null) return {v:cy.recovery, unit:'%', label:'next-day recovery'};
  const ci=(DB.checkins||{})[next];
  if(ci && ci.energy!=null) return {v:ci.energy*10, unit:'/100', label:'next-day energy'};
  return null;
}
function adviceReview(){
  const dec=DB.decisions||{};
  const kept=[], ignored=[];
  let restKept=[], restIgnored=[], nFollowed=0, nTotal=0;
  Object.keys(dec).forEach(d=>{
    const f=followedAdvice(d); if(!f) return;
    /* adherence needs no outcome measure — it is simply whether you did the
       thing. Only the comparison below needs a morning-after number. */
    nTotal++; if(f.followed) nFollowed++;
    const o=outcomeFor(d); if(!o) return;
    (f.followed?kept:ignored).push({date:d, v:o.v, advised:f.advised, label:o.label});
    if(f.advised==='rest'||f.advised==='mobility') (f.followed?restKept:restIgnored).push(o.v);
  });
  const MIN=5;                       // below this, any difference is noise
  const label=(kept[0]||ignored[0]||{}).label||'next-day recovery';
  const out={n:nTotal, nOutcome:kept.length+ignored.length,
             nKept:kept.length, nIgnored:ignored.length,
             min:MIN, label, ready:false};
  if(kept.length>=MIN && ignored.length>=MIN){
    out.ready=true;
    out.keptAvg=mean(kept.map(x=>x.v));
    out.ignoredAvg=mean(ignored.map(x=>x.v));
    out.diff=rnd(out.keptAvg-out.ignoredAvg,1);
  }
  if(restKept.length>=MIN && restIgnored.length>=MIN){
    out.restReady=true;
    out.restKeptAvg=mean(restKept);
    out.restIgnoredAvg=mean(restIgnored);
    out.restDiff=rnd(out.restKeptAvg-out.restIgnoredAvg,1);
  }
  /* plain adherence is worth knowing on its own, long before the outcome is */
  out.adherence = nTotal ? Math.round(nFollowed/nTotal*100) : null;
  return out;
}

/* =========================================================================
   INJURIES & LIMITATIONS
   A sore knee is not a one-morning event. Pain in the daily check-in blocks
   today and nothing more, which meant the only way to represent "my left knee
   has been bad for a fortnight" was to re-report pain every day and accept a
   blanket block. A limitation instead names a body area and an end date, and
   the movement patterns that load it are avoided until it expires.

   `avoid` is the list of movement patterns to drop entirely.
   `caution` is patterns kept but capped, because total avoidance deconditions.
   ====================================================================== */
const BODY_AREAS=[
  {id:'knee',     name:'Knee',              avoid:['jump','bound','land','sprint','cod','slsquat'],
   caution:['squat','lunge'],  sys:['expl'],  hint:'Jumping, cutting and deep single-leg work'},
  {id:'ankle',    name:'Ankle / foot',      avoid:['jump','bound','land','sprint','cod','calf'],
   caution:['lunge','slsquat'],sys:['expl','run'], hint:'Impact, push-off and calf work'},
  {id:'hamstring',name:'Hamstring',         avoid:['sprint','hamcurl','bound'],
   caution:['hinge','lunge'],  sys:['expl','run'], hint:'Sprinting and lengthened hip-hinge work'},
  {id:'groin',    name:'Groin / adductor',  avoid:['adduct','bound','cod'],
   caution:['lunge','squat'],  sys:['expl'],  hint:'Lateral work and wide stances'},
  {id:'hip',      name:'Hip',               avoid:['bound','cod'],
   caution:['hinge','squat','lunge'], sys:['expl'], hint:'Deep flexion and rotation'},
  {id:'calf',     name:'Calf / Achilles',   avoid:['jump','bound','sprint','calf','land'],
   caution:['cod'],            sys:['expl','run'], hint:'Anything springy or fast'},
  {id:'back',     name:'Lower back',        avoid:['hinge','rotate'],
   caution:['squat','antiext','antilat'], sys:[], hint:'Loaded hinging and rotation'},
  {id:'shoulder', name:'Shoulder',          avoid:['pushv','latraise'],
   caution:['pushh','pullv','pullh'], sys:[], hint:'Overhead pressing and raises'},
  {id:'elbow',    name:'Elbow / wrist',     avoid:['biceps','triceps'],
   caution:['pushh','pullh','pullv'], sys:[], hint:'Direct arm work and heavy gripping'},
  {id:'neck',     name:'Neck',              avoid:['pushv'],
   caution:['pullv','antiext'],sys:[], hint:'Overhead loading'}
];
const areaOf = id => BODY_AREAS.find(a=>a.id===id)||null;
/* limitations that have not expired, as of a given date */
function activeLimits(date){
  const d=date||todayISO();
  return ((DB&&DB.profile&&DB.profile.limits)||[]).filter(l=>l&&l.area&&(!l.until||l.until>=d));
}
const hasLimits = date => activeLimits(date).length>0;
/* movement patterns to drop, and those to keep but cap */
function limitPatterns(date){
  const avoid=[], caution=[];
  activeLimits(date).forEach(l=>{
    const a=areaOf(l.area); if(!a) return;
    /* a limitation logged as severe removes the cautioned patterns too */
    (a.avoid||[]).forEach(p=>{ if(avoid.indexOf(p)<0) avoid.push(p); });
    (a.caution||[]).forEach(p=>{
      if(l.severity==='high'){ if(avoid.indexOf(p)<0) avoid.push(p); }
      else if(caution.indexOf(p)<0) caution.push(p);
    });
  });
  return {avoid, caution:caution.filter(p=>avoid.indexOf(p)<0)};
}
/* training systems the engine should steer away from while limited */
function limitSystems(date){
  const out=[];
  activeLimits(date).forEach(l=>{
    const a=areaOf(l.area); if(!a) return;
    (a.sys||[]).forEach(s=>{ if(out.indexOf(s)<0) out.push(s); });
  });
  return out;
}
/* is this exercise off-limits right now? */
function limitBlocks(ex, date){
  if(!ex) return false;
  const pat=(EX_META[ex.id]||[])[0] || ex.pattern;
  if(!pat) return false;
  return limitPatterns(date).avoid.indexOf(pat)>=0;
}
const limitsText = date => activeLimits(date)
  .map(l=>{ const a=areaOf(l.area); return a?(l.side?l.side+' ':'')+a.name.toLowerCase():l.area; })
  .join(', ');

/* =========================================================================
   WHAT YOU DID LAST TIME
   Every set's reps, weight and RPE is already recorded. Progressive overload
   is the whole mechanism of getting stronger, and you cannot beat last week
   if you cannot see last week — so the last performance of an exercise is
   looked up and shown while you are standing in front of it.
   ====================================================================== */
function lastPerformance(exId, beforeDate, excludeSessionId){
  if(!exId || !DB || !DB.sessions) return null;
  const done=DB.sessions.filter(s=>s.done && s.id!==excludeSessionId &&
    (!beforeDate || s.date<=beforeDate) && Array.isArray(s.entries));
  /* newest first — date, then insertion order for two sessions in one day */
  for(let i=done.length-1;i>=0;i--){
    const s=done[i];
    const en=s.entries.find(e=>e.exerciseId===exId && e.sets && e.sets.some(x=>x.done));
    if(!en) continue;
    const sets=en.sets.filter(x=>x.done);
    const w=sets.map(x=>parseFloat(x.weight)).filter(v=>!isNaN(v));
    const r=sets.map(x=>parseFloat(x.reps)).filter(v=>!isNaN(v));
    const p=sets.map(x=>parseFloat(x.rpe)).filter(v=>!isNaN(v));
    return {
      date:s.date, sessionName:s.workoutName||'', sets,
      /* what was ASKED of you that day, so "did you finish it" is answerable.
         Without this, progression can only see what went in, never whether
         what went in was the whole of it. */
      plannedSets: (+en.plannedSets)||sets.length,
      plannedReps: en.plannedReps||'',
      plannedRpe:  en.plannedRpe||'',
      skipped:     !!en.skipped,
      topWeight: w.length?Math.max(...w):null,
      topReps:   r.length?Math.max(...r):null,
      bestRpe:   p.length?Math.max(...p):null,
      /* load is the honest comparator: bodyweight work progresses by reps,
         loaded work by weight, and volume covers both */
      volume: sets.reduce((a,x)=>{
        const rr=parseFloat(x.reps), ww=parseFloat(x.weight);
        return a + (isNaN(rr)?0:rr)*(isNaN(ww)?1:Math.max(ww,1));
      },0)
    };
  }
  return null;
}
/* "3 × 10 @ 12 kg" from a set list, collapsing identical sets. `timed` makes
   it "3 × 40s": a hold recorded as the number 40 must never read as 40 reps. */
function setsSummary(sets,timed){
  if(!sets||!sets.length) return '';
  const parts=sets.map(s=>{
    const r=(s.reps||s.reps===0)?String(s.reps)+(timed?'s':''):'—';
    const w=(s.weight!==''&&s.weight!=null)?(' @ '+s.weight+' kg'):'';
    return r+w;
  });
  const all=parts.every(x=>x===parts[0]);
  return all ? `${parts.length} × ${parts[0]}` : parts.join(', ');
}
/* did this session beat the previous one on the same exercise? */
function progressVs(prev, entry){
  if(!prev || !entry) return null;
  const done=entry.sets.filter(s=>s.done);
  if(!done.length) return null;
  const vol=done.reduce((a,x)=>{
    const rr=parseFloat(x.reps), ww=parseFloat(x.weight);
    return a + (isNaN(rr)?0:rr)*(isNaN(ww)?1:Math.max(ww,1));
  },0);
  if(!prev.volume) return null;
  const pct=(vol-prev.volume)/prev.volume*100;
  if(pct>=2)  return {up:true,  pct:Math.round(pct), vol};
  if(pct<=-8) return {up:false, pct:Math.round(pct), vol};
  return {up:null, pct:Math.round(pct), vol};
}


/* =========================================================================
   PROGRESSIVE OVERLOAD, EARNED
   ------------------------------------------------------------------------
   See the note above shapeBlock for what the block plan does. This half is
   about the numbers on one exercise, and about the gate that governs every
   upward lever in the app.

   The gate exists because overload on top of a plan nobody completes is not
   progression, it is a number going up. It is measured from what is already
   recorded per set - planned sets against sets actually logged - and it
   always says why it is open or shut.
   ====================================================================== */
const PROG_WINDOW=14;        // days of history the gate looks at
const PROG_MIN_SESSIONS=2;   // before there is anything to measure
const PROG_SET_PCT=0.85;     // of the prescribed sets, actually logged
const HOLD_STEP=5;           // seconds a hold grows by when it is earned

/* =========================================================================
   IS THIS A HOLD?
   ------------------------------------------------------------------------
   Derived from the prescription rather than listed, so a new exercise is
   classified without anyone maintaining a table. The block tables contain
   both per-set holds and whole-session durations and they are not the same
   thing: '30–45s' and '40s / side' are holds you can put a countdown on,
   while '20 min', '20s hard / 40s easy' and '5 × 8s' are a ride, an interval
   structure and a rep-and-hold hybrid. So: seconds only, three minutes or
   less, and no interval structure.
   ====================================================================== */
const HOLD_MAX_SEC=180;
function setSecs(reps){
  const txt=String(reps==null?'':reps);
  if(!txt) return null;
  /* anything with a second unit of time, a distance, or an effort structure
     is not one number with a countdown on it */
  if(/min|hour|hard|easy|×|\bx\s*[0-9]|reaction|\bm\b|metre|meter|jump/i.test(txt)) return null;
  const m=txt.match(/([0-9]+)\s*(?:[–-]\s*([0-9]+)\s*)?s(?:ec|econds?)?\b/i);
  if(!m) return null;
  const a=+m[1], b=m[2]?+m[2]:+m[1];
  const lo=Math.min(a,b), hi=Math.max(a,b);
  if(!(hi>0) || hi>HOLD_MAX_SEC) return null;
  return {lo:lo, hi:hi, perSide:/\/\s*(side|leg|arm)|each/i.test(txt)};
}
/* "30–45 seconds per side", for a screen that must not say "reps" */
function secsLabel(t){
  if(!t) return '';
  return (t.lo===t.hi? t.hi+' seconds' : t.lo+'–'+t.hi+' seconds')
       + (t.perSide? ' per side' : '');
}

/* A rep prescription as numbers, or null when it is not reps at all:
   '30–40 min', '45s' and 'per side' are all in the block tables. */
function repRange(reps){
  const txt=String(reps==null?'':reps);
  if(/min|sec|hour/i.test(txt)) return null;
  const ns=txt.match(/[0-9]+/g);
  if(!ns||!ns.length) return null;
  const lo=+ns[0], hi=ns.length>1?+ns[1]:+ns[0];
  if(!(lo>0)) return null;
  return {lo:Math.min(lo,hi), hi:Math.max(lo,hi)};
}

/* How much of what was prescribed actually got logged, over the last
   fortnight. Sets, not sessions: turning up and doing half of it is the case
   this has to catch. */
function completionRate(date){
  const to=date||todayISO(), from=addDays(to,-(PROG_WINDOW-1));
  const ss=(DB.sessions||[]).filter(s=>s.done && s.date>=from && s.date<=to
                                      && Array.isArray(s.entries));
  let planned=0, logged=0, skipped=0;
  ss.forEach(s=>s.entries.forEach(e=>{
    const ps=(+e.plannedSets)||((e.sets||[]).length);
    planned+=ps;
    logged+=(e.sets||[]).filter(x=>x.done).length;
    if(e.skipped) skipped++;
  }));
  return {sessions:ss.length, planned:planned, logged:logged, skipped:skipped,
          pct: planned? logged/planned : null};
}

/* Is anything allowed to get harder? One answer, one reason, used by every
   upward lever so they cannot disagree with each other. */
function progressGate(date){
  const c=completionRate(date);
  const pc=c.pct==null?0:Math.round(c.pct*100);
  if(c.sessions<PROG_MIN_SESSIONS)
    return Object.assign({ok:false, line:'Nothing is being pushed up yet: there '
      +(c.sessions===1?'is 1 finished session':'are '+c.sessions+' finished sessions')
      +' in the last two weeks and it takes '+PROG_MIN_SESSIONS+' to measure anything.'}, c);
  if(c.pct==null || c.pct<PROG_SET_PCT)
    return Object.assign({ok:false, line:'Holding the numbers where they are: '
      +pc+'% of the sets prescribed in the last two weeks went in. Overload '
      +'resumes at '+Math.round(PROG_SET_PCT*100)+'%.'}, c);
  return Object.assign({ok:true, line:'You logged '+pc+'% of the sets prescribed '
    +'in the last two weeks, so the numbers are moving up.'}, c);
}

/* The eight-week cycle repeats, and the progression card has always said
   "same structure, harder variations". This is what makes the second time
   round harder. Capped at two extra sets, never in a deload week, and never
   without the gate. */
function blockBonus(ph, date){
  if(!ph || !(ph.block>1)) return 0;
  if(ph.vol<1) return 0;
  if(!progressGate(date).ok) return 0;
  return Math.min(2, ph.block-1);
}

/* An RPE prescription, capped. 'RPE 8–9' under a cap of 6 must not read
   'RPE 6–6'. */
function capRpe(s, cap){
  if(!cap) return s;
  const txt=String(s==null?'':s);
  if(!/[0-9]/.test(txt)) return s;
  let hit=false;
  let out=txt.replace(/[0-9]+/g, n=>{ if(+n>cap){ hit=true; return String(cap); } return n; });
  if(!hit) return s;
  return out.replace(/([0-9]+)\s*[–-]\s*\1/g, '$1');
}

/* =========================================================================
   The block plan, finally applied.
   PHASES[].vol and PHASES[].rpeCap were displayed to the user for every one
   of the eight weeks and read by nothing. A deload week was prescribed
   identically to a peak week. Bounded to one set either way so the change is
   predictable: a re-entry or deload week takes a set off each multi-set
   movement and lowers the prescribed effort, and that is all.
   ====================================================================== */
function shapeBlock(b, ph){
  if(!ph) return b;
  const nb=Object.assign({},b);
  if(typeof nb.sets==='number' && nb.sets>=2 && ph.vol && ph.vol!==1){
    const want=clamp(Math.round(nb.sets*ph.vol), nb.sets-1, nb.sets+1);
    if(want!==nb.sets && want>=1){
      nb.progNote='Week '+ph.absWeek+' is '+ph.name+' — '
        +(want<nb.sets? nb.sets+' sets cut to '+want : 'one set added')+'.';
      nb.sets=want;
    }
  }
  const rp=capRpe(nb.rpe, ph.rpeCap);
  if(rp!==nb.rpe){
    nb.progNote=(nb.progNote?nb.progNote+' ':'')
      +'Effort capped at RPE '+ph.rpeCap+' this week.';
    nb.rpe=rp;
  }
  return nb;
}

/* =========================================================================
   What today's numbers should be, and why.
   Double progression: reps inside the range first, then load with the reps
   back at the bottom. Every step has to be earned twice - once by the gate,
   once by what actually happened on this exercise last time.
   ====================================================================== */
function nextTarget(en, date){
  const out={kind:'hold', reps:null, weight:null, line:null};
  if(!en) return out;
  const rng=repRange(en.plannedReps);
  const live=(typeof W!=='undefined'&&W)?W.id:null;
  const prev=lastPerformance(en.exerciseId, null, live);

  if(!prev) return Object.assign(out,{kind:'new',
    line:'First time on this one — today sets the baseline to beat.'});
  /* a hold progresses in seconds, and nothing on its screen may say "reps" */
  const hold=setSecs(en.plannedReps);
  if(hold){
    const gateH=progressGate(date);
    const secs=prev.sets.map(s=>parseFloat(s.reps)).filter(v=>!isNaN(v));
    const lowS=secs.length?Math.min.apply(null,secs):null;
    const needH=prev.plannedSets||prev.sets.length;
    if(!gateH.ok)  return Object.assign(out,{kind:'hold', line:gateH.line, gate:gateH});
    if(prev.skipped) return Object.assign(out,{kind:'hold',
      line:'You skipped this last time, so the target is unchanged.'});
    if(prev.sets.length<needH) return Object.assign(out,{kind:'hold',
      line:'Last time '+prev.sets.length+' of '+needH+' sets went in, so the target is the same again.'});
    if(lowS==null) return out;
    if(lowS<hold.hi) return Object.assign(out,{kind:'secs',
      reps:String(Math.min(hold.hi, lowS+HOLD_STEP)),
      line:'Target '+Math.min(hold.hi,lowS+HOLD_STEP)+' seconds — '+HOLD_STEP
        +' more than every set held last time.'});
    return Object.assign(out,{kind:'secs', reps:String(lowS+HOLD_STEP),
      line:'Target '+(lowS+HOLD_STEP)+' seconds — you held '+lowS
        +' on every set last time, so the hold gets longer.'});
  }
  if(!rng) return Object.assign(out,{kind:'na',
    line:'Held at the prescribed effort — this one is not counted in reps.'});

  const gate=progressGate(date);
  const sets=prev.sets;                                   // logged sets only
  const reps=sets.map(s=>parseFloat(s.reps)).filter(v=>!isNaN(v));
  const wts =sets.map(s=>parseFloat(s.weight)).filter(v=>!isNaN(v));
  const lowReps=reps.length?Math.min.apply(null,reps):null;
  const topW   =wts.length?Math.max.apply(null,wts):null;
  const need   =prev.plannedSets||sets.length;
  const pRpeM  =String(prev.plannedRpe||en.plannedRpe||'').match(/([0-9]+)/);
  const pRpe   =pRpeM?+pRpeM[1]:null;

  if(!gate.ok)            return Object.assign(out,{kind:'hold', line:gate.line, gate:gate});
  if(prev.skipped)        return Object.assign(out,{kind:'hold',
    line:'You skipped this last time, so the target is unchanged.'});
  if(sets.length<need)    return Object.assign(out,{kind:'hold',
    line:'Last time '+sets.length+' of '+need+' sets went in, so the target is the same again.'});
  if(lowReps==null)       return out;

  /* short of the top of the range: one more rep, on every set */
  if(lowReps<rng.hi){
    const want=Math.min(rng.hi, lowReps+1);
    return Object.assign(out,{kind:'reps', reps:String(want),
      weight: topW!=null?String(topW):null,
      line:'Target '+want+' reps — one more than every set managed last time.'});
  }
  /* at the top of the range, but it cost more than it was supposed to */
  if(pRpe!=null && prev.bestRpe!=null && prev.bestRpe>pRpe){
    return Object.assign(out,{kind:'hold',
      line:'You reached '+rng.hi+' last time but at RPE '+prev.bestRpe
        +'. Same numbers again until it comes in at '+pRpe+'.'});
  }
  /* earned: add load, reps back to the bottom of the range */
  if(topW!=null && topW>0){
    const step=stepSize('weight', topW);
    const nw=Math.round((topW+step)*100)/100;
    return Object.assign(out,{kind:'load', weight:String(nw), reps:String(rng.lo),
      line:'+'+step+' kg on last time — you hit '+rng.hi+' on every set'
        +(prev.bestRpe!=null?' at RPE '+prev.bestRpe:'')+'.'});
  }
  /* nothing to load, so the reps keep going past the range */
  return Object.assign(out,{kind:'reps', reps:String(lowReps+1),
    line:'No load to add on this one, so the target is '+(lowReps+1)
      +' reps — one past last time.'});
}


/* =========================================================================
   A BLOCK MEASURED IN TIME
   ------------------------------------------------------------------------
   Running, riding and playing a sport are measured in minutes, and the block
   tables already prescribe them that way. Which blocks those are is derived
   from the exercise's own category and its prescription, so nothing has to be
   maintained by hand and the awkward cases fall out correctly:

     cd01 '25–45 min'              -> a clock, 35 minutes
     cd03 '20s hard / 40s easy' ×8 -> a clock, 8 minutes
     cd04 '10–15s uphill'       ×6 -> NOT a clock; hill sprints are reps
     lx18 '20'                     -> NOT a clock; calf raises are reps
   ====================================================================== */
function cardioActOf(ex){
  if(!ex || ex.cat!=='cardio') return null;
  const eq=String(ex.equip||'').toUpperCase();
  const nm=String(ex.name||'');
  if(/WALK/i.test(nm)) return 'walking';
  if(/BIKE|CYCL|SPIN/.test(eq) || /Bike|Spin|Cycl/i.test(nm)) return 'cycling';
  if(/ROW/.test(eq)) return 'other';
  return 'running';
}
/* What the prescription actually comes to, in minutes, or null when it is not
   a span of time at all. */
function cardioMinutes(b){
  const txt=String((b&&b.reps)||'');
  const sets=+((b&&b.sets))||1;
  if(!txt) return null;

  /* '2 × 8 min, 3 min easy between' — the repeats are inside the text */
  let m=txt.match(/([0-9]+)\s*×\s*([0-9]+)\s*min/i);
  if(m){
    const n=+m[1], per=+m[2];
    const gap=txt.match(/,\s*([0-9]+)\s*min/i);
    return n*per + (gap? (+gap[1])*Math.max(0,n-1) : 0);
  }
  /* an interval structure: '20s hard / 40s easy', '1 min hard / 2 min easy'.
     One `sets` is one work-plus-recovery cycle. */
  if(/hard|easy|\bon\b|\boff\b/i.test(txt)){
    const iv=txt.match(/([0-9]+)\s*(s|sec|min)[^0-9]*?([0-9]+)\s*(s|sec|min)/i);
    if(iv){
      const toS=(v,u)=>/min/i.test(u)? v*60 : v;
      const per=toS(+iv[1],iv[2])+toS(+iv[3],iv[4]);
      return Math.max(1, Math.round(per*sets/60));
    }
  }
  /* '25–45 min', '18–25 min at tempo', '30 min' */
  m=txt.match(/([0-9]+)\s*(?:[–-]\s*([0-9]+)\s*)?min/i);
  if(m){ const lo=+m[1], hi=m[2]?+m[2]:+m[1]; return Math.round((lo+hi)/2); }
  return null;
}
/* the two together: the clock spec for a block, or null */
function cardioSpec(b, ex){
  const act=cardioActOf(ex);
  if(!act) return null;
  const min=cardioMinutes(b && b.reps!=null ? b : ex);
  if(!min) return null;
  return {act:act, targetMin:min};
}

/* How hard, as a number the strain curve understands. The activity form
   records a word; the block tables record an RPE; both end up here. */
const INT_RPE={Easy:4, Moderate:6, Hard:8, Maximal:9};
function effortRpe(intensity, plannedRpe){
  if(intensity && INT_RPE[intensity]!=null) return INT_RPE[intensity];
  const m=String(plannedRpe==null?'':plannedRpe).match(/([0-9]+)/);
  return m? clamp(+m[1],1,10) : 6;
}
/* Strain for an effort in progress, on the same 0–21 curve every saved
   activity uses, so the number ticking up during a run and the number in the
   history mean the same thing. */
function liveStrain(type, min, rpe){
  return activityLoad({type:type, min:min, rpe:rpe});
}

/* =========================================================================
   THE LAST COMPARABLE EFFORT
   What "comparable" means depends on where the effort came from: a planned
   session compares with the last time you did that same session, a logged
   activity with the last one of the same kind.
   ====================================================================== */
function lastEffort(o){
  const date=o.date||todayISO();
  let best=null;
  if(o.workoutId){
    (DB.sessions||[]).filter(s=>s.done && s.id!==o.excludeId
        && s.workoutId===o.workoutId && s.date<=date)
      .forEach(s=>{ if(!best||s.date>best.date) best={
        date:s.date, min:s.durationMin||0, dist:s.distKm||null,
        strain:sessionLoad(s).load, name:s.workoutName||''}; });
  }
  if(!best && o.type){
    (DB.activities||[]).filter(a=>a.type===o.type && a.id!==o.excludeId && a.date<=date)
      .forEach(a=>{ if(!best||a.date>best.date) best={
        date:a.date, min:a.min||0, dist:a.dist||null,
        strain:activityLoad(a), name:(ACT_TYPES[a.type]||{}).name||''}; });
  }
  if(best) best.pace=(best.dist&&best.min)? best.min/best.dist : null;
  return best;
}
/* One row of the comparison. `lowerIsBetter` exists for pace, where a smaller
   number is the good news and an arrow pointing down must not read as a loss. */
function cmpRow(label, now, was, unit, dp, lowerIsBetter, fmt){
  const f=fmt||(v=>v==null?'—':rnd(v,dp||0)+(unit?' '+unit:''));
  if(now==null) return '';
  let delta='';
  if(was!=null && was!==0){
    const d=now-was;
    const good = lowerIsBetter ? d<0 : d>0;
    const same = Math.abs(d) < (dp? Math.pow(10,-dp)/2 : 0.5);
    delta = same ? `<span class="cd flat">no change</span>`
      : `<span class="cd ${good?'up':'down'}">${d>0?'+':'−'}${f(Math.abs(d))}</span>`;
  }
  return `<div class="cmp"><span class="cl">${esc(label)}</span>
    <span class="cn">${esc(String(f(now)))}</span>
    <span class="cw">${was==null?'':'was '+esc(String(f(was)))}</span>
    ${delta}</div>`;
}

/* the tier implied by what is ticked — used only for labelling */
function tierFromGear(){
  const have=gearList();
  if(have.indexOf('bb')>=0||have.indexOf('cable')>=0) return 2;
  if(have.indexOf('bench')>=0||have.indexOf('bar')>=0||have.indexOf('kb')>=0) return 1;
  return 0;
}
const PATTERNS={
