 prog:'Load → step further from the stack → half-kneeling.',
 reg:'Band Pallof Press.',
 subs:'Band Pallof Press'},
{id:'g18',name:'Cable Woodchop',cat:'core',pat:'rotate',tier:2,muscles:'Rotational control, obliques',equip:'Cable machine',sets:3,reps:'10–12 / side',rpe:'RPE 7',rest:'45s',tempo:'2-0-2-0',
 how:'Rotate through the back hip and pull diagonally across the body, controlling the return.',
 cue:'Power comes from the hip, not the arms — the same sequence as a groundstroke.',
 prog:'Load → speed → add a step into it.',
 reg:'Band Rotational Press.',
 subs:'Band Rotational Press · Half-Kneeling Band Chop'},
{id:'g19',name:'Hanging Leg Raise',cat:'core',pat:'antiext',tier:1,muscles:'Lower abs, hip flexors',equip:'Pull-up bar',sets:3,reps:'8–15',rpe:'RPE 8',rest:'60s',tempo:'2-0-3-0',
 how:'Hang, then curl the pelvis up so the hips travel towards the ribs. Lower slowly without swinging.',
 cue:'Curl the pelvis — do not just lift the legs.',
 prog:'Bent knee → straight leg → toes to bar.',
 reg:'Reverse Crunch.',
 subs:'Reverse Crunch · Hollow Body Hold'},
{id:'g20',name:'Trap Bar Jump',cat:'plyo',pat:'jump',tier:2,muscles:'Triple extension power',equip:'Trap bar',sets:4,reps:'3–5',rpe:'Max quality',rest:'2 min',tempo:'Explosive',
 how:'Light load in a trap bar, jump as high as possible, land softly and reset every rep.',
 cue:'Keep the load light — around 20–30% of a heavy deadlift. Speed is the point, not weight.',
 prog:'Track jump height. Progress by jumping higher, never by adding volume.',
 reg:'Countermovement Jump.',
 subs:'Countermovement Jump · Squat Jump',
 notes:'Only worthwhile if the load actually moves fast. If it looks like a deadlift, it is too heavy.'},
{id:'g21',name:'Incline DB Press',cat:'push',pat:'pushh',tier:1,muscles:'Upper chest, front delts',equip:'Dumbbells + bench',sets:3,reps:'8–12',rpe:'RPE 8',rest:'90s',tempo:'3-1-1-0',
 how:'Bench at about 30°, press from a stretch at the upper chest to lockout.',
 cue:'30° is enough — steeper turns it into a shoulder press.',
 prog:'Add load or reps.',
 reg:'Push-Up.',
 subs:'DB Bench Press · Feet-Elevated Push-Up'},
{id:'g22',name:'Chest-Supported DB Row',cat:'pull',pat:'pullh',tier:1,muscles:'Mid-back, rear delts',equip:'Dumbbells + incline bench',sets:3,reps:'10–14',rpe:'RPE 8',rest:'75s',tempo:'2-1-2-0',
 how:'Chest on an incline bench, row the dumbbells to the ribs and squeeze.',
 cue:'The bench removes all cheating — the back has to do it.',
 prog:'Add load or reps.',
 reg:'DB Bent-Over Row.',
 subs:'DB Bent-Over Row · Seated Cable Row'},
{id:'g23',name:'Bulgarian Split Squat (loaded)',cat:'lower',pat:'lunge',tier:1,muscles:'Quads, glutes, stabilisers',equip:'Dumbbells + bench',sets:3,reps:'6–10 / leg',rpe:'RPE 8',rest:'90s / leg',tempo:'3-1-1-0',
 how:'Rear foot on a bench, dumbbells at the sides, lower until the front thigh is near parallel and drive up.',
 cue:'90% of the load in the front leg. This is the most transferable single-leg strength builder there is.',
 prog:'Add load, then add a 2-second pause at the bottom.',
 reg:'Bodyweight Bulgarian Split Squat.',
 subs:'Bulgarian Split Squat · Skater Squat'},
{id:'g24',name:'Nordic Curl (anchored)',cat:'lower',pat:'hamcurl',tier:1,muscles:'Hamstrings (eccentric)',equip:'Ankle anchor / partner',sets:3,reps:'4–6',rpe:'RPE 9',rest:'2 min',tempo:'5-0-X-0',
 how:'Kneel with the ankles anchored, lower the torso as slowly as possible, catch with the hands and push back.',
 cue:'Hips stay extended throughout. Fight the whole descent.',
 prog:'Lengthen the controlled portion before adding reps.',
 reg:'Band-assisted, or Sliding Leg Curl.',
 subs:'Nordic Curl Eccentric · Seated Leg Curl',
 notes:'Very high stimulus and very high soreness. Never within 48h of a match.'},
{id:'g25',name:'Farmer Carry',cat:'core',pat:'antilat',tier:1,muscles:'Trunk, grip, traps',equip:'Heavy dumbbells',sets:3,reps:'30–45s',rpe:'RPE 8',rest:'75s',tempo:'Walk',
 how:'Heavy dumbbell in each hand, walk tall and controlled.',
 cue:'Ribs down, shoulders level, no leaning. Breathe.',
 prog:'Add load, then distance.',
 reg:'Suitcase Carry with one dumbbell.',
 subs:'Suitcase Carry'},
{id:'g26',name:'Box Jump',cat:'plyo',pat:'jump',tier:1,muscles:'Jump power, landing',equip:'Box/step',sets:4,reps:'3–5',rpe:'Max quality',rest:'90s',tempo:'Explosive',
 how:'Jump onto a box at a height you can land softly on in a quarter squat. Step down, never jump down.',
 cue:'Box height flatters bad landings — choose a height you land on quietly and in control.',
 prog:'Height, only while landing quality holds.',
 reg:'Countermovement Jump.',
 subs:'Countermovement Jump'},
{id:'g27',name:'Med Ball Rotational Throw',cat:'core',pat:'rotate',tier:1,muscles:'Rotational power',equip:'Medicine ball + wall',sets:4,reps:'5–8 / side',rpe:'Explosive',rest:'60s',tempo:'Max intent',
 how:'Athletic stance side-on to a wall, rotate through the back hip and throw the ball hard into the wall.',
 cue:'Ground up: back foot, hip, torso, arms. Exactly the groundstroke sequence, at full speed.',
 prog:'Ball weight or throw velocity — never volume.',
 reg:'Band Rotational Press.',
 subs:'Band Rotational Press',
 notes:'The single best rotational power exercise, and it needs almost no equipment.'},
{id:'g28',name:'Treadmill / Rower Intervals',cat:'cardio',pat:'cardio',tier:1,muscles:'Repeat-sprint ability',equip:'Treadmill, rower or bike',sets:10,reps:'20s hard / 40s easy',rpe:'RPE 8',rest:'Built in',tempo:'Intervals',
 how:'10–12 rounds of 20 seconds hard and 40 seconds easy on any machine.',
 cue:'The 20:40 structure mirrors real match play. Last round should look like the first.',
 prog:'Add rounds to 12, then extend the work interval.',
 reg:'Fewer rounds.',
 subs:'Tennis Interval Run · Bike Intervals'}
];}

/* attach pattern / tier / equipment-needs metadata to the library */

/* =========================================================================
   ADDITIONAL EXERCISES
   Chosen to fill the thinnest movement patterns rather than to pad the total.
   Before these, `squat`, `hinge` and `slsquat` had two options or fewer each,
   which left the injury router and the equipment substitution with nowhere to
   go: if the one available hinge needed a dumbbell you did not own, or loaded
   a back you were resting, there was no alternative to fall back to.

   Weighted towards bodyweight, because that is the only kit a no-gym user is
   guaranteed to have, and because every pattern needs at least one option
   that survives having no equipment at all.
   ====================================================================== */
function extraExercises(){ return [

/* ---------------- SQUAT ---------------- */
{id:'x01',name:'Prisoner Squat',cat:'lower',pat:'squat',tier:0,muscles:'Quads, glutes, upper back',equip:'BW',sets:3,reps:'15–25',rpe:'RPE 7',rest:'60s',tempo:'3-1-1-0',
 how:'Hands behind the head, elbows wide. Squat to the deepest position you can hold without the lower back rounding, then stand.',
 cue:'Elbows stay back all the way down — that is what stops the chest folding forward.',
 prog:'Add reps to 25, then move to the 1.5-Rep Squat, then add load.',
 reg:'Hold a doorframe lightly for balance, or reduce depth.',
 subs:'Tempo Goblet Squat · Wall Sit'},

{id:'x02',name:'1.5-Rep Squat',cat:'lower',pat:'squat',tier:0,muscles:'Quads, glutes',equip:'BW',sets:3,reps:'8–12',rpe:'RPE 8',rest:'75s',tempo:'Controlled',
 how:'Squat down, come up only halfway, sit back down to the bottom, then stand fully. That whole sequence is one rep.',
 cue:'The half rep is the point. Do not rush through the bottom — it is where the work is.',
 prog:'Add reps, then hold a dumbbell at the chest.',
 reg:'Reduce depth, or do straight reps.',
 subs:'Prisoner Squat · Tempo Goblet Squat',
 notes:'The extra time in the hardest position is how you keep loading the quads without extra weight.'},

{id:'x03',name:'Heels-Elevated Goblet Squat',cat:'lower',pat:'squat',tier:0,muscles:'Quads, glutes',equip:'DB',sets:3,reps:'8–12',rpe:'RPE 8',rest:'75s',tempo:'3-1-1-0',
 how:'Stand with your heels on a book or folded mat, toes flat. Hold a dumbbell at the chest and squat deep.',
 cue:'Raising the heels lets the knees travel further forward, which loads the quads harder and lets you sit deeper.',
 prog:'Add reps, then load, then reduce the heel lift as ankle range improves.',
 reg:'Lower the heel lift, or hold nothing.',
 subs:'Tempo Goblet Squat · 1.5-Rep Squat'},

{id:'x04',name:'Kettlebell Front Squat',cat:'lower',pat:'squat',tier:1,muscles:'Quads, glutes, trunk',equip:'Kettlebell',sets:3,reps:'6–10',rpe:'RPE 8',rest:'90s',tempo:'3-0-1-0',
 how:'Hold one kettlebell in both hands at the chest, elbows tucked in. Squat to depth and drive up.',
 cue:'Keep the weight glued to the sternum. If it drifts away the lower back takes over.',
 prog:'Add reps, then a heavier bell, then move to two bells or a barbell.',
 reg:'Goblet Squat with a dumbbell.',
 subs:'Tempo Goblet Squat · Barbell Back Squat'},

/* ---------------- HINGE ---------------- */
{id:'x05',name:'Single-Leg Hip Hinge (Airplane)',cat:'lower',pat:'hinge',tier:0,muscles:'Hamstrings, glutes, balance',equip:'BW',sets:3,reps:'8–12 / leg',rpe:'RPE 7',rest:'45s / leg',tempo:'3-1-2-0',
 how:'Stand on one leg. Hinge at the hip until the torso and the free leg form one line parallel to the floor, arms out to the sides. Return.',
 cue:'Hips stay level — do not let the free-leg hip rotate open to the ceiling.',
 prog:'Add reps, then add a slow 5-second lower, then hold a dumbbell.',
 reg:'Touch a wall with one hand for balance.',
 subs:'Single-Leg RDL · DB Romanian Deadlift'},

{id:'x06',name:'Band Pull-Through',cat:'lower',pat:'hinge',tier:0,muscles:'Glutes, hamstrings',equip:'BAND',sets:3,reps:'12–20',rpe:'RPE 7',rest:'60s',tempo:'2-0-1-1',
 how:'Anchor a band low behind you, face away, and pass the band between your legs. Hinge forward, then stand by driving the hips forward against the band.',
 cue:'This is a hip movement, not an arm movement. Your hands just hold on.',
 prog:'Shorten the band or step further away for more tension.',
 reg:'Step closer to the anchor.',
 subs:'DB Romanian Deadlift · Floor Hip Thrust',
 notes:'The easiest way to learn what a hinge should feel like, because the band pulls you into the right shape.'},

{id:'x07',name:'Banded Good Morning',cat:'lower',pat:'hinge',tier:0,muscles:'Hamstrings, glutes, erectors',equip:'BAND',sets:3,reps:'12–20',rpe:'RPE 7',rest:'60s',tempo:'3-1-1-0',
 how:'Stand on a band and loop the top behind your neck across the upper back. Hinge forward with a flat back until you feel the hamstrings, then stand.',
 cue:'Push the hips back rather than bending the spine. Knees stay softly bent throughout.',
 prog:'Add reps, then use a heavier band.',
 reg:'Reduce range, or do it with no band.',
 subs:'DB Romanian Deadlift · Band Pull-Through'},

{id:'x08',name:'Kettlebell Swing',cat:'lower',pat:'hinge',tier:1,muscles:'Glutes, hamstrings, trunk',equip:'Kettlebell',sets:4,reps:'12–20',rpe:'RPE 7',rest:'60s',tempo:'Ballistic',
 how:'Hinge and hike the bell back between the legs, then snap the hips forward so the bell floats to chest height. Let it fall and repeat.',
 cue:'The arms do nothing. It is a hinge that happens fast, not a front raise.',
 prog:'Add reps, then a heavier bell, then single-arm.',
 reg:'Learn the Band Pull-Through first.',
 subs:'Band Pull-Through · Broad Jump',
 notes:'Counts as both hinge strength and conditioning. Stop the set the moment the hips stop snapping.'},

/* ---------------- SINGLE-LEG SQUAT ---------------- */
{id:'x09',name:'Step-Down (Eccentric)',cat:'lower',pat:'slsquat',tier:1,muscles:'Quads, glutes, knee control',equip:'Step or bench',sets:3,reps:'6–10 / leg',rpe:'RPE 8',rest:'60s / leg',tempo:'5-0-1-0',
 how:'Stand on a step on one leg, the other hanging off the side. Lower that heel towards the floor over 5 seconds, tap lightly, then push back up.',
 cue:'The knee of the working leg must not collapse inward. Watch it, and stop the set when it does.',
 prog:'Use a higher step, then hold a dumbbell.',
 reg:'Lower step, or hold a support.',
 subs:'Skater Squat · Bulgarian Split Squat',
 notes:'The single best exercise for knee control, and the one physios reach for first.'},

{id:'x10',name:'Shrimp Squat',cat:'lower',pat:'slsquat',tier:0,muscles:'Quads, glutes, balance',equip:'BW',sets:3,reps:'4–8 / leg',rpe:'RPE 8',rest:'75s / leg',tempo:'3-0-1-0',
 how:'Stand on one leg, bend the other knee and hold that foot behind you. Squat down until the trailing knee touches the floor, then stand.',
 cue:'Stay upright. Reach the arms forward as a counterweight if you need to.',
 prog:'Progress towards holding the foot with both hands, then to a pistol.',
 reg:'Do not hold the foot; let the back leg trail freely (Skater Squat).',
 subs:'Skater Squat · Step-Down (Eccentric)'},

{id:'x11',name:'Pistol Squat Progression',cat:'lower',pat:'slsquat',tier:0,muscles:'Quads, glutes, ankle range',equip:'BW',sets:3,reps:'3–8 / leg',rpe:'RPE 8',rest:'90s / leg',tempo:'3-1-1-0',
 how:'Stand on one leg with the other extended in front. Lower as far as you can control, then stand. Hold a doorframe with one hand at first and take less support over time.',
 cue:'Heel stays down. If it lifts, you have gone past your ankle range for today.',
 prog:'Take progressively less hand support, then none.',
 reg:'Sit back to a chair and stand from it on one leg.',
 subs:'Skater Squat · Shrimp Squat',
 notes:'A long project. Treat it as a skill you practise, not a set you grind.'},

/* ---------------- HIP EXTENSION ---------------- */
{id:'x12',name:'Frog Pump',cat:'lower',pat:'hipext',tier:0,muscles:'Glutes',equip:'BW',sets:3,reps:'20–30',rpe:'RPE 7',rest:'45s',tempo:'1-0-1-1',
 how:'Lie on your back, heels together, knees wide and turned out. Drive the hips up, squeeze hard at the top, lower.',
 cue:'The turned-out position takes the hamstrings out of it, so the glutes have to do the work.',
 prog:'Add reps to 30, then a band across the hips.',
 reg:'Reduce range.',
 subs:'Floor Hip Thrust · Single-Leg Glute Bridge'},

{id:'x13',name:'Banded Glute Bridge',cat:'lower',pat:'hipext',tier:0,muscles:'Glutes, hamstrings',equip:'BAND',sets:3,reps:'15–25',rpe:'RPE 7',rest:'45s',tempo:'2-0-1-2',
 how:'Loop a band just above the knees. Lie on your back, feet flat, and bridge up while pushing the knees out against the band.',
 cue:'Push out against the band the whole time — that is what makes this different from a plain bridge.',
 prog:'Add reps, heavier band, then single-leg.',
 reg:'Remove the band.',
 subs:'Floor Hip Thrust · Frog Pump'},

{id:'x14',name:'Hip Thrust March',cat:'lower',pat:'hipext',tier:0,muscles:'Glutes, trunk stability',equip:'BW',sets:3,reps:'8–12 / side',rpe:'RPE 7',rest:'60s',tempo:'Controlled',
 how:'Hold a bridge at the top. Without letting the hips drop or tilt, lift one knee towards the chest, replace it, then the other.',
 cue:'Put a hand on each hip bone — they should stay perfectly level as you march.',
 prog:'Slow the march down, or hold each knee up for 2 seconds.',
 reg:'Hold a plain bridge with both feet down.',
 subs:'Single-Leg Glute Bridge · Floor Hip Thrust'},

/* ---------------- HAMSTRING CURL ---------------- */
{id:'x15',name:'Band Leg Curl',cat:'lower',pat:'hamcurl',tier:0,muscles:'Hamstrings',equip:'BAND',sets:3,reps:'12–20 / leg',rpe:'RPE 7',rest:'45s',tempo:'2-0-2-0',
 how:'Anchor a band low in front of you and hook it around one ankle. Lie face down and curl the heel towards your backside against the tension.',
 cue:'Keep the hips pressed down. If they lift, the band is too heavy.',
 prog:'Step further from the anchor, or use a heavier band.',
 reg:'Lighter band or shorter range.',
 subs:'Sliding Leg Curl · Nordic Curl Eccentric'},

{id:'x16',name:'Long-Lever Bridge Walkout',cat:'lower',pat:'hamcurl',tier:0,muscles:'Hamstrings, glutes',equip:'BW',sets:3,reps:'6–10',rpe:'RPE 8',rest:'60s',tempo:'Slow',
 how:'Bridge up with feet flat. Walk the feet out a few inches at a time, keeping the hips high, until the legs are nearly straight. Walk back in.',
 cue:'The further the feet travel, the harder the hamstrings work. Stop before the hips sag.',
 prog:'Walk out further, or one leg at a time.',
 reg:'Fewer steps out.',
 subs:'Sliding Leg Curl · Single-Leg Glute Bridge',
 notes:'A hamstring curl for people with no equipment at all.'},

{id:'x17',name:'Single-Leg Bridge Curl',cat:'lower',pat:'hamcurl',tier:0,muscles:'Hamstrings',equip:'TOWEL',sets:3,reps:'8–12 / leg',rpe:'RPE 8',rest:'60s / leg',tempo:'2-0-3-0',
 how:'One heel on a towel on a smooth floor, other leg held up. Bridge the hips and slide the heel out until the leg is straight, then drag it back in without dropping the hips.',
 cue:'Dragging back in is the working half. Do it slowly.',
 prog:'Slow the return further, then add reps.',
 reg:'Use both legs.',
 subs:'Sliding Leg Curl · Nordic Curl Eccentric'},

/* ---------------- CALF & TIBIALIS ---------------- */
{id:'x18',name:'Bent-Knee Calf Raise',cat:'lower',pat:'calf',tier:0,muscles:'Soleus',equip:'BW',sets:3,reps:'15–25',rpe:'RPE 8',rest:'45s',tempo:'2-1-2-1',
 how:'Stand with knees bent to about 30 degrees and hold that angle. Rise onto the toes and lower slowly without straightening the knees.',
 cue:'Bending the knee shifts the work from the calf to the soleus underneath it — the muscle that matters for running and repeated push-off.',
 prog:'Add reps, then do it one leg at a time.',
 reg:'Hold a wall for balance.',
 subs:'Standing Calf Raise · Single-Leg Calf Raise',
 notes:'Straight-leg raises miss the soleus almost entirely, which is why this earns its own slot.'},

{id:'x19',name:'Eccentric Heel Lower',cat:'lower',pat:'calf',tier:0,muscles:'Calves, Achilles tendon',equip:'BW',sets:3,reps:'8–12 / leg',rpe:'RPE 7',rest:'60s',tempo:'1-0-6-0',
 how:'Rise onto both toes, shift your weight onto one leg, then lower that heel to the floor over 6 seconds. Use both legs to rise again.',
 cue:'Slow and even. No sudden drop at the end.',
 prog:'Add reps, then a small heel lift, then hold a dumbbell.',
 reg:'Lower over 3 seconds instead.',
 subs:'Single-Leg Calf Raise · Standing Calf Raise',
 notes:'The classic tendon-loading protocol. Slow eccentrics are what tendons respond to.'},

{id:'x20',name:'Toe Walk',cat:'lower',pat:'tib',tier:0,muscles:'Tibialis anterior, foot',equip:'BW',sets:3,reps:'30–45 s',rpe:'RPE 6',rest:'45s',tempo:'Steady',
 how:'Walk forwards on your heels with the toes pulled up as high as they will go.',
 cue:'Pull the toes towards the shin hard enough that the front of the shin burns.',
 prog:'Longer walks, then add a light band around the forefoot.',
 reg:'Shorter bouts.',
 subs:'Tibialis Raise'},

{id:'x21',name:'Tibialis Wall Raise',cat:'lower',pat:'tib',tier:0,muscles:'Tibialis anterior',equip:'WALL',sets:3,reps:'15–25',rpe:'RPE 7',rest:'45s',tempo:'2-0-3-0',
 how:'Lean your back against a wall with the feet a step out in front. Keeping the heels planted, pull the toes up towards the shins, then lower slowly.',
 cue:'Walk the feet further out to make it harder.',
 prog:'Feet further from the wall, then add reps.',
 reg:'Feet closer in.',
 subs:'Tibialis Raise · Toe Walk',
 notes:'Trains the muscle that decelerates the foot on landing — thin on most programmes and cheap insurance for the shins.'},

/* ---------------- ADDUCTOR ---------------- */
{id:'x22',name:'Side-Lying Adductor Raise',cat:'lower',pat:'adduct',tier:0,muscles:'Adductors',equip:'BW',sets:3,reps:'12–20 / side',rpe:'RPE 7',rest:'45s',tempo:'2-1-2-0',
 how:'Lie on your side with the top leg bent and resting forward. Keep the bottom leg straight and lift it towards the ceiling, then lower slowly.',
 cue:'Small range, no momentum. You should feel it on the inside of the thigh, not the hip.',
 prog:'Add reps, then a pause at the top, then an ankle weight.',
 reg:'Reduce range.',
 subs:'Copenhagen Plank · Adductor Squeeze',
 notes:'A gentler entry than the Copenhagen for anyone with a groin that is still grumbling.'},

{id:'x23',name:'Adductor Slide-Out',cat:'lower',pat:'adduct',tier:0,muscles:'Adductors, groin',equip:'TOWEL',sets:3,reps:'8–12 / side',rpe:'RPE 7',rest:'60s',tempo:'3-0-2-0',
 how:'Stand with one foot on a towel on a smooth floor. Slide that leg out to the side, keeping the other knee slightly bent, then drag it back in.',
 cue:'Pull back in with the inner thigh, not by shifting your body weight across.',
 prog:'Slide further out, then slow the return.',
 reg:'Shorter slide.',
 subs:'Cossack Squat · Copenhagen Plank'},

/* ---------------- VERTICAL PULL ---------------- */
{id:'x24',name:'Chin-Up',cat:'pull',pat:'pullv',tier:1,muscles:'Lats, biceps, upper back',equip:'Pull-up bar',sets:4,reps:'4–10',rpe:'RPE 8',rest:'2 min',tempo:'2-0-2-0',
 how:'Hang from a bar with an underhand grip, hands about shoulder width. Pull until the chin clears the bar, lower under control.',
 cue:'Start each rep from a dead hang with the shoulders set down, not shrugged up.',
 prog:'Add reps, then weight, then move towards the wider Pull-Up.',
 reg:'Negative Pull-Up or Band Lat Pulldown.',
 subs:'Pull-Up · Band Lat Pulldown',
 notes:'The underhand grip lets most people get more reps than a pull-up, which makes it the better starting point.'},

{id:'x25',name:'Negative Pull-Up',cat:'pull',pat:'pullv',tier:1,muscles:'Lats, biceps',equip:'Pull-up bar',sets:4,reps:'3–6',rpe:'RPE 8',rest:'90s',tempo:'0-0-6-0',
 how:'Jump or step up so your chin is over the bar, then lower yourself to a full hang over 6 seconds. Step up again for the next rep.',
 cue:'Fight the whole way down. If you drop through the bottom half, shorten the count.',
 prog:'Lengthen the lower to 8–10 seconds, then attempt full chin-ups.',
 reg:'Band Lat Pulldown.',
 subs:'Chin-Up · Inverted Row',
 notes:'The fastest route to a first pull-up for most people.'},

{id:'x26',name:'Band Kneeling Lat Pull',cat:'pull',pat:'pullv',tier:0,muscles:'Lats, upper back',equip:'BAND',sets:3,reps:'12–20',rpe:'RPE 7',rest:'60s',tempo:'2-0-2-1',
 how:'Anchor a band high, kneel facing it, and pull the band down to the chest with straight-ish arms, leading with the elbows.',
 cue:'Think about pulling your elbows into your back pockets.',
 prog:'Heavier band, or kneel further back.',
 reg:'Lighter band.',
 subs:'Band Lat Pulldown · Chin-Up'},

/* ---------------- ROTATION ---------------- */
{id:'x27',name:'Half-Kneeling Band Rotation',cat:'core',pat:'rotate',tier:0,muscles:'Obliques, trunk rotators',equip:'BAND',sets:3,reps:'10–15 / side',rpe:'RPE 7',rest:'45s',tempo:'1-0-2-0',
 how:'Anchor a band at chest height to your side. Kneel on the inside knee, hold the band with both hands at the chest, and rotate the torso away from the anchor.',
 cue:'Rotate through the ribs, not by swinging the arms or shifting the hips.',
 prog:'Heavier band, or step further from the anchor.',
 reg:'Lighter band, smaller range.',
 subs:'Band Rotational Press · Half-Kneeling Band Chop'},

{id:'x28',name:'Standing Band Woodchop',cat:'core',pat:'rotate',tier:0,muscles:'Obliques, trunk',equip:'BAND',sets:3,reps:'10–15 / side',rpe:'RPE 7',rest:'45s',tempo:'1-0-2-0',
 how:'Anchor a band high to one side. Standing tall, pull it down and across the body to the opposite hip, then return slowly.',
 cue:'Let the hips turn with the movement — this is a whole-body rotation, not an arm pull.',
 prog:'Heavier band, then add speed while keeping control on the return.',
 reg:'Lighter band.',
 subs:'Cable Woodchop · Band Rotational Press'},

/* ---------------- LANDING ---------------- */
{id:'x29',name:'Snap-Down',cat:'plyo',pat:'land',tier:0,muscles:'Landing mechanics, trunk',equip:'BW',sets:4,reps:'5',rpe:'RPE 6',rest:'60s',tempo:'Fast down, hold',
 how:'Stand tall on the balls of your feet with arms overhead. Snap down into a quarter-squat athletic position and freeze there, arms driving back.',
 cue:'Land silently and stop dead. No wobble, no second dip.',
 prog:'Move to Depth Drop and Stick once you can freeze every rep.',
 reg:'Slow the drop down.',
 subs:'Depth Drop & Stick · Single-Leg Hop & Stick',
 notes:'Teaches the landing position before you ever fall from a height. Do it before any jumping work.'},

{id:'x30',name:'Single-Leg Drop Landing',cat:'plyo',pat:'land',tier:0,muscles:'Knee and ankle control',equip:'BW',sets:3,reps:'4–6 / leg',rpe:'RPE 6',rest:'60s',tempo:'Land and hold',
 how:'Stand on one leg, hop a few inches off the floor, and land on the same leg. Hold the landing for two seconds.',
 cue:'The knee must not travel inward on landing. If it does, you are done for that set.',
 prog:'Small step down, then a slightly higher drop.',
 reg:'Two-footed landings first.',
 subs:'Single-Leg Hop & Stick · Snap-Down',
 notes:'Most non-contact knee injuries happen on a single-leg landing. This is the rehearsal.'},

{id:'x31',name:'Lateral Drop & Stick',cat:'plyo',pat:'land',tier:0,muscles:'Hip control, lateral stability',equip:'BW',sets:3,reps:'4–6 / side',rpe:'RPE 7',rest:'60s',tempo:'Land and hold',
 how:'Hop sideways onto one leg and freeze the landing for two seconds before hopping back.',
 cue:'Absorb through the hip, not by letting the ankle roll or the knee fall in.',
 prog:'Hop further, then land from a small step.',
 reg:'Shorter hop, two-footed.',
 subs:'Lateral Bound (Skater) · Single-Leg Hop & Stick'},

/* ---------------- BOUNDING ---------------- */
