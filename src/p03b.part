  ul05:['pullh',1],  ul06:['pullv',0],  ul07:['pullv',0],  ul08:['reardelt',0],
  ul09:['reardelt',0],ul10:['reardelt',0],ul11:['reardelt',0],ul12:['biceps',0],
  ul13:['biceps',0], ul14:['biceps',0], ul15:['pullh',0],
  mo01:['mob',0],mo02:['mob',0],mo03:['mob',0],mo04:['mob',0],mo05:['mob',0],
