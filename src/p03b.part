/* The whole built-in library, in one place. freshDB and migrate both go
   through this, so a new group of exercises can never again be added to one
   and forgotten in the other. */
function builtInExercises(){
  return applyExMeta(seedExercises().concat(gymExercises()).concat(extraExercises()));
}

function applyExMeta(list){
  list.forEach(e=>{
    const m=EX_META[e.id];
    if(m){ if(!e.pat) e.pat=m[0]; if(e.tier==null) e.tier=m[1]; }
    if(!e.pat) e.pat='other';
    if(e.tier==null) e.tier=0;
    if(!Array.isArray(e.needs)) e.needs=deriveNeeds(e);
  });
  return list;
}
const userTier = ()=> (DB&&DB.profile&&DB.profile.tier!=null) ? DB.profile.tier : tierFromGear();

/* Pick the best exercise the user can ACTUALLY perform. If the prescribed one
   needs kit they do not own, swap to the same movement pattern using kit they
   do. If they own more, offer the stronger option. Nothing is assumed. */
/* Which exercises are already placed in the session being built. The
   resolver consults this so that three different movements the user cannot do
   do not all collapse onto the same substitute - which is how one session
   ended up prescribing the same movement three times.

   It is a PREFERENCE. resolveExercise computes the unrestricted answer too,
   so an exercise with no distinct alternative still resolves to something
   rather than disappearing. */
let RESOLVE_TAKEN=null;
const notTaken = x => !RESOLVE_TAKEN || !RESOLVE_TAKEN.has(x.id);

function resolveExercise(exId, taken){
  /* first pass: avoid anything already in the session */
  if(taken && taken.size){
    RESOLVE_TAKEN=taken;
    let first=null;
    try{ first=resolveOne(exId); }finally{ RESOLVE_TAKEN=null; }
    if(first && !taken.has(first.id)) return first;
  }
  /* second pass, or no session context: the answer as it always was */
  return resolveOne(exId);
}
function resolveOne(exId){
  const e=exOf(exId); if(!e) return null;
  /* An exercise the user said hurt is skipped for the same reason a limitation
     is: there is no point prescribing the best variation of something that
     hurt them last week. Same pattern first, so the session keeps its shape. */
  if(isAvoided(e.id)){
    const sub=DB.exercises
      .filter(x=>x.id!==e.id && x.pat===e.pat && canDo(x) && !isAvoided(x.id) && notTaken(x))
      .sort((a,b)=>(b.tier||0)-(a.tier||0))[0];
    if(sub) return sub;
    const near=DB.exercises
      .filter(x=>canDo(x) && !isAvoided(x.id) && notTaken(x) &&
                 (PAT_NEIGHBOURS[e.pat]||[]).indexOf(x.pat)>=0)[0];
    if(near) return near;
  }
  /* An active limitation outranks equipment: there is no point picking the
     best squat variation you own if your knee is the thing stopping you.
     Route to a neighbouring pattern that the limitation does not touch. */
  const lim=limitPatterns();
  const blocked=p=>lim.avoid.indexOf(p)>=0;
  if(blocked(e.pat)){
    const swap=DB.exercises.filter(x=>canDo(x) && !blocked(x.pat) && notTaken(x) &&
      (PAT_NEIGHBOURS[e.pat]||[]).indexOf(x.pat)>=0)
      .sort((a,b)=>(PAT_NEIGHBOURS[e.pat].indexOf(a.pat)-PAT_NEIGHBOURS[e.pat].indexOf(b.pat))
                   || ((a.tier||0)-(b.tier||0)))[0];
    if(swap) return swap;
    /* nothing neighbouring is safe either — fall through to mobility rather
       than prescribing the thing that hurts */
    const safe=DB.exercises.filter(x=>canDo(x) && x.cat==='mobility' && !blocked(x.pat) && notTaken(x))[0];
    if(safe) return safe;
  }
  if(canDo(e)){
    const up=(DB.profile.preferBest!==false) ? bestForPattern(e.pat, e) : null;
    return (up && !blocked(up.pat)) ? up : e;
  }
  /* same movement pattern first, then same category, then anything that
     trains the same broad quality. There is always something you can do. */
  const alt=DB.exercises
    .filter(x=>x.pat===e.pat && x.id!==e.id && canDo(x) && !blocked(x.pat) && notTaken(x))
    .sort((a,b)=>(b.tier||0)-(a.tier||0))[0];
  return alt||fallbackFor(e)||e;
}
/* graceful degradation when a whole pattern is unavailable — e.g. no space to
   run means sprint work becomes the nearest doable explosive/leg option */
const PAT_NEIGHBOURS={
  sprint:['jump','bound','lunge','slsquat'], cod:['bound','jump','lunge','slsquat'],
  jump:['bound','slsquat','squat','lunge'], bound:['jump','slsquat','lunge'],
  land:['jump','slsquat','squat'],
  pullv:['pullh','reardelt'], pullh:['pullv','reardelt'],
  pushv:['pushh','triceps'], pushh:['pushv','triceps'],
  hinge:['hipext','hamcurl','slsquat'], hamcurl:['hinge','hipext'],
  hipext:['hinge','squat'], squat:['lunge','slsquat'], lunge:['squat','slsquat'],
  slsquat:['lunge','squat'], latraise:['pushv'], biceps:['pullh'], triceps:['pushh'],
  antirot:['antiext','antilat'], rotate:['antirot','antiext'],
  antiext:['antilat','antirot'], antilat:['antiext','antirot'],
  adduct:['lunge','antilat'], calf:['jump','slsquat'], tib:['calf'],
  cardio:['cardio'], mob:['mob']
};
function fallbackFor(e){
  const near=PAT_NEIGHBOURS[e.pat]||[];
  for(const p of near){
    const hit=DB.exercises.filter(x=>x.pat===p&&canDo(x)).sort((a,b)=>(b.tier||0)-(a.tier||0))[0];
    if(hit) return hit;
  }
  return DB.exercises.find(x=>x.cat===e.cat&&canDo(x))
      || DB.exercises.find(x=>canDo(x)&&(!x.needs||!x.needs.length))
      || null;
}
/* the strongest doable exercise for this pattern, when it beats the default */
function bestForPattern(pat, current){
  /* an exercise the user said hurt is off the menu until its date passes */
  if(!pat||pat==='mob'||pat==='cardio') return null;
  const cands=DB.exercises.filter(x=>x.pat===pat && canDo(x) && !isAvoided(x.id)
                                     && notTaken(x)
                                     && (x.tier||0)>(current.tier||0));
  if(!cands.length) return null;
  return cands.sort((a,b)=>(b.tier||0)-(a.tier||0))[0];
}
/* last resort: any exercise needing nothing at all, same category */
function bodyweightFallback(e){
  return DB.exercises.find(x=>x.cat===e.cat && (!x.needs||!x.needs.length)
                              && x.id!==e.id && notTaken(x))
      || DB.exercises.find(x=>x.cat===e.cat && (!x.needs||!x.needs.length) && x.id!==e.id)
      || null;
}

/* a workout's warm-up: sport-specific when the workout is sport prep */
function warmupFor(w){
  if(!w) return WARMUPS.easy;
  /* 'sport' (and the legacy 'tennis' key from older saved workouts) means
     "build one for whatever this user actually plays" */
  if(w.warm==='sport'||w.warm==='tennis') return sportWarmup();
  return WARMUPS[w.warm]||WARMUPS.easy;
}

/* =========================================================================
   FEEDBACK AND AVOIDANCE
   Two one-tap inputs that make the app learn from outcomes rather than only
   from what you type in the morning.
   ====================================================================== */

/* ---- C · "this hurt" ------------------------------------------------- */
const AVOID_DAYS=21;
function avoidList(date){
  const d=date||todayISO();
  return ((DB.profile&&DB.profile.avoid)||[]).filter(a=>a&&a.until>=d);
}
/* Can this exercise carry a number of kilograms? Derived from what it needs,
   so a new exercise is classified without anyone maintaining a list. A band
   has no kg value and bodyweight has no kg value; a dumbbell, kettlebell,
   barbell, cable stack or medicine ball does. */
/* The first sentence of how to do it. A name is not an instruction, and
   somebody who has never done a tempo goblet squat should not have to open a
   sheet to find out what one is. The full text, the progression rule and the
   alternatives stay one tap away under More: the point is to answer "what am
   I doing" without turning the set screen back into a reference manual. */
function briefHow(ex){
  if(!ex) return '';
  const src=String(ex.how||'').trim();
  if(!src) return String(ex.cue||'').trim();
  const m=src.match(/^[^.!?]+[.!?]/);
  let s=(m? m[0] : src).trim();
  if(s.length>140) s=s.slice(0,137).replace(/\s+\S*$/,'')+'…';
  return s;
}

const LOADABLE_NEEDS={db:1, kb:1, bb:1, cable:1, ball:1};
function exLoadable(ex){
  if(!ex) return false;
  return (deriveNeeds(ex)||[]).some(n=>LOADABLE_NEEDS[n]);
}

const isAvoided = (exId,date)=> avoidList(date).some(a=>a.exId===exId);
function avoidExercise(exId, why){
  DB.profile.avoid=(DB.profile.avoid||[]).filter(a=>a.exId!==exId);
  DB.profile.avoid.push({exId:exId, from:todayISO(),
                         until:addDays(todayISO(),AVOID_DAYS), why:why||''});
  save(true);
}
function unavoid(exId){
  DB.profile.avoid=((DB.profile.avoid)||[]).filter(a=>a.exId!==exId);
  save(true);
}

/* ---- B · session feedback ------------------------------------------- */
const FEEDBACK=[
  {id:'easy',  name:'Too easy',    v:+1},
  {id:'right', name:'About right', v:0},
  {id:'hard',  name:'Too hard',    v:-1}
];
/* What the last few rated sessions say, if they say anything. Same gate shape
   as the cycle signal: enough of them, and a clear enough lean, or nothing. */
function feedbackBias(){
  const rated=(DB.sessions||[]).filter(s=>s.done&&s.feedback)
    .sort((a,b)=>a.date<b.date?1:-1).slice(0,5);
  if(rated.length<3) return {n:rated.length, bias:0, line:null};
  const vals=rated.map(s=>(FEEDBACK.find(f=>f.id===s.feedback)||{v:0}).v);
  const m=mean(vals);
  /* a clear lean is two thirds of the recent sessions agreeing */
  if(Math.abs(m)<0.6) return {n:rated.length, bias:0, line:null};
  const bias=m>0?1:-1;
  return {n:rated.length, bias:bias,
    line: bias>0
      ? `Your last ${rated.length} rated sessions leaned <b>too easy</b>, so full versions are being favoured.`
      : `Your last ${rated.length} rated sessions leaned <b>too hard</b>, so volume is being trimmed.`};
}

/* ---- G · why this exercise ----------------------------------------- */
function exerciseWhy(en){
  const e=exOf(en.exerciseId);
  const bits=[];
  if(e&&e.pat){
    const p=PATTERNS&&PATTERNS[e.pat];
    bits.push('Covers <b>'+esc((p&&p.name)||e.pat)+'</b> in today’s session.');
  }
  if(en.swapNote) bits.push(esc(en.swapNote));
  const prev=lastPerformance(en.exerciseId, null, W?W.id:null);
  if(prev){
    const ago=daysBetween(prev.date, (W&&W.date)||todayISO());
    bits.push('You last did it '+(ago<=0?'today':ago===1?'yesterday':ago+' days ago')+'.');
  } else bits.push('You have not done this one before.');
  if(e&&e.equip) bits.push('Needs: '+esc(gearNames(e.equip)||e.equip)+'.');
  return bits;
}

/* ---- F · a session as plain text ------------------------------------ */
function sessionText(s){
  const L=[];
  L.push('Baseline — '+(s.workoutName||'Session'));
  L.push(fmtDate(s.date)+(s.durationMin?'  ·  '+s.durationMin+' min':''));
  if(s.readinessScore!=null) L.push('Readiness '+s.readinessScore+' ('+(s.band||'')+')');
  if(s.variant) L.push('Version: '+(VARIANT_NAME[s.variant]||s.variant));
  L.push('');
  (s.entries||[]).forEach(en=>{
    const done=(en.sets||[]).filter(x=>x.done);
    if(!done.length && !en.skipped) return;
    L.push(en.name + (en.skipped?'  — skipped':''));
    done.forEach((x,i)=>{
      L.push('  set '+(i+1)+': '+(x.reps||'?')+' reps'
        +(x.weight?' × '+x.weight+' kg':'')+(x.rpe?'  RPE '+x.rpe:''));
    });
    if(en.note) L.push('  note: '+en.note);
  });
  L.push('');
  if(s.sessionRpe!=null) L.push('Session RPE: '+s.sessionRpe);
  if(s.feedback) L.push('Felt: '+((FEEDBACK.find(f=>f.id===s.feedback)||{}).name||s.feedback));
  if(s.notes) L.push('Notes: '+s.notes);
  return L.join('\n');
}
function copySession(s){
  const txt=sessionText(s);
  const done=()=>toast('Session copied','ok');
  try{
    if(navigator.clipboard&&navigator.clipboard.writeText){
      navigator.clipboard.writeText(txt).then(done,()=>fallbackCopy(txt,done));
      return;
    }
  }catch(e){}
  fallbackCopy(txt,done);
}
function fallbackCopy(txt,done){
  /* a textarea and execCommand still works where the clipboard API is
     blocked, which it is on a file:// origin */
  try{
    const ta=document.createElement('textarea');
    ta.value=txt; ta.setAttribute('readonly','');
    ta.style.position='fixed'; ta.style.top='-1000px';
    document.body.appendChild(ta); ta.select();
    document.execCommand('copy'); document.body.removeChild(ta);
    done();
  }catch(e){
    openSheet('Session as text',
      `<textarea class="inp" style="min-height:280px;font-size:12.5px">${esc(txt)}</textarea>`,
      `<button class="btn primary big block" onclick="closeSheet()">Done</button>`);
  }
}

/* =========================================================================
   UNITS
   Height and weight are STORED in metric, always, and converted only for
   display and entry. Flipping the toggle never rewrites a stored number, so
   switching back and forth loses nothing and the engine - which reads
   heightCm and weightKg - never has to care which unit the user prefers.
   ====================================================================== */
const KG_PER_LB=0.45359237, CM_PER_IN=2.54;
const isImperial = ()=> ((DB&&DB.profile&&DB.profile.units)||'metric')==='imperial';

const kgToLb = kg => kg==null?null : Math.round(kg/KG_PER_LB*10)/10;
const lbToKg = lb => lb==null?null : Math.round(lb*KG_PER_LB*10)/10;
function cmToFtIn(cm){
  if(cm==null) return null;
  const totalIn=Math.round(cm/CM_PER_IN);
  return {ft:Math.floor(totalIn/12), inch:totalIn%12};
}
function ftInToCm(ft,inch){
  if((ft==null||ft==='') && (inch==null||inch==='')) return null;
  return Math.round(((+ft||0)*12+(+inch||0))*CM_PER_IN);
}
/* what to show, in whichever unit is chosen */
function showWeight(kg){
  if(kg==null) return '—';
  return isImperial() ? kgToLb(kg)+' lb' : kg+' kg';
}
function showHeight(cm){
  if(cm==null) return '—';
  if(!isImperial()) return cm+' cm';
  const f=cmToFtIn(cm);
  return f.ft+'′ '+f.inch+'″';
}
const unitName = u => (u||'metric')==='imperial' ? 'Imperial (lb, ft/in)' : 'Metric (kg, cm)';
